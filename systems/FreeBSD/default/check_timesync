# check_timesync: is the clock kept synchronised, by one daemon.
#
# 11/10/2026 - Initial version, beside the Linux check_timesync. The
#             daemons are found in ps (FreeBSD has no /proc of
#             Linux's): ntpd, OpenNTPD (also ntpd, told apart by its
#             process titles or its ntpd.conf) and chronyd from ports.
#             Whether the clock is synchronised comes from chronyc
#             tracking for chronyd, from ntpctl -s status for OpenNTPD,
#             and from ntpq's tally for ntpd (a selected peer); there
#             is no timedatectl to ask instead. ntpdate only sets the
#             clock once, at boot, so a host with nothing else still
#             reports no daemon, saying so. A jail runs on its host's
#             clock and is left alone. Tigris_Ps_Cmd replaces ps, and
#             Tigris_Sysctl_Cmd, Tigris_Rcconf_File, Tigris_Ntpq_Cmd,
#             Tigris_Ntpctl_Cmd, Tigris_Chronyc_Cmd and
#             Tigris_Chronyc_Sources_Cmd the jail query, rc.conf and
#             the three query commands, for the tests.
#
# References:
#   man 1 chronyc, man 8 ntpd, man 8 ntpctl, man 5 rc.conf
#
# Tigris: live system
#   Under --root it is skipped: it reads the running time daemon and the kernel clock.
#
#-----------------------------------------------------------------------------
#
TigrisInstallDir='.'

#
# Set default base directory.
# Order or preference:
#      -B option
#      TIGERHOMEDIR environment variable
#      TigrisInstallDir installed location
#
basedir=${TIGERHOMEDIR:=$TigrisInstallDir}

for parm
do
   case $parm in
   -B) basedir=$2; break;;
   esac
done

#
# Verify that a config file exists there, and if it does
# source it.
#
[ ! -r $basedir/config ] && {
  echo "--ERROR-- [init002e] No 'config' file in \`$basedir'."
  exit 1
}

. $basedir/config

. $BASEDIR/initdefs

#
# If run in test mode (-t) this will verify that all required
# elements are set.
#
[ "$Tigris_TESTMODE" = 'Y' ] && {
  haveallcmds AWK GREP SED SORT || exit 1
  haveallfiles BASEDIR WORKDIR || exit 1

  echo "--CONFIG-- [init003c] $0: Configuration ok..."
  exit 0
}

#------------------------------------------------------------------------

haveallcmds AWK GREP SED SORT || exit 1

# Under --root there is nothing to read: the daemons are live state
[ -n "$TIGRIS_ROOT" ] && exit 0

# A jail keeps its host's time
[ "`${Tigris_Sysctl_Cmd:-sysctl} -n security.jail.jailed 2>/dev/null`" = 1 ] && exit 0

echo
echo "# Checking time synchronisation..."

findtool()
{
  for d in /usr/bin /bin /usr/sbin /sbin /usr/local/bin /usr/local/sbin
  do
    [ -x "$d/$1" ] && { echo "$d/$1"; return 0; }
  done
  return 1
}

# ntpdate_at_boot: rc.conf arranges ntpdate's one-shot at boot
ntpdate_at_boot()
{
  __rc=${Tigris_Rcconf_File:-`rootfile /etc/rc.conf`}
  for __f in "$__rc" "${__rc%/*}/rc.conf.d/ntpdate"
  do
    [ -f "$__f" ] || continue
    $GREP -Ei "^[[:space:]]*ntpdate_enable[[:space:]]*=[[:space:]]*[\"']?(yes|true|on|1)[\"']?" "$__f" >/dev/null 2>&1 && return 0
  done
  return 1
}

pscmd=${Tigris_Ps_Cmd:-}
[ -z "$pscmd" ] && { p=`findtool ps` && pscmd="$p -ax -o comm= -o command=" || pscmd=; }
[ -z "$pscmd" ] && exit 0
psout=`$pscmd 2>/dev/null`
[ -z "$psout" ] && exit 0

# OpenNTPD's daemon is called ntpd too, as the reference ntpd and
# NTPsec's are. It is told apart by its processes' titles, which it
# sets to "ntpd: ntp engine" and "ntpd: dns engine", or else by its
# configuration: an ntpd.conf (/etc or the ports' /usr/local/etc)
# and no ntp.conf.
ntpd=ntpd
if printf '%s\n' "$psout" | $AWK '$1 == "ntpd" { found = 1; exit } END { exit !found }'; then
  titles=`printf '%s\n' "$psout" | $AWK '$1 == "ntpd" { $1 = ""; print }'`
  case "$titles" in
    *"ntp engine"*|*"dns engine"*) ntpd=openntpd ;;
    *) { [ -f "`rootfile /etc/ntpd.conf`" ] || [ -f "`rootfile /usr/local/etc/ntpd.conf`" ]; } &&
         [ ! -f "`rootfile /etc/ntp.conf`" ] && [ ! -f "`rootfile /usr/local/etc/ntp.conf`" ] && ntpd=openntpd ;;
  esac
fi

# The time daemons running, by the name people know them by
daemons=`printf '%s\n' "$psout" | TIGRIS_NTPD=$ntpd $AWK '
  { comm = $1; $1 = ""; args = $0
    if (comm == "chronyd") d["chronyd"] = 1
    else if (comm == "ntpd") d[ENVIRON["TIGRIS_NTPD"]] = 1 }
  END { for (n in d) print n }' | $SORT | $AWK '{ printf "%s%s", (NR > 1 ? " " : ""), $0 }'`

case "$daemons" in
  '')
    if ntpdate_at_boot; then
      message WARN time001w "ntpdate only sets the clock once, at boot: enable a daemon that keeps it (ntpd_enable=\"YES\" in rc.conf)." "No time synchronisation daemon is running (ntpd, OpenNTPD or chronyd were looked for): ntpdate sets the clock at boot and the clock then drifts, and logs, certificates and Kerberos tickets go wrong with it."
    else
      message WARN time001w "Install and enable one in rc.conf (ntpd_enable=\"YES\", openntpd_enable=\"YES\" or chronyd_enable=\"YES\") and start it." "No time synchronisation daemon is running (ntpd, OpenNTPD or chronyd were looked for): the clock drifts, and logs, certificates and Kerberos tickets go wrong with it."
    fi
    exit 0
    ;;
  *' '*)
    message WARN time004w "Running: $daemons. Keep one: turn the others off in rc.conf (ntpd_enable=\"NO\") and stop them." "More than one time synchronisation daemon is running, and they correct the clock against each other."
    ;;
esac

# judge_sources DAEMON VERDICT: time005w and time006w from the verdict
# lines the two awk programs below print: 'count TOTAL GOOD', one
# 'falseticker NAME' per source the daemon rejects, and 'refclock'
# when a reference clock (not a network source) is in the list. No
# count line means the output did not parse, and nothing is judged.
judge_sources()
{
  __d=$1 __v=$2
  __counts=`printf '%s\n' "$__v" | $SED -n 's/^count \([0-9][0-9]*\) \([0-9][0-9]*\)$/\1 \2/p'`
  [ -z "$__counts" ] && return 0
  __total=`printf '%s\n' "$__counts" | $AWK '{ print $1 }'`
  __good=`printf '%s\n' "$__counts" | $AWK '{ print $2 }'`
  case $__d in
    chronyd) __where="'pool' or 'server' lines in chrony.conf" ;;
    openntpd) __where="'servers' or 'server' lines in ntpd.conf" ;;
    *) __where="'server' lines in ntp.conf" ;;
  esac
  if [ "$__total" = 0 ]; then
    case "$__v" in
      *refclock*) : ;; # a reference clock disciplines it: nothing to outvote
      *) message WARN time005w "Give it some: $__where." "$__d has no time sources configured: nothing disciplines the clock." ;;
    esac
  elif [ "$__good" -lt 3 ]; then
    __noun=sources; [ "$__total" = 1 ] && __noun=source
    message WARN time005w "Give it at least three that answer (four is the usual): $__where." "$__d has only $__good of its $__total time $__noun answering: one bad source cannot be outvoted, so a failing or spoofed server sets the clock."
  fi
  printf '%s\n' "$__v" | $SED -n 's/^falseticker //p' | while IFS= read -r __s
  do
    [ -n "$__s" ] && message WARN time006w "Find whether $__s is the one that is wrong (a failing clock, or time fed to lie), then drop or replace that source." "$__d calls $__s a falseticker: it disagrees with the other sources, so it is not used."
  done
}

# Protocol depth, for the daemons that choose between sources. chronyd
# and ntpd compare their sources and can be outvoted or lied to;
# OpenNTPD says how many of its peers are valid (ntpctl -s status), and
# no more. chronyc and ntpq ask for numeric addresses, so no reverse
# lookup leaves the box; ntpctl -s status names no peer.
# A stopped or wedged daemon holds chronyc 21 seconds a call and ntpq
# 10; all three talk to a local socket, so five seconds is plenty.
# Without a timeout command they run as they are.
tmo=
[ -n "$TIMEOUT" ] && tmo="$TIMEOUT -s KILL 5"
stratum_n= ntp_synced=
case " $daemons " in
  *" chronyd "*)
    srccmd=${Tigris_Chronyc_Sources_Cmd:-}
    [ -z "$srccmd" ] && c=`findtool chronyc` && srccmd="$c -n sources"
    if [ -n "$srccmd" ]; then
      srcout=`$tmo $srccmd 2>/dev/null | $AWK '
        /^=+$/ { seen = 1; next }
        seen && NF >= 6 {
          if (substr($1, 1, 1) == "#") { clock = 1; next }
          if ($2 ~ /[.:]/) { total++
            if (substr($1, 2, 1) == "x") print "falseticker " $2
            else if ($5 != "0") good++ }
        }
        END { if (seen) { printf "count %d %d\n", total, good; if (clock) print "refclock" } }'`
      judge_sources chronyd "$srcout"
    fi
    ;;
esac
case " $daemons " in
  *" ntpd "*)
    ntpqcmd=${Tigris_Ntpq_Cmd:-}
    [ -z "$ntpqcmd" ] && c=`findtool ntpq` && ntpqcmd="$c -pn"
    if [ -n "$ntpqcmd" ]; then
      # the columns: tally and remote, refid, st, t, when, poll, reach;
      # a blank tally leaves the remote first all the same. t is p for
      # a pool (a name servers are drawn from, not one), l for a local
      # reference clock, anything else a network server. A selected
      # peer (*, o) means the clock is synchronised: there is no
      # timedatectl to ask instead.
      ntpqout=`$tmo $ntpqcmd 2>/dev/null | $AWK '
        /^=+$/ { seen = 1; next }
        seen && NF >= 8 && $4 != "p" {
          tally = substr($1, 1, 1); remote = $1
          if (tally ~ /[.x+#*o-]/) remote = substr($1, 2)
          if ($4 == "l") { clock = 1
            if ((tally == "*") || (tally == "o")) { synced = 1
              if ($3 ~ /^[0-9][0-9]*$/) stratum = $3 + 1 } }
          else {
            total++
            if (tally == "x") print "falseticker " remote
            else if ($7 != "0") { good++
              if ((tally == "*") || (tally == "o")) { synced = 1
                if ($3 ~ /^[0-9][0-9]*$/) stratum = $3 + 1 } } }
        }
        END { if (seen) { printf "count %d %d\n", total, good
          if (clock) print "refclock"
          print "synced " (synced ? "yes" : "no")
          if (stratum != "") printf "stratum %d\n", stratum } }'`
      judge_sources ntpd "$ntpqout"
      stratum_n=`printf '%s\n' "$ntpqout" | $SED -n 's/^stratum \([0-9][0-9]*\)$/\1/p'`
      ntp_synced=`printf '%s\n' "$ntpqout" | $SED -n 's/^synced //p'`
    fi
    ;;
esac
# ntpctl -s status (ntpctl(8)) prints one line: "V/T peers valid, "
# when peers are configured, "V/T sensors valid, " when sensors are, a
# constraint's offset, then "clock synced, stratum N" or "clock
# unsynced". A valid sensor is a reference clock.
ctlout=
case " $daemons " in
  *" openntpd "*)
    ctlcmd=${Tigris_Ntpctl_Cmd:-}
    [ -z "$ctlcmd" ] && c=`findtool ntpctl` && ctlcmd="$c -s status"
    if [ -n "$ctlcmd" ]; then
      ctlout=`$tmo $ctlcmd 2>/dev/null | $AWK '
        {
          for (i = 1; i < NF; i++) {
            if ($i !~ /^[0-9][0-9]*\/[0-9][0-9]*$/) continue
            split($i, n, "/")
            if ($(i + 1) == "peers") { good = n[1]; total = n[2] }
            else if ($(i + 1) == "sensors" && n[1] > 0) clock = 1
          }
        }
        /clock synced/ { st = "yes"
          for (i = 1; i < NF; i++) if ($i == "stratum" && $(i + 1) ~ /^[0-9][0-9]*$/) stratum = $(i + 1) }
        /clock unsynced/ { st = "no" }
        END { if (st != "") { printf "count %d %d\n", total, good
          if (clock) print "refclock"
          print "synced " st
          if (stratum != "") printf "stratum %d\n", stratum } }'`
      judge_sources openntpd "$ctlout"
    fi
    ;;
esac

# Synchronised? chronyc for chronyd, ntpctl for OpenNTPD when it
# answers, ntpq's tally for ntpd
synced= source= stratum= by=
case " $daemons " in
  *" chronyd "*)
    cmd=${Tigris_Chronyc_Cmd:-}
    [ -z "$cmd" ] && c=`findtool chronyc` && cmd="$c -n tracking"
    if [ -n "$cmd" ]; then
      out=`$tmo $cmd 2>/dev/null`
      case "$out" in
        *"Leap status"*"Not synchronised"*) synced=no ;;
        *"Leap status"*) synced=yes
          source=`echo "$out" | $SED -n 's/^Reference ID *: [0-9A-Fa-f]* (\(.*\))$/\1/p'`
          stratum=`echo "$out" | $SED -n 's/^Stratum[^0-9]*\([0-9][0-9]*\).*/\1/p'` ;;
      esac
    fi
    by=chronyd
    ;;
  *" openntpd "*)
    synced=`printf '%s\n' "$ctlout" | $SED -n 's/^synced //p'`
    stratum_n=`printf '%s\n' "$ctlout" | $SED -n 's/^stratum \([0-9][0-9]*\)$/\1/p'`
    by=openntpd
    ;;
  *" ntpd "*)
    synced=$ntp_synced
    by=ntpd
    ;;
esac
[ "$by" = chronyd ] || stratum=$stratum_n

case "$by" in
  chronyd) look="See 'chronyc sources'" ;;
  openntpd) look="See 'ntpctl -s peers'" ;;
  *) look="See 'ntpq -p'" ;;
esac
case "$synced" in
  yes)
    detail=
    [ -n "$source" ] && detail="from $source"
    [ -n "$stratum" ] && detail="${detail:+$detail, }stratum $stratum"
    [ -n "$detail" ] && detail=" ($detail)"
    message INFO time003i "" "The clock is synchronised by $by$detail."
    ;;
  no)  message WARN time002w "$look: the servers may be unreachable (a firewall blocking UDP port 123 outbound), or none is configured." "$by is running, but the clock is not synchronised." ;;
esac

exit 0
