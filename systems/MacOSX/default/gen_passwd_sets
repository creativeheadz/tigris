#
# MacOSX/default/gen_passwd_sets OUTFILE - 10/23/2026
#     The accounts, as one set in passwd(5)'s seven fields, for
#     check_accounts and check_path: OUTFILE gets the set's file name,
#     and the set's .src file names its source. A Mac's accounts are
#     DirectoryService's, not /etc/passwd's (which holds a few system
#     ones, for single-user mode): read live with dscl, offline from
#     the root's dslocal user plists, as MacOSX check_passwd reads
#     them. The password field is * for an account whose
#     authentication authority says DisabledUser, and ShadowHash
#     otherwise: the hash itself is not crypt's, and not judged. The
#     comment field is left empty. Tigris_Dscl_Cmd replaces dscl, for
#     the tests.
#
#-----------------------------------------------------------------------------
#

[ -z "$AWK" ] && AWK=`command -v awk`
[ -z "$WORKDIR" ] && WORKDIR=/tmp

outfile=
for parm
do
  case "$parm" in
    -*) ;;
    *) outfile=$parm ;;
  esac
done
[ -n "$outfile" ] || { echo "ERROR: Missing argument (outfile)"; exit 1; }
: > "$outfile"

set=$WORKDIR/ds_passwd.$$
: > "$set"
if [ -n "$TIGRIS_ROOT" ]; then
  dir=`printf '%s\n' /var/db/dslocal/nodes/Default/users | AWK=$AWK sh "$BASEDIR/util/rootpath" "$TIGRIS_ROOT" "$TIGRIS_LINKS"`
  [ -n "$dir" ] && [ -d "$dir" ] && for f in "$dir"/*.plist
  do
    [ -f "$f" ] || continue
    $AWK '
    /<key>name<\/key>/ { key = "name"; next }
    /<key>uid<\/key>/ { key = "uid"; next }
    /<key>gid<\/key>/ { key = "gid"; next }
    /<key>shell<\/key>/ { key = "shell"; next }
    /<key>home<\/key>/ { key = "home"; next }
    /<key>authentication_authority<\/key>/ { key = "auth"; next }
    /<key>/ { key = ""; next }
    key != "" && /<string>/ {
      s = $0; sub(/^.*<string>/, "", s); sub(/<\/string>.*$/, "", s); gsub(/:/, "", s)
      if (key == "auth") { if (s ~ /DisabledUser/) dis = 1 }
      else if (!(key in v)) v[key] = s
      next
    }
    END {
      if ("name" in v) printf "%s:%s:%s:%s::%s:%s\n", v["name"], (dis ? "*" : "ShadowHash"), v["uid"], v["gid"], v["home"], v["shell"]
    }' < "$f" 2>/dev/null
  done >> "$set"
else
  dscl=${Tigris_Dscl_Cmd:-dscl}
  $dscl . -list /Users 2>/dev/null | $AWK '{ print $1 }' | while read -r u
  do
    case "$u" in ''|*:*|*/*) continue ;; esac
    $dscl . -read /Users/"$u" UniqueID PrimaryGroupID NFSHomeDirectory UserShell AuthenticationAuthority 2>/dev/null |
    TIGRIS_U=$u $AWK '
    /^UniqueID:/ { uid = $2 }
    /^PrimaryGroupID:/ { gid = $2 }
    /^NFSHomeDirectory:/ { home = $2 }
    /^UserShell:/ { shell = $2 }
    /DisabledUser/ { dis = 1 }
    END {
      s = uid gid home shell; if (index(s, ":")) exit
      printf "%s:%s:%s:%s::%s:%s\n", ENVIRON["TIGRIS_U"], (dis ? "*" : "ShadowHash"), uid, gid, home, shell
    }'
  done >> "$set"
fi
echo "DirectoryService" > "$set.src"
echo "$set" >> "$outfile"
exit 0
