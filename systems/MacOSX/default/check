# MacOSX/default/check - 10/09/2026
#     The macOS system checks, run by scripts/check_system the way
#     the Linux aggregator is. Each entry gates on its Tigris_Check_*
#     toggle and runs the check from this directory: a macOS check
#     where the platform differs, a symlink to the Linux parser
#     where the grammar is the platform's own (sudoers). Grows as
#     the portable groups gain their macOS halves.
#
#-----------------------------------------------------------------------------
#
TigrisInstallDir='.'

#
# Set default base directory.
# Order or preference:
#      -B option
#      TIGERHOMEDIR environment variable
#      TigrisInstallDir installed location
#
basedir=${TIGERHOMEDIR:=$TigrisInstallDir}

for parm
do
   case $parm in
   -B) basedir=$2; break;;
   esac
done

#
# Verify that a config file exists there, and if it does
# source it.
#
[ ! -r $basedir/config ] && {
  echo "--ERROR-- [init002e] No 'config' file in \`$basedir'."
  exit 1
}

. $basedir/config

. $BASEDIR/initdefs
#
# If run in test mode (-t) this will verify that all required
# elements are set.
#
[ "$Tigris_TESTMODE" = 'Y' ] && {
  haveallcmds CAT GREP || exit 1
  haveallfiles BASEDIR WORKDIR || exit 1

  echo "--CONFIG-- [init003c] $0: Configuration ok..."
  exit 0
}

#------------------------------------------------------------------------

haveallcmds CAT GREP || exit 1
haveallfiles BASEDIR WORKDIR || exit 1

SYSTEMDIR=$BASEDIR/systems/MacOSX/default
#
# Note: cannot echo TIMECMD since we lose the handle to the tmplog

[ "$Tigris_Check_FIREWALL" != 'N' ] && {
  skip_check $SYSTEMDIR/check_firewall || $SYSTEMDIR/check_firewall
}

[ "$Tigris_Check_SUDO" != 'N' ] && {
  skip_check $SYSTEMDIR/check_sudo || $SYSTEMDIR/check_sudo
}

# check_passwd, check_group, check_logfiles and check_crontabs ride
# tiger's own dispatch blocks: run_script finds the MacOSX checks
# first, so they are not listed here (listing them would run them
# twice).

[ "$Tigris_Check_AUDIT" != 'N' ] && {
  skip_check $SYSTEMDIR/check_audit || $SYSTEMDIR/check_audit
}
