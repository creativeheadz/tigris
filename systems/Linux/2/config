#UUID=`/usr/bin/id | /bin/sed -e 's/uid=\([0-9][0-9]*\).*$/\1/'`
UUID=`id -u`
USERNAME=`whoami`
# This will work in most shells
[ "$UUID" = "" ] && UUID=$UID
[ "$USERNAME" = "" ] && USERNAME=$USER
# Last resort 
[ "$UUID" = "" -a ! "$USERNAME" = "" ] && {
	# Try this and see it works
	UUID=`grep  ^$USERNAME: /etc/passwd  |awk -F : '{print $3}'`
}
export UUID

[ "$USERNAME" != "root" ] && {
  echo " " 1>&2
  echo "This script should be run from a super-user account." 1>&2
  echo " " 1>&2
# We don't need to bail out here, but most scripts will not run
# properly, however
#  exit 1
}

findcmd()
{
  CMD=$1

  SRCH=/bin:/usr/bin:/usr/sbin:/sbin:/usr/local/bin:/usr/local/sbin

  SAVEIFS=$IFS
  IFS=:
  set $SRCH
  IFS=$SAVEIFS
  for dir
  do
    test $TESTEXEC $dir/$CMD && {
      echo $dir/$CMD
      return
    }
  done
}

# First of all, determine our distribution (might affect tests
# below)
# Auditing an offline root (--root), it is that system's distribution.
# Its release files are found inside the root: one of them a link out of
# it would have this host's distribution taken for the root's. The root's
# links are listed for that here, once, for every check (tiger keeps the
# table, TIGRIS_LINKS).
__relfiles='/etc/redhat-release
/etc/debian_version
/etc/SuSE-release
/etc/immunix-release
/etc/mandrake-release
/etc/turbolinux-release
/etc/os-release
/usr/lib/os-release'
if [ -n "$TIGRIS_ROOT" ]; then
  TIGRIS_LINKS=${TIGRIS_LINKS:-$WORKDIR/rootlinks.$$}
  export TIGRIS_LINKS
  __relfiles=`printf '%s\n' "$__relfiles" | sh "$BASEDIR/util/rootpath" "$TIGRIS_ROOT" "$TIGRIS_LINKS"`
fi
__relfile() { printf '%s\n' "$__relfiles" | sed -n "$1p"; }
LXDISTRIBUTION="unknown"
[ -f "`__relfile 1`" ] && LXDISTRIBUTION="redhat"
[ -f "`__relfile 2`" ] && LXDISTRIBUTION="debian"
[ -f "`__relfile 3`" ] && LXDISTRIBUTION="redhat"
[ -f "`__relfile 4`" ] && LXDISTRIBUTION="inmunix"
[ -f "`__relfile 5`" ] && LXDISTRIBUTION="mandrake"
[ -f "`__relfile 6`" ] && LXDISTRIBUTION="turbolinux"
# /etc/os-release names the distribution (ID) and the ones it descends from
# (ID_LIKE), which is how Ubuntu, Mint and Pop!_OS are Debian and Rocky,
# Alma and Fedora are Red Hat. It is read as text, never sourced: this runs
# as root. Tiger_Os_Release lets the tests point at a file of their own.
__osrel=${Tiger_Os_Release:-`__relfile 7`}
[ -r "$__osrel" ] || [ -n "$Tiger_Os_Release" ] || __osrel=`__relfile 8`
TESTEXEC=-x     # findcmd tests with it, and it is only set again further down
__sed=`findcmd sed`; __tr=`findcmd tr`      # SED and TR are defined further down
if [ -r "$__osrel" ] && [ -n "$__sed" ] && [ -n "$__tr" ]; then
  __osfam=`$__sed -n -e 's/^ID=//p' -e 's/^ID_LIKE=//p' "$__osrel" 2>/dev/null | $__sed -e 's/["'"'"']//g' | $__tr '\n' ' '`
  case " $__osfam " in
    *" debian "*|*" ubuntu "*)           LXDISTRIBUTION="debian" ;;
    *" rhel "*|*" fedora "*|*" centos "*) LXDISTRIBUTION="redhat" ;;
    *" suse "*|*" opensuse"*)            LXDISTRIBUTION="suse" ;;
    *" alpine "*)                        LXDISTRIBUTION="alpine" ;;
    *" arch "*|*" archlinux "*)          LXDISTRIBUTION="arch" ;;
  esac
fi
export LXDISTRIBUTION

# The package manager the integrity checks ask. The distribution says which
# one to expect; the command being there says whether it is usable. Mint is
# Debian by ID_LIKE and has dpkg; a container image with the package
# database stripped out has none, and the checks then say nothing.
# Auditing an offline root, the database is that system's and the tool the
# host's own (nothing under the root is run): both have to be there.
LXPKGMGR=none
case "$LXDISTRIBUTION" in
  debian) command -v dpkg >/dev/null 2>&1 && [ -d "$TIGRIS_ROOT/var/lib/dpkg/info" ] && LXPKGMGR=dpkg ;;
  redhat|suse) command -v rpm >/dev/null 2>&1 &&
    { [ -z "$TIGRIS_ROOT" ] || [ -d "$TIGRIS_ROOT/var/lib/rpm" ] || [ -d "$TIGRIS_ROOT/usr/lib/sysimage/rpm" ]; } && LXPKGMGR=rpm ;;
  alpine) command -v apk >/dev/null 2>&1 && { [ -z "$TIGRIS_ROOT" ] || [ -f "$TIGRIS_ROOT/lib/apk/db/installed" ]; } && LXPKGMGR=apk ;;
  arch) command -v pacman >/dev/null 2>&1 && { [ -z "$TIGRIS_ROOT" ] || [ -d "$TIGRIS_ROOT/var/lib/pacman/local" ]; } && LXPKGMGR=pacman ;;
esac
export LXPKGMGR

