#
# check_updates: security updates waiting, installed automatically or not,
#                 and a reboot that would put the installed ones to use.
#
# 10/07/2026 atrimbitas - Initial version, beside check_patches, which runs
#                 apt-get update and is off by default. This one never
#                 touches the network: it reads what the package manager
#                 already has (apt's lists, dnf's cache, zypper's
#                 repositories), so its count is as fresh as the last
#                 update of those, which the detail says for apt.
#                 Security updates are apt's from a -security suite,
#                 dnf's updateinfo of type security, zypper's patches of
#                 category security; pacman and apk carry no such data.
#                 Automatic installation is unattended-upgrades or Linux
#                 Mint's update automation, dnf-automatic with
#                 apply_updates; enabled timers are their links in
#                 /etc/systemd/system/timers.target.wants. A reboot is
#                 needed when /run/reboot-required exists, the running
#                 kernel's modules are gone, or (dnf) the newest kernel-core
#                 installed is not the one running. In a container there is
#                 no kernel to reboot.
#                 Tiger_Sysctl_Root prefixes the files; Tiger_Updates_Manager
#                 and the Tiger_*_Cmd settings below replace the commands,
#                 for the tests.
# 10/07/2026 atrimbitas - An offline root (--root): the package manager is
#                 pointed at its databases and configuration (dnf
#                 --installroot, zypper --root; apt through APT_CONFIG, so
#                 that the root's apt.conf.d is read and not this host's,
#                 with this host's dpkg and apt's own solver named on the
#                 command line, which the root's configuration cannot
#                 override, and no cache or log written into the root),
#                 its files are read through rootfile, and the reboot is
#                 not asked about: nothing is running.
#
# Tigris: offline
#
#-----------------------------------------------------------------------------
#
TigerInstallDir='.'

#
# Set default base directory.
# Order or preference:
#      -B option
#      TIGERHOMEDIR environment variable
#      TigerInstallDir installed location
#
basedir=${TIGERHOMEDIR:=$TigerInstallDir}

for parm
do
   case $parm in
   -B) basedir=$2; break;;
   esac
done

#
# Verify that a config file exists there, and if it does
# source it.
#
[ ! -r $basedir/config ] && {
  echo "--ERROR-- [init002e] No 'config' file in \`$basedir'."
  exit 1
}

. $basedir/config

. $BASEDIR/initdefs

#
# If run in test mode (-t) this will verify that all required
# elements are set.
#
[ "$Tiger_TESTMODE" = 'Y' ] && {
  haveallcmds AWK CAT GREP LS SED SORT || exit 1
  haveallfiles BASEDIR WORKDIR || exit 1

  echo "--CONFIG-- [init003c] $0: Configuration ok..."
  exit 0
}

#------------------------------------------------------------------------

haveallcmds AWK CAT GREP LS SED SORT || exit 1

root=${Tiger_Sysctl_Root:-}

findtool()
{
  for d in /usr/bin /bin /usr/sbin /sbin
  do
    [ -x "$d/$1" ] && { echo "$d/$1"; return 0; }
  done
  return 1
}

# Which package manager to ask
mgr=${Tiger_Updates_Manager:-}
if [ -z "$mgr" ]; then
  case "$LXPKGMGR" in
    dpkg) findtool apt-get >/dev/null && mgr=apt ;;
    rpm) if findtool dnf >/dev/null; then mgr=dnf; elif findtool zypper >/dev/null; then mgr=zypper; fi ;;
    pacman|apk) mgr=$LXPKGMGR ;;
  esac
fi
[ -n "$mgr" ] || exit 0

container=N
[ -f "$root/.dockerenv" ] || [ -f "$root/run/.containerenv" ] || [ -f "$root/run/systemd/container" ] && container=Y

echo
echo "# Checking security updates ($mgr)..."

# timer_on NAME: is NAME.timer enabled: its link in timers.target.wants,
# pointing at a unit that is there
timer_on()
{
  [ -f "`rootfile /etc/systemd/system/timers.target.wants/$1.timer`" ]
}

# list: the first ten words of stdin, and how many more
list()
{
  $AWK '{ if (NR <= 10) printf "%s%s", (NR > 1 ? ", " : ""), $0 } END { if (NR > 10) printf " and %d more", NR - 10 }'
}

#
# A reboot that would put installed updates to use
#
if [ "$container" = N ] && [ -z "$TIGRIS_ROOT" ]; then
  running=`$CAT "$root/proc/sys/kernel/osrelease" 2>/dev/null`
  why=
  if [ -f "$root/run/reboot-required" ]; then
    pkgs=`$SORT -u "$root/run/reboot-required.pkgs" 2>/dev/null | list`
    why="/run/reboot-required is there${pkgs:+, for $pkgs}"
  elif [ -n "$running" ] && [ -d "$root/lib/modules" ] && [ ! -d "$root/lib/modules/$running" ] &&
       [ -n "`$LS "$root/lib/modules" 2>/dev/null`" ]; then
    why="the running kernel, $running, has no modules in /lib/modules any more: its package was upgraded"
  elif [ "$mgr" = dnf ] && [ -n "$running" ]; then
    cmd=${Tiger_Rpm_Kernel_Cmd:-}
    [ -z "$cmd" ] && r=`findtool rpm` && cmd="$r -q --last kernel-core"
    newest=`$cmd 2>/dev/null | $AWK 'NR == 1 && $1 ~ /^kernel-core-/ { sub(/^kernel-core-/, "", $1); print $1 }'`
    [ -n "$newest" ] && [ "$newest" != "$running" ] && why="kernel $newest was installed last, and $running is running"
  fi
  [ -n "$why" ] && message WARN upd001w "Reboot when it suits: $why." "A reboot is needed to put the updates installed to use: until then the old kernel or libraries keep running."
fi

#
# Security updates waiting, from what the package manager has cached
#
pending= unknown= age= aptconf= tooldir= errf=
trap '[ -n "$errf" ] && delete $errf; [ -n "$tooldir" ] && rm -rf "$tooldir"; exit 1' 1 2 3 15

# rootlink PATH LINK: LINK, a link to the root's PATH where it is inside
# the root, when that is a file. rootlinks DIR TODIR: the same for each
# file in the root's DIR, under its own name.
rootlink()
{
  __rl=`rootfile "$1"`
  [ -n "$__rl" ] && [ -f "$__rl" ] && ln -s "$__rl" "$2"
}
rootlinks()
{
  rootls "$1" 2>/dev/null > "$tooldir/names"
  rootpaths < "$tooldir/names" > "$tooldir/here"
  while IFS= read -r __rn && IFS= read -r __rh <&3
  do
    [ -n "$__rh" ] && [ -f "$__rh" ] && ln -s "$__rh" "$2/${__rn##*/}"
  done < "$tooldir/names" 3< "$tooldir/here"
  rm -f "$tooldir/names" "$tooldir/here"
}
case "$mgr" in
  apt)
    lists=`rootfile /var/lib/apt/lists`
    cmd=${Tiger_Apt_Simulate_Cmd:-}
    [ -z "$cmd" ] && a=`findtool apt-get` && cmd="$a -s -o Debug::NoLocking=1 dist-upgrade"
    if [ -n "$TIGRIS_ROOT" ] && [ -z "$Tiger_Apt_Simulate_Cmd" ]; then
      # apt reads none of the root's configuration: an apt.conf.d can name
      # programs apt runs (a compressor for its lists, a hook), and they
      # ran on this host, as root, until October 2026. Nor this host's.
      # What it reads of the root (dpkg's status and architectures, the
      # sources, the pins, the package lists) is linked into a directory
      # of Tigris's own under fixed names, each found inside the root, so
      # that a link in the root cannot have apt read this host's files,
      # and the configuration names that directory only, never a path
      # from the root. The root's architecture (its dpkg's) rather than
      # this host's, the cache built in memory, no planner log.
      # (absolute: apt reads the paths in its configuration against Dir,
      # and WORKDIR is relative in a source tree)
      tooldir=`cd "$WORKDIR" && pwd`/updtool.$$
      mkdir -m 700 "$tooldir" &&
        mkdir "$tooldir/dpkg" "$tooldir/lists" "$tooldir/sources.list.d" "$tooldir/preferences.d" "$tooldir/apt.conf.d"
      rootlink /var/lib/dpkg/status "$tooldir/dpkg/status"
      rootlink /var/lib/dpkg/arch "$tooldir/dpkg/arch"
      rootlink /etc/apt/sources.list "$tooldir/sources.list"
      rootlink /etc/apt/preferences "$tooldir/preferences"
      rootlinks /etc/apt/sources.list.d "$tooldir/sources.list.d"
      rootlinks /etc/apt/preferences.d "$tooldir/preferences.d"
      rootlinks /var/lib/apt/lists "$tooldir/lists"
      lists=$tooldir/lists
      arch=`$AWK '/^Package: / { p = $2 } p == "dpkg" && /^Architecture: / { print $2; exit }' "$tooldir/dpkg/status" 2>/dev/null`
      case "$arch" in *[!a-z0-9-]*) arch= ;; esac
      aptconf=$tooldir/apt.conf
      cat > "$aptconf" <<APTCONF
Dir "$tooldir/";
Dir::Etc "$tooldir/";
Dir::Etc::main "$tooldir/none.conf";
Dir::Etc::parts "$tooldir/apt.conf.d/";
Dir::Etc::sourcelist "$tooldir/sources.list";
Dir::Etc::sourceparts "$tooldir/sources.list.d/";
Dir::Etc::preferences "$tooldir/preferences";
Dir::Etc::preferencesparts "$tooldir/preferences.d/";
Dir::State "$tooldir/";
Dir::State::status "$tooldir/dpkg/status";
Dir::State::lists "$tooldir/lists/";
Dir::State::extended_states "$tooldir/extended_states";
Dir::Cache "$tooldir/";
Dir::Cache::pkgcache "";
Dir::Cache::srcpkgcache "";
Dir::Log "$tooldir/";
Dir::Log::Planner "";
Dir::Log::Solver "";
Dir::Bin::dpkg "${DPKG:-/usr/bin/dpkg}";
APT::Solver "internal";
APT::Planner "internal";
Debug::NoLocking "1";
APTCONF
      APT_CONFIG=$aptconf
      export APT_CONFIG
      cmd="$a -s${arch:+ -o APT::Architecture=$arch} dist-upgrade"
    fi
    if [ -z "`$LS "$lists" 2>/dev/null | $GREP '_Packages'`" ]; then
      unknown="apt has no package lists (apt update has not run, or they were cleaned)"
    else
      pending=`$cmd 2>/dev/null | $AWK '/^Inst / && /-security|Debian-Security/ { print $2 }' | $SORT -u`
      # how old the newest list is, in days
      now=`$DATE +%s`
      age=`for f in "$lists"/*Release; do stat -L -c %Y "$f" 2>/dev/null; done |
        $SORT -n | $AWK -v now="$now" 'END { if (NR) print int((now - $0) / 86400) }'`
    fi
    ;;
  dnf)
    # what dnf writes in an offline root (rpm's lock; dnf 4's logs and
    # cache lock) must stay in it
    if [ -n "$TIGRIS_ROOT" ] && [ -z "$Tiger_Dnf_Security_Cmd" ] &&
       ! rootnolinks /var/lib/rpm /usr/lib/sysimage/rpm /var/cache/dnf /var/cache/libdnf5 /var/log; then
      unknown="dnf was not asked: it writes in the root, and a symbolic link where it writes could take that onto this host"
    else
      cmd=${Tiger_Dnf_Security_Cmd:-}
      [ -z "$cmd" ] && d=`findtool dnf` && cmd="$d -C -q${TIGRIS_ROOT:+ --installroot=$TIGRIS_ROOT} updateinfo list --security"
      # dnf5 writes its log where it is told, outside the root; dnf 4 would
      # put that directory inside the root, so it keeps its own (and cannot
      # answer when the root is mounted read-only)
      if [ -n "$TIGRIS_ROOT" ] && [ -z "$Tiger_Dnf_Security_Cmd" ] && $d --version 2>/dev/null | $GREP -q '^dnf5'; then
        tooldir=$WORKDIR/updtool.$$
        mkdir -m 700 "$tooldir" && cmd="$cmd --setopt=logdir=$tooldir"
      fi
      errf=$WORKDIR/upd.err.$$
      safe_temp $errf
      if out=`$cmd 2>$errf`; then
        # dnf 4 and 5 lay it out differently; the package is the field
        # shaped name-version-release.arch
        pending=`echo "$out" | $AWK '{ for (i = 1; i <= NF; i++) if ($i ~ /^[^ ]+-[^-]+-[^-]+\.[a-z0-9_]+$/) print $i }' | $SORT -u`
      else
        # dnf's own last word: no cache (makecache has not run), or a
        # read-only root dnf 4 cannot write its log in
        why=`$SED -n '/[^[:space:]]/p' $errf | $SED -n '$p'`
        unknown="dnf could not answer from its cache${why:+ ($why)}"
      fi
      delete $errf
    fi
    # Repositories that install unsigned packages: gpgcheck off in a
    # repo file or [main]. Only an explicit off counts; what the
    # distributor leaves unset stays their default. An unsigned
    # repository lets a compromised mirror serve trojaned packages,
    # which install as root.
    {
      rootls /etc/yum.repos.d 2>/dev/null
      printf '%s\n' /etc/dnf/dnf.conf /etc/yum.conf
    } |
    while read f
    do
      rf=`rootfile "$f"`
      [ -f "$rf" ] || continue
      $AWK '
        /^[ \t]*\[/ { sec = $0; gsub(/[^A-Za-z0-9_.-]/, "", sec); next }
        { l = $0; sub(/#.*$/, "", l) }
        tolower(l) ~ /^[ \t]*gpgcheck[ \t]*=[ \t]*(0|no|false)([ \t]*)$/ {
          if (sec == "main" || sec == "") print "MAIN"; else print sec
        }' "$rf" |
      while read repo
      do
        if [ "$repo" = MAIN ]; then
          message WARN upd005w "Set 'gpgcheck=1' in [main] of $f (with a 'gpgkey='), or remove the file." "The [main] default in $f turns package signing off: every repository without its own gpgcheck installs unsigned packages."
        else
          message WARN upd005w "Set 'gpgcheck=1' (with a 'gpgkey=') for '$repo' in $f, or remove it." "Repository '$repo' installs unsigned packages (gpgcheck off in $f)."
        fi
      done
    done
    ;;
  zypper)
    # what libzypp writes in an offline root (its caches, rpm's lock) must
    # stay in it; its own lock and log are kept out below
    if [ -n "$TIGRIS_ROOT" ] && [ -z "$Tiger_Zypper_Security_Cmd" ] &&
       ! rootnolinks /var/lib/rpm /usr/lib/sysimage/rpm /var/cache/zypp /var/lib/zypp; then
      unknown="zypper was not asked: it writes in the root, and a symbolic link where it writes could take that onto this host"
    else
      cmd=${Tiger_Zypper_Security_Cmd:-}
      [ -z "$cmd" ] && z=`findtool zypper` && cmd="$z --non-interactive --no-refresh${TIGRIS_ROOT:+ --root $TIGRIS_ROOT} --xmlout list-patches --category security"
      # libzypp's lock and log, which it would write in the root, kept out
      if [ -n "$TIGRIS_ROOT" ] && [ -z "$Tiger_Zypper_Security_Cmd" ]; then
        tooldir=$WORKDIR/updtool.$$
        mkdir -m 700 "$tooldir" && {
          ZYPP_LOCKFILE_ROOT=$tooldir ZYPP_LOGFILE=$tooldir/zypper.log
          export ZYPP_LOCKFILE_ROOT ZYPP_LOGFILE
        }
      fi
      if out=`$cmd 2>/dev/null`; then
        pending=`echo "$out" | $GREP '<update ' | $GREP 'category="security"' | $GREP 'status="needed"' |
          $SED -n 's/.* name="\([^"]*\)".*/\1/p' | $SORT -u`
      else
        # its first error (on a read-only root: the cache it could not build)
        why=`echo "$out" | $SED -n 's/.*<message type="error">\([^<]*\).*/\1/p' | $SED -n '1s/[[:space:]:]*$//p'`
        unknown="zypper could not read its repositories without refreshing them${why:+ ($why)}"
      fi
    fi
    ;;
esac
if [ -n "$unknown" ]; then
  message INFO upd004i "" "Security updates waiting cannot be counted: $unknown."
elif [ -n "$pending" ]; then
  n=`echo "$pending" | $GREP -c .`
  trail=`echo "$pending" | list`
  case "$age" in
    '') trail="$trail." ;;
    0) trail="$trail. The package lists were last updated today." ;;
    1) trail="$trail. The package lists were last updated yesterday." ;;
    *) trail="$trail. The package lists were last updated $age days ago." ;;
  esac
  case "$mgr" in
    apt) trail="$trail Install them with 'apt-get upgrade'." ;;
    dnf) trail="$trail Install them with 'dnf upgrade --security'." ;;
    zypper) trail="$trail Install them with 'zypper patch --category security'." ;;
  esac
  message FAIL upd003f "$trail" "$n security updates are waiting to be installed ($mgr)."
fi

#
# Security updates installed automatically
#
auto=
case "$mgr" in
  apt)
    auto=N
    if [ -f "`rootfile /usr/bin/unattended-upgrade`" ] && timer_on apt-daily-upgrade; then
      cmd=${Tiger_AptConfig_Cmd:-}
      [ -z "$cmd" ] && c=`findtool apt-config` && cmd="$c dump"
      if [ -n "$TIGRIS_ROOT" ] && [ -z "$Tiger_AptConfig_Cmd" ]; then
        # the root's apt.conf.d, read as text, in apt's order (its own
        # apt-config would parse it here, #include and all)
        v=`{ rootls /etc/apt/apt.conf.d 2>/dev/null | $AWK -F/ '$NF ~ /^[A-Za-z0-9_.-]+$/ && $NF !~ /\.(dpkg-[a-z]+|ucf-[a-z]+|disabled|bak|orig|save)$/' | $SORT
              echo /etc/apt/apt.conf; } | rootpaths |
          while IFS= read -r f; do [ -n "$f" ] && [ -f "$f" ] && $CAT "$f"; done 2>/dev/null |
          $SED -n 's/^[[:space:]]*APT::Periodic::Unattended-Upgrade[[:space:]]*"\([^"]*\)";.*$/\1/p' | $SED -n '$p'`
      else
        v=`$cmd 2>/dev/null | $SED -n 's/^APT::Periodic::Unattended-Upgrade "\(.*\)";$/\1/p' | $SED -n '$p'`
      fi
      case "$v" in ''|0) ;; *) auto=Y ;; esac
    fi
    # Linux Mint's Update Manager has its own
    timer_on mintupdate-automation-upgrade && auto=Y
    fix="Install unattended-upgrades and run 'dpkg-reconfigure -plow unattended-upgrades' (it installs security updates by default); on Linux Mint, turn on automatic updates in Update Manager's preferences."
    ;;
  dnf)
    auto=N
    timer_on dnf-automatic-install && auto=Y
    if timer_on dnf-automatic || timer_on dnf5-automatic; then
      apply=`printf '%s\n' /etc/dnf/automatic.conf /etc/dnf/dnf5-plugins/automatic.conf | rootcat 2>/dev/null |
        $SED -n 's/^[[:space:]]*apply_updates[[:space:]]*=[[:space:]]*\([A-Za-z0-9]*\).*/\1/p' | $SED -n '$p'`
      case "$apply" in yes|true|1|on|True|Yes) auto=Y ;; esac
    fi
    fix="Install dnf-automatic (dnf5-plugin-automatic on Fedora), set apply_updates = yes and upgrade_type = security in /etc/dnf/automatic.conf, and 'systemctl enable --now dnf-automatic.timer'."
    ;;
esac
[ "$auto" = N ] && message WARN upd002w "$fix" "Security updates are not installed automatically: each waits until someone installs it."

[ -n "$tooldir" ] && rm -rf "$tooldir"
exit 0
