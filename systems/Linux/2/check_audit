#
# check_audit: is there an audit trail: auditd running with rules, and
#                 logs that survive a reboot.
#
# 10/07/2026 atrimbitas - Initial version. auditd is looked for among the
#                 running processes (/proc/PID/comm) and its rules asked of
#                 auditctl -l. journald keeps its logs across reboots when
#                 Storage= is persistent, or auto (the default) with
#                 /var/log/journal present; the setting is the last one in
#                 journald.conf and its drop-ins, ordered as systemd orders
#                 them (by file name, /etc over /run over /usr/lib). A
#                 syslog daemon writing to disk keeps them too.
#                 Tigris_Sysctl_Root prefixes /proc, /etc, /run, /usr and
#                 /var, and Tigris_Auditctl_Cmd replaces auditctl -l, for
#                 the tests.
# 10/23/2026 - The audit log itself: where auditd is configured (running
#                 live; installed and enabled at boot offline, by its
#                 wants link, rc link or OpenRC runlevel) and
#                 /etc/audit/auditd.conf exists, log_file (default
#                 /var/log/audit/audit.log) must exist, be root's and be
#                 readable by nobody but root and log_group: auditd
#                 creates it 0600, or 0640 for log_group (auditd.conf(5)),
#                 and CIS asks for 0640 or tighter. Missing or exposed is
#                 aud012w. Offline, auditd not installed or not enabled
#                 is aud001w, as not running is live; auditctl and
#                 journald are live only.
#
# References:
#   man 8 auditd, man 8 auditctl, man 5 auditd.conf, man 5 journald.conf,
#   CIS Distribution Independent Linux Benchmark 4.1.4 (auditd log files)
#
# Tigris: needs root
#   auditctl lists the rules for root only.
#
# Tigris: offline
#   the root's auditd.conf, its service links and its audit log; the
#   running auditd, its rules and journald are read live only.
#
#-----------------------------------------------------------------------------
#
TigrisInstallDir='.'

#
# Set default base directory.
# Order or preference:
#      -B option
#      TIGERHOMEDIR environment variable
#      TigrisInstallDir installed location
#
basedir=${TIGERHOMEDIR:=$TigrisInstallDir}

for parm
do
   case $parm in
   -B) basedir=$2; break;;
   esac
done

#
# Verify that a config file exists there, and if it does
# source it.
#
[ ! -r $basedir/config ] && {
  echo "--ERROR-- [init002e] No 'config' file in \`$basedir'."
  exit 1
}

. $basedir/config

. $BASEDIR/initdefs

#
# If run in test mode (-t) this will verify that all required
# elements are set.
#
[ "$Tigris_TESTMODE" = 'Y' ] && {
  haveallcmds AWK CAT GREP SED SORT || exit 1
  haveallfiles BASEDIR WORKDIR || exit 1

  echo "--CONFIG-- [init003c] $0: Configuration ok..."
  exit 0
}

#------------------------------------------------------------------------

haveallcmds AWK CAT GREP SED SORT || exit 1

root=${Tigris_Sysctl_Root:-}

echo
echo "# Checking the audit trail (auditd, persistent logs)..."

# running NAME...: is a process with one of these names running. The
# kernel cuts names to 15 characters: systemd-journald is systemd-journal
running()
{
  __names=$*
  $CAT "$root"/proc/[0-9]*/comm 2>/dev/null |
    $AWK -v names=" $__names " 'index(names, " " $0 " ") { found = 1; exit } END { exit !found }'
}

# auditd_enabled: offline, a wants link, rc link or OpenRC runlevel
# starts auditd at boot
auditd_enabled()
{
  for __d in /etc/systemd/system /run/systemd/system /usr/lib/systemd/system /lib/systemd/system
  do
    [ -n "`rootglob "$__d/*.wants/auditd.service"`" ] && return 0
  done
  [ -n "`rootglob '/etc/rc[2-5].d/S*auditd'`" ] || [ -n "`rootglob '/etc/runlevels/*/auditd'`" ]
}

auditd_conf=`rootfile /etc/audit/auditd.conf`
configured=N

#
# auditd
#
if [ -n "$TIGRIS_ROOT" ]; then
  # Offline: installed (its configuration is there) and enabled at boot
  if [ ! -f "$auditd_conf" ]; then
    message WARN aud001w "Install the audit package (auditd on Debian and Ubuntu, audit on Fedora and RHEL), enable it with 'systemctl enable --now auditd', and load rules: the distribution's examples are in /usr/share/doc/audit*/rules." "auditd is not installed (no /etc/audit/auditd.conf): logins, changes to accounts and watched files, and the use of privileges are not recorded in an audit trail."
  elif ! auditd_enabled; then
    message WARN aud001w "Enable it ('systemctl enable --now auditd') and load rules: the distribution's examples are in /usr/share/doc/audit*/rules." "auditd is installed but not enabled at boot: logins, changes to accounts and watched files, and the use of privileges are not recorded in an audit trail."
  else
    configured=Y
  fi
elif ! running auditd; then
  message WARN aud001w "Install the audit package (auditd on Debian and Ubuntu, audit on Fedora and RHEL), enable it with 'systemctl enable --now auditd', and load rules: the distribution's examples are in /usr/share/doc/audit*/rules." "auditd is not running: logins, changes to accounts and watched files, and the use of privileges are not recorded in an audit trail."
else
  configured=Y
  ac_cmd=${Tigris_Auditctl_Cmd:-}
  if [ -z "$ac_cmd" ]; then
    for d in /usr/sbin /sbin /usr/bin /bin
    do
      [ -x "$d/auditctl" ] && { ac_cmd="$d/auditctl -l"; break; }
    done
  fi
  if [ -z "$ac_cmd" ]; then
    message ERROR aud004e "" "auditd is running, but auditctl is not installed, so its rules cannot be listed."
  else
    out=`$ac_cmd 2>&1`; st=$?
    if [ $st -ne 0 ]; then
      message ERROR aud004e "`echo "$out" | $SED -n 1p`" "auditd is running, but its rules cannot be listed ($ac_cmd); that needs root."
    elif [ -z "$out" ] || [ "$out" = "No rules" ]; then
      message WARN aud002w "Rules go in /etc/audit/rules.d/*.rules and are loaded with 'augenrules --load'. A start: watch /etc/passwd, /etc/shadow, /etc/group, /etc/sudoers and /etc/sudoers.d, and record execve by root." "auditd is running with no rules loaded, so it records almost nothing."
    else
      n=`echo "$out" | $GREP -c '^-'`
      message INFO aud003i "" "auditd is running with $n rules loaded."
    fi
  fi
fi

#
# The audit log: log_file in auditd.conf (default /var/log/audit/audit.log)
# exists, is root's, and is readable by nobody but root and log_group
# (auditd creates it 0600, 0640 when log_group is set). getpermit names
# the owner and group from the root's passwd and group files offline.
#
if [ "$configured" = Y ] && [ -f "$auditd_conf" ]; then
  log_file=`$SED 's/#.*//' "$auditd_conf" | $SED -n 's/^[ \t]*log_file[ \t]*=[ \t]*//p' | $SED 's/[ \t]*$//' | $SED -n '$p'`
  log_group=`$SED 's/#.*//' "$auditd_conf" | $SED -n 's/^[ \t]*log_group[ \t]*=[ \t]*//p' | $SED 's/[ \t]*$//' | $SED -n '$p'`
  log_file=${log_file:-/var/log/audit/audit.log}
  log_group=${log_group:-root}
  case "$log_file" in
    /*)
      here=`rootfile "$log_file"`
      if [ ! -f "$here" ]; then
        message WARN aud012w "log_file in /etc/audit/auditd.conf. Start auditd ('systemctl restart auditd'), which creates it; if the directory is gone, recreate it root's, mode 0700." "auditd's log file $log_file does not exist: nothing it records is kept, and whatever an intruder deleted leaves no trace of itself."
      else
        if [ -n "$TIGRIS_ROOT" ]; then __gp=$log_file; else __gp=$here; fi
        # shellcheck disable=SC2046
        set -- `getpermit "$__gp" 2>/dev/null`
        if [ $# -ge 12 ]; then
          why=
          case "$2" in root|0) ;; *) why="owned by $2, not root" ;; esac
          [ "${11}" = 1 ] && why="${why:+$why, }writable by anyone"
          [ "${10}" = 1 ] && why="${why:+$why, }readable by anyone"
          [ "$8" = 1 ] && why="${why:+$why, }writable by group $3"
          if [ "$7" = 1 ]; then
            case "$3" in root|0|"$log_group") ;; *) why="${why:+$why, }readable by group $3 (log_group is $log_group)" ;; esac
          fi
          [ -n "$why" ] && message WARN aud012w "chown root:$log_group \`$log_file'; chmod 0640 \`$log_file' (0600 without a log_group); auditd creates the next one from log_group in /etc/audit/auditd.conf." "auditd's log file $log_file is $why: the audit trail is for root (and log_group) alone, since it records who did what, and whoever can write it can edit what happened."
        fi
      fi ;;
  esac
fi

#
# Logs across reboots: journald's Storage=, or a syslog daemon (live)
#
[ -n "$TIGRIS_ROOT" ] && exit 0
if [ -d "$root/run/systemd/journal" ] || running systemd-journal; then
  # The drop-ins by file name; one name in /etc hides it in /run and
  # /usr/lib, one in /run hides it in /usr/lib
  dropins=`for d in /usr/lib /usr/local/lib /run /etc
  do
    for f in "$root$d"/systemd/journald.conf.d/*.conf
    do
      [ -f "$f" ] && echo "${f##*/} $f"
    done
  done | $AWK '{ path[$1] = $2 } END { for (n in path) print n, path[n] }' | $SORT | $AWK '{ print $2 }'`
  storage=`$CAT "$root/etc/systemd/journald.conf" $dropins 2>/dev/null |
    $SED -n 's/^[[:space:]]*Storage[[:space:]]*=[[:space:]]*\([a-z]*\).*/\1/p' | $SED -n '$p'`
  storage=${storage:-auto}
  case "$storage" in
    persistent) kept=Y ;;
    auto) if [ -d "$root/var/log/journal" ]; then kept=Y; else kept=N; fi ;;
    *) kept=N ;;
  esac
  if [ "$kept" = N ] && ! running rsyslogd syslog-ng syslogd; then
    case "$storage" in
      auto) why="Storage=auto, and /var/log/journal does not exist" ;;
      *) why="Storage=$storage" ;;
    esac
    message WARN logf008w "journald: $why, and no syslog daemon is running. Set Storage=persistent in /etc/systemd/journald.conf (or create /var/log/journal) and restart systemd-journald." "Logs are not kept across reboots: journald holds them in memory only, so a reboot erases what led up to it."
  fi
fi

exit 0
