#
# check_accounting: the collectors besides auditd: sysstat's sadc and
#             snoopy's command logging, judged by what they keep, not
#             by what is installed. sysstat with no data in two days
#             is not collecting (aud005w); data being written is
#             inventoried (aud006i). Snoopy configured but not
#             preloaded logs nothing (aud007w); preloaded is
#             inventoried (aud008i). Neither installed is not a
#             finding, and sysstat explicitly disabled (ENABLED=false
#             in /etc/default/sysstat) is the administrator's choice,
#             not a failure.
#
# 10/16/2026 - Initial version. sysstat binaries, configs, cron and
#             data files; snoopy.ini and /etc/ld.so.preload.
# 10/22/2026 - Installed means the program is there (sar or sadc,
#             the snoopy library under any lib directory, arm64's
#             too): the configuration a removed package leaves
#             behind is not an installation. ld.so.preload is read
#             as ld.so reads it, comments dropped, so a commented
#             snoopy line is not a preload.
# 10/23/2026 - Process accounting (acct on Debian, Ubuntu and Arch,
#             psacct on Fedora and RHEL): accton under the root. Absent
#             is INFO (aud009i): a hardening opportunity no distribution
#             installs, not a weakness. Present with no accounting file
#             (/var/log/account/pacct, /var/account/pacct, /var/log/pacct),
#             or, live, a file not written to in a day (every process
#             exit adds a record), or no service enabling it at boot
#             (acct.service or psacct.service wants link, an rc link,
#             an OpenRC runlevel) is WARN (aud010w); on and enabled is
#             inventoried (aud011i).
#
# References:
#   sar(1), snoopy.ini, accton(8), acct(5)
#
# Tigris: offline
#   the root's binaries, configs, data files and service links; the
#   accounting file's age is read live only.
#
#-----------------------------------------------------------------------------
#
TigrisInstallDir='.'

#
# Set default base directory.
# Order or preference:
#      -B option
#      TIGERHOMEDIR environment variable
#      TigrisInstallDir installed location
#
basedir=${TIGERHOMEDIR:=$TigrisInstallDir}

for parm
do
   case $parm in
   -B) basedir=$2; break;;
   esac
done

#
# Verify that a config file exists there, and if it does
# source it.
#
[ ! -r $basedir/config ] && {
  echo "--ERROR-- [init002e] No 'config' file in \`$basedir'."
  exit 1
}

. $basedir/config

. $BASEDIR/initdefs
#
# If run in test mode (-t) this will verify that all required
# elements are set.
#
[ "$Tigris_TESTMODE" = 'Y' ] && {
  haveallcmds AWK CAT FIND GREP SED || exit 1
  haveallfiles BASEDIR WORKDIR || exit 1

  echo "--CONFIG-- [init003c] $0: Configuration ok..."
  exit 0
}

#------------------------------------------------------------------------

haveallcmds AWK CAT FIND GREP SED || exit 1

# existing_sys: the existing files among the arguments, one per line
existing_sys()
{
  for __f
  do
    [ -f "`rootfile $__f`" ] && echo "$__f"
  done
}

# Installed means the program is there: a removed package leaves its
# configuration behind (dpkg's "rc"), and that collects nothing
sysstat=`existing_sys /usr/bin/sar /usr/bin/sadc /usr/lib/sysstat/sadc /usr/lib64/sa/sadc /usr/lib/sa/sadc /usr/libexec/sysstat/sadc`
snoopy=`for g in '/usr/lib/*-linux-gnu*/libsnoopy.so*' '/lib/*-linux-gnu*/libsnoopy.so*' '/usr/lib64/libsnoopy.so*' '/usr/lib/libsnoopy.so*' '/lib64/libsnoopy.so*' '/usr/local/lib/libsnoopy.so*'
do
  rootglob "$g"
done | $SED -n 1p`

# snooping: whether ld.so.preload loads snoopy, read as ld.so reads it:
# '#' to the end of the line is a comment, and the names are separated
# by blanks or colons
preload=`rootfile /etc/ld.so.preload`
snooping=
[ -f "$preload" ] && $AWK '{ sub(/#.*$/, ""); n = split($0, e, /[: \t]+/)
  for (i = 1; i <= n; i++) if (e[i] ~ /libsnoopy/) y = 1 } END { exit !y }' "$preload" 2>/dev/null && snooping=1

echo
echo "# Checking system accounting (sysstat, snoopy, process accounting)..."

# sysstat: data written in the last two days means collecting. An
# explicit ENABLED=false is the administrator's choice, not a
# failure, and is left alone.
if [ -n "$sysstat" ]; then
  enabled=1
  def=`rootfile /etc/default/sysstat`
  if [ -f "$def" ] && $GREP -i '^[ \t]*ENABLED[ \t]*=[ \t]*["'\'']*false' "$def" >/dev/null 2>&1; then
    enabled=0
  fi
  fresh=
  for d in /var/log/sysstat /var/log/sa
  do
    here=`rootfile $d`
    [ -d "$here" ] || continue
    if [ -n "`$FIND "$here" \( -name 'sa[0-9]*' -o -name 'sar[0-9]*' \) -mtime -2 2>/dev/null`" ]; then
      fresh=$d
    fi
  done
  if [ -n "$fresh" ]; then
    message INFO aud006i "" "sysstat collects system activity (data in $fresh)."
  elif [ "$enabled" = 1 ]; then
    message WARN aud005w "Enable collection (ENABLED=true with a sysstat cron job or timer) or remove sysstat." "sysstat is installed but collects nothing: no data in two days, so the activity history an investigation wants is not there."
  fi
fi

# Snoopy: installed but not preloaded logs nothing
if [ -n "$snooping" ]; then
  message INFO aud008i "" "Snoopy logs commands to syslog (preloaded from /etc/ld.so.preload)."
elif [ -n "$snoopy" ]; then
  message WARN aud007w "Preload it (its library in /etc/ld.so.preload) or remove the configuration." "Snoopy is configured but not preloaded, so it logs no commands."
fi

# Process accounting: the program, the file it writes, the service that
# turns it on at boot (acct.service on Debian, Ubuntu and Arch,
# psacct.service on Fedora and RHEL; an rc link or an OpenRC runlevel
# elsewhere), and, live, whether the file is being written
accton=`existing_sys /usr/sbin/accton /sbin/accton /usr/bin/accton | $SED -n 1p`
if [ -z "$accton" ]; then
  message INFO aud009i "Install acct (psacct on Fedora and RHEL) and enable its service, and 'lastcomm' and 'sa' answer who ran what." "No process accounting (acct, psacct) is installed: which account ran which command, and when, is not recorded. A hardening opportunity rather than a weakness: no distribution installs it."
else
  pacct=
  for f in /var/log/account/pacct /var/account/pacct /var/log/pacct
  do
    [ -f "`rootfile $f`" ] && { pacct=$f; break; }
  done
  enabled=
  for u in acct.service psacct.service
  do
    for d in /etc/systemd/system /run/systemd/system /usr/lib/systemd/system /lib/systemd/system
    do
      [ -n "`rootglob "$d/*.wants/$u"`" ] && { enabled=$u; break; }
    done
    [ -n "$enabled" ] && break
  done
  if [ -z "$enabled" ]; then
    for g in '/etc/rc[2-5].d/S*acct' '/etc/runlevels/*/acct' '/etc/runlevels/*/psacct'
    do
      [ -n "`rootglob "$g"`" ] && { enabled="an init script"; break; }
    done
  fi
  stale=
  if [ -n "$pacct" ] && [ -z "$TIGRIS_ROOT" ]; then
    ph=`rootfile $pacct`
    [ -n "`$FIND "$ph" -mtime -1 2>/dev/null`" ] || stale=1
  fi
  if [ -z "$pacct" ]; then
    message WARN aud010w "$accton is installed. Create the file ('touch /var/log/account/pacct') and enable the service ('systemctl enable --now acct'; psacct on Fedora and RHEL)." "Process accounting is installed but its file is missing (no /var/log/account/pacct, /var/account/pacct or /var/log/pacct): nothing is recorded."
  elif [ -n "$stale" ]; then
    message WARN aud010w "Turn it on ('systemctl enable --now acct'; psacct on Fedora and RHEL, or 'accton $pacct')." "Process accounting is installed but $pacct has not been written to in a day: accounting is off, though every process that exits should add a record."
  elif [ -z "$enabled" ]; then
    message WARN aud010w "Enable the service ('systemctl enable --now acct'; psacct on Fedora and RHEL)." "Process accounting is installed and $pacct exists, but no service turns it on at boot: after a reboot nothing is recorded."
  else
    message INFO aud011i "" "Process accounting records to $pacct ($enabled enabled)."
  fi
fi

exit 0
