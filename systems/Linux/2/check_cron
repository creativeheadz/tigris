# Linux/2/check_cron - 08/12/2002
# 10/07/2026 - atrimbitas - Look where Debian keeps crontabs too
#     (/var/spool/cron/crontabs: only /var/spool/cron was looked at, so a
#     disabled account's crontab was never found there), and on an offline
#     root (--root) in that root, resolved inside it.
# 10/23/2026 - atrimbitas - The crontab directories are the system
#     config's CRON_USER_DIRS (FreeBSD's /var/cron/tabs, macOS's
#     /var/at/tabs), Linux's two by default; the name is one word.
#
# check_cron USER: YES when USER has a crontab, NO otherwise.
#
#-----------------------------------------------------------------------------
#
case "$1" in ''|*/*) echo "NO"; exit 0 ;; esac
for d in ${CRON_USER_DIRS:-/var/spool/cron/crontabs /var/spool/cron}
do
  f=$d/$1
  [ -n "$TIGRIS_ROOT" ] &&
    f=`printf '%s\n' "$f" | AWK=${AWK:-awk} sh "$BASEDIR/util/rootpath" "$TIGRIS_ROOT" "$TIGRIS_LINKS"`
  [ -n "$f" ] && [ -f "$f" ] && { echo "YES"; exit 0; }
done
echo "NO"
