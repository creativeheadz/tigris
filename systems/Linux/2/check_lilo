#
# check_lilo:  checks permissions on boot loader config files
#		grub.conf and lilo.conf
# 10.26.2001
# Paul Telford <paul_telford@hp.com>
# 04.25.2002  Javier Fernandez-Sanguino <jfs@computer.org>
# Expanded to check also if there are passwords in the boot loader
# 07/25/2002 jfs       
# Changed TigrisInstallDir to .
# Changed -e to -r and 'find' to 'access' in the error msg.
# 10/19/2003 jfs - Applied patch from Ryan Bradetich to work in SuSE systems.
# 11/18/2003 jfs - Fixed typo (Debian bug #221470)
# 01/15/2004 jfs - Fixed dependancies
# 12/27/2004 jfs - Fixed grub.conf naming (Debian bug #286641)
# 03/21/2005 jfs   Only run if running on the x86 architecture
#                  (Debian bug #288737)
# 06/22/2007 jfs   Run if on amd64 (Debian bug #412669)
# 02/10/2018 jfs   Only complain if grub is world readable when it has a
#                  password configured (Ubuntu bug 248843)
#                  Look for grub in the proper location (as used in Grub 2)
# 10/23/2026 atrimbitas - GRUB 2's configuration is read where Fedora, RHEL
#                  and SUSE keep it too (/boot/grub2/grub.cfg; they got
#                  boot005w), with user.cfg (grub2-setpassword) and
#                  custom.cfg, and a password counts only with superusers
#                  set, without which GRUB asks for none (grub2_password).
#                  It runs on every architecture; only on x86, where a
#                  LILO or GRUB is to be expected, does finding neither
#                  say boot005w.
#
# References:
#   https://www.gnu.org/software/grub/manual/grub/html_node/Authentication-and-authorisation.html
#   man 8 grub2-setpassword (Red Hat), man 5 lilo.conf
#
# Tigris: needs root
#   the boot loader's configuration is root's to read.
#
# Tigris: offline
#   the root's boot loader configuration; getpermit reads the
#   root's files itself.
#
#-----------------------------------------------------------------------------
#
TigrisInstallDir='.'

#
# Set default base directory.
# Order or preference:
#      -B option
#      TIGERHOMEDIR environment variable
#      TigrisInstallDir installed location
#
basedir=${TIGERHOMEDIR:=$TigrisInstallDir}

for parm
do
   case $parm in
   -B) basedir=$2; break;;
   esac
done
#
# Verify that a config file exists there, and if it does
# source it.
#
[ ! -r $basedir/config ] && {
  echo "--ERROR-- [init002e] No 'config' file in \`$basedir'."
  exit 1
}
. $basedir/config

. $BASEDIR/initdefs
#
# If run in test mode (-t) this will verify that all required
# elements are set.
#
[ "$Tigris_TESTMODE" = 'Y' ] && {
  haveallcmds AWK GREP RM UNAME EGREP || exit 1
  haveallfiles BASEDIR WORKDIR || exit 1
  
  echo "--CONFIG-- [init003c] $0: Configuration ok..."
  exit 0
}
#------------------------------------------------------------------------
haveallcmds AWK GREP RM UNAME EGREP || exit 1
haveallfiles BASEDIR WORKDIR || exit 1

# A configuration that is there is checked on any architecture (GRUB
# boots arm64 and others too); finding none is reported only where a LILO
# or GRUB is to be expected: on x86, or under --root, whose architecture
# is not this host's.
expected=Y
if [ -z "$TIGRIS_ROOT" ]; then
  machine=`$UNAME -m`
  [ -z "`echo $machine | $EGREP 'i.86$|^x86_64$'`" ] && expected=N
fi

echo
echo "# Checking boot loader file permissions..."
found="N"

file=/etc/lilo.conf
herefile=`__here "$file"`
if [ -r "$herefile" ]
then

	found="Y"
	getpermit $file |
	   while read filename rowner rgroup rur ruw rux rgr rgw rgx ror row rox rsuid rsgid rstk
	do

	if [ $rgr -eq 1 -o $rgw -eq 1 -o $rgx -eq 1 ]
	then
                message WARN boot001w "" "The configuration file lilo.conf has group permissions"
	fi
	if [ $ror -eq 1 -o $row -eq 1 -o $rox -eq 1 ]
	then
                message FAIL boot002f "" "The configuration file lilo.conf has other permissions"
        fi

	done

	# Lilo password checks
	if [ -n "`$GREP ^restricted "$herefile"`" ] ; then
            if [ -z "`$GREP ^password "$herefile"`" ] ; then
                message WARN boot007w "" "The bootloader is restricted but does not seem to have a password configured."
	    fi 
	else
                message WARN boot006w "" "The bootloader lilo is not configured with a password"
	fi

fi

# grubperm FILE: GRUB's file that holds the password should be root's to
# read alone. (Without a password there is nothing in it to hide.)
grubperm()
{
	getpermit "$1" |
	while read filename rowner rgroup rur ruw rux rgr rgw rgx ror row rox rsuid rsgid rstk
	do
	    if [ $rgr -eq 1 -o $rgw -eq 1 -o $rgx -eq 1 ]; then
		message WARN boot003w "" "The Grub bootloader configuration file $1 has group permissions. Should be 0600 o 0400."
	    fi
	    if [ $ror -eq 1 -o $row -eq 1 -o $rox -eq 1 ]; then
		message FAIL boot004f "" "The Grub bootloader configuration file $1 has world readable permissions. Should be 0600 o 0400."
	    fi
	done
}

# GRUB 2: /boot/grub (Debian, Ubuntu, Arch) or /boot/grub2 (Fedora, RHEL,
# SUSE). A password protects the boot entries only with superusers set.
grub2=
for file in /boot/grub/grub.cfg /boot/grub2/grub.cfg
do
	[ -r "`__here "$file"`" ] || continue
	found="Y"; grub2="Y"
	case "`grub2_password "$file"`" in
	  ok*user.cfg)
		grubperm "$file"; grubperm "${file%/*}/user.cfg" ;;
	  ok*)
		grubperm "$file" ;;
	  nosuper)
		message WARN boot008w "" "The Grub bootloader configuration file ($file) sets a password but no superusers (set superusers=), so GRUB asks for none." ;;
	  *)
		message WARN boot008w "" "The Grub bootloader configuration file ($file) does not have a password configured." ;;
	esac
done

# GRUB Legacy (0.9x): old SuSE's /etc/grub.conf, old Debian's
# /boot/grub/menu.lst, other systems' /boot/grub/grub.conf, the first
# there. A password line is all it takes.
if [ -z "$grub2" ]; then
  for file in /etc/grub.conf /boot/grub/menu.lst /boot/grub/grub.conf
  do
	herefile=`__here "$file"`
	[ -r "$herefile" ] || continue
	found="Y"
	if [ -z "`$EGREP '^[[:blank:]]*password' "$herefile"`" ] ; then
		message WARN boot008w "" "The Grub bootloader configuration file ($file) does not have a password configured."
	else
		grubperm "$file"
	fi
	break
  done
fi

[ "$found" != 'Y' ] && [ "$expected" = Y ] && {
	message WARN boot005w "" "Could not access LILO's or Grub's configuration file"
}

exit 0
