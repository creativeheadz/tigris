#
# check_storage: the mount options of the world-writable file systems,
#                 disk encryption, swap under it, core dumps, USB storage
#                 and authorization, the LVM layout, ACLs past the mode,
#                 the locate database.
#
# 10/07/2026 atrimbitas - Initial version. Mounts come from /proc/mounts,
#                 swap from /proc/swaps. A device is encrypted when it, or
#                 a device under it (LVM on LUKS: /sys/class/block/X/slaves),
#                 is a dm-crypt mapping (dm/uuid begins CRYPT-). A machine
#                 is portable when it has a battery of its own (type
#                 Battery, scope not Device: a wireless mouse's does not
#                 count). Core dumps are files when kernel.core_pattern is
#                 not a pipe to a handler (systemd-coredump, apport).
#                 USB storage is looked at only when Tigris_Storage_NoUSB=Y
#                 says the policy is to have none. fs.suid_dumpable is
#                 check_sysctl's (lin027w). Containers are left alone.
#                 Tigris_Sysctl_Root prefixes /proc, /sys, /dev and /etc
#                 for the tests.
#
# References:
#   man 8 mount, man 5 tmpfs, man 8 cryptsetup, man 5 core
#
# 10/07/2026 atrimbitas - An offline root (--root): what it sets up at boot
#                 instead of what is mounted now. Mount options from its
#                 /etc/fstab (/tmp also from systemd's tmp.mount); disk and
#                 swap encryption from its /etc/crypttab (stor009i when it
#                 names no device: an INFO, since ZFS and others encrypt
#                 without it); core dumps from the core_pattern its sysctl.d
#                 sets, the kernel's "core" when nothing does; USB and
#                 FireWire storage from its modprobe.d (each behind its
#                 own policy setting). The LVM layout from its metadata
#                 backups (stor011i), named ACL entries past the mode on
#                 root's files (stor012w, getfacl, Tigris_Getfacl to point
#                 elsewhere), and the locate database, whose filenames
#                 name everything (stor013w). What only the hardware says
#                 (a battery) is not asked.
# 10/16/2026 - USB authorization detail: USBGuard running (stor014i),
#                 configured but dead (stor015w), or allowing every
#                 device (stor016w, live and offline); usb-storage
#                 blacklists must cover uas too (USB3 sticks use it);
#                 usbcore authorized_default=0 counts as no-USB
#                 enforcement; a connected storage device is reported.
# 10/22/2026 - authorized_default is the running kernel's (0, or 2 for
#                 internal devices only), not modprobe.d's, which a
#                 usbcore built into the kernel (Ubuntu's) never reads;
#                 an offline root's boot command line is not read, so
#                 there it is not credited. The connected device is
#                 named by its product, which sysfs keeps on the
#                 device, not on the interface. Mount points and swap
#                 paths reach awk through the environment.
# 10/23/2026 - The other mount points CIS 1.1.2 names, each judged
#                 only when it is a mount of its own (live from
#                 /proc/mounts, offline from fstab): /home and /var
#                 without nodev or nosuid, /var/log and /var/log/audit
#                 without those or noexec, /run without nodev or nosuid
#                 and /dev without nosuid are WARN (stor017w: CIS level
#                 1, and every init mounts /dev and /run that way).
#                 /boot without nodev or nosuid, and /dev without
#                 noexec, are INFO (stor018i): no stock install sets
#                 them and CIS does not ask (noexec on /boot is not
#                 judged at all: nothing runs from there once Linux is
#                 up, and whoever can write there is root already).
#                 /home or /var being part of the root file system is
#                 INFO (stor019i): CIS level 2, and most stock installs
#                 have one root.
# 10/23/2026 - A core_pattern piped to systemd-coredump was taken as
#                 safe whatever it did with the dumps. Now its
#                 coredump.conf and coredump.conf.d (coredump.conf(5):
#                 /etc over /run over /usr/lib, drop-ins by name, the
#                 later winning) are read: Storage=none or
#                 ProcessSizeMax=0 keeps nothing, and is what CIS 1.5
#                 asks for; otherwise the dumps are kept, root's and the
#                 crashing user's own, and stor020i says so at INFO (it
#                 is what every stock systemd host does, and core(5) and
#                 systemd-coredump(8) call it safe: the dump of a setuid
#                 program is withheld from the user when fs.suid_dumpable
#                 is 2, check_sysctl's lin044i). A pipe to anything else
#                 (apport, abrt) is left alone as before. Live and offline.
#
# Tigris: offline
#   what the root sets up at boot: fstab, crypttab, sysctl.d,
#   modprobe.d, lvm backups, ACLs, the locate database.
#
#-----------------------------------------------------------------------------
#
TigrisInstallDir='.'

#
# Set default base directory.
# Order or preference:
#      -B option
#      TIGERHOMEDIR environment variable
#      TigrisInstallDir installed location
#
basedir=${TIGERHOMEDIR:=$TigrisInstallDir}

for parm
do
   case $parm in
   -B) basedir=$2; break;;
   esac
done

#
# Verify that a config file exists there, and if it does
# source it.
#
[ ! -r $basedir/config ] && {
  echo "--ERROR-- [init002e] No 'config' file in \`$basedir'."
  exit 1
}

. $basedir/config

. $BASEDIR/initdefs

#
# If run in test mode (-t) this will verify that all required
# elements are set.
#
[ "$Tigris_TESTMODE" = 'Y' ] && {
  haveallcmds AWK CAT GREP LS SED || exit 1
  haveallfiles BASEDIR WORKDIR || exit 1

  echo "--CONFIG-- [init003c] $0: Configuration ok..."
  exit 0
}

#------------------------------------------------------------------------

haveallcmds AWK CAT GREP LS SED || exit 1

root=${Tigris_Sysctl_Root:-}

# usb_blocked: whether modprobe.d blocks usb-storage and uas, by
# blacklist or install override. Both: USB3 sticks use uas when it
# loads, so blocking usb-storage alone leaves them working.
usb_blocked()
{
  { rootls /etc/modprobe.d; rootls /usr/lib/modprobe.d; rootls /lib/modprobe.d; } | $GREP '\.conf$' | rootcat 2>/dev/null |
    $AWK '!/^[ \t]*#/ && ($1 == "blacklist" || $1 == "install") {
      if ($2 == "usb-storage" || $2 == "usb_storage") stor = 1
      if ($2 == "uas") uas = 1 } END { exit !(stor && uas) }'
}

# usb_auth_default: whether new USB devices start unauthorized: the
# running kernel's usbcore authorized_default is 0 (none) or 2
# (internal devices only). sysfs holds what the kernel took, from its
# command line or, for a usbcore module, from modprobe; modprobe.d
# alone proves nothing, since a usbcore built into the kernel (as
# Ubuntu builds it) never reads it. An offline root's boot command
# line is not read, so there nothing is credited.
usb_auth_default()
{
  [ -n "$TIGRIS_ROOT" ] && return 1
  case "`$CAT "$root/sys/module/usbcore/parameters/authorized_default" 2>/dev/null`" in
    0|2) return 0 ;;
  esac
  return 1
}

# usb_storage_connected: a connected USB mass-storage interface, named
# by its device's product string when it has one, its bus address
# otherwise. The interface (1-2:1.0) carries the class; the product is
# the device's (1-2), the directory above it. Live systems only: an
# offline root has no live sysfs.
usb_storage_connected()
{
  for __c in "$root"/sys/bus/usb/devices/*/bInterfaceClass
  do
    [ "`$CAT "$__c" 2>/dev/null`" = 08 ] || continue
    __i=${__c%/*}
    __p=`$CAT "$__i/../product" 2>/dev/null`
    if [ -n "$__p" ]; then printf '%s\n' "$__p"; else printf '%s\n' "${__i##*/}"; fi
    return 0
  done
  return 1
}

# usbguard_conf: whether USBGuard is configured (its daemon config or
# its rules file exists)
usbguard_conf()
{
  [ -f "`rootfile /etc/usbguard/usbguard-daemon.conf`" ] || [ -f "`rootfile /etc/usbguard/rules.conf`" ]
}

# usbguard_rules: the USBGuard rules file's audited-system path: RuleFile
# in usbguard-daemon.conf, else the stock path, when it exists
usbguard_rules()
{
  __d=`rootfile /etc/usbguard/usbguard-daemon.conf`
  if [ -f "$__d" ]; then
    __r=`$SED 's/#.*//' "$__d" 2>/dev/null | $SED -n 's/^[ \t]*RuleFile[ \t]*=[ \t]*//p' | $SED 's/[ \t]*$//' | $SED -n '$p'`
    case "$__r" in ''|/*) ;; *) __r=/etc/usbguard/$__r ;; esac
    [ -n "$__r" ] && [ -f "`rootfile "$__r"`" ] && { echo "$__r"; return 0; }
  fi
  [ -f "`rootfile /etc/usbguard/rules.conf`" ] && echo /etc/usbguard/rules.conf
  return 0
}

# usbguard_running: whether the USBGuard daemon runs. Live systems only.
usbguard_running()
{
  $CAT "$root"/proc/[0-9]*/comm 2>/dev/null |
    $AWK '$0 == "usbguard" || $0 == "usbguard-daemon" { y = 1 } END { exit !y }'
}

# storage_usbguard: USBGuard's rules as configured, live or in a root:
# a bare 'allow' lets every device through
storage_usbguard()
{
  rules=`usbguard_rules`
  [ -n "$rules" ] || return 0
  $AWK '{ sub(/#.*$/, ""); gsub(/^[ \t]+|[ \t]+$/, ""); if ($0 == "allow") { y = 1 } } END { exit !y }' "`rootfile "$rules"`" 2>/dev/null &&
    message WARN stor016w "Replace the bare allow with rules naming the permitted devices, in $rules." "USBGuard allows every USB device (a bare 'allow' in $rules): the guard changes nothing."
}

# firewire_blocked: the same for the FireWire stack, whose DMA gives a
# device on the bus direct memory access
firewire_blocked()
{
  { rootls /etc/modprobe.d; rootls /usr/lib/modprobe.d; rootls /lib/modprobe.d; } | $GREP '\.conf$' | rootcat 2>/dev/null |
    $AWK '!/^[ \t]*#/ && (($1 == "blacklist" || $1 == "install") && ($2 == "firewire-core" || $2 == "firewire_core" || $2 == "firewire-ohci" || $2 == "firewire_ohci" || $2 == "ohci1394" || $2 == "ieee1394" || $2 == "sbp2" || $2 == "eth1394")) { y = 1 } END { exit !y }'
}

# lvm_info FILE: "vg|lvs" for an LVM metadata backup: the volume
# group's name (its top block, or a volume_group line) and its
# logical volumes, or "vg|" when none parse
lvm_info()
{
  $AWK '
  # [{] inside brackets: a brace is literal there on every awk,
  # while /{/ does not compile on busybox awk
  !havg && /^[ \t]*[A-Za-z0-9_][A-Za-z0-9_.-]*[ \t]*[{][ \t]*$/ {
    vg = $0; sub(/[ \t]*[{][ \t]*$/, "", vg); sub(/^[ \t]*/, "", vg); havg = 1; next }
  !havg && /volume_group[ \t]*"/ {
    vg = $0; sub(/^.*"/, "", vg); sub(/".*/, "", vg); havg = 1; next }
  /logical_volumes[ \t]*[{]/ { inlv = 1; depth = 1; next }
  inlv {
    if (depth == 1 && $0 ~ /^[ \t]*"?[^" \t{]+"?[ \t]*[{]/) {
      n = $0; sub(/^[ \t]*/, "", n); sub(/[ \t]*[{].*$/, "", n); gsub(/"/, "", n)
      lvs = (lvs == "" ? n : lvs ", " n)
    }
    depth += gsub(/[{]/, "&") - gsub(/[}]/, "&")
    if (depth <= 0) inlv = 0
  }
  END { if (vg != "") print vg "|" lvs }' "$1" 2>/dev/null
}

# acl_extra HOSTPATH: the named user/group entries getfacl reports
# beyond the file's mode, minus root's own, comma-separated
acl_extra()
{
  $__getfacl "$1" 2>/dev/null | $AWK '
  /^#/ { next }
  /^user:root:/ { next }
  /^group:root:/ { next }
  /^(user|group):[^:]+:/ { printf "%s%s", (n++ ? ", " : ""), $0 }
  END { if (n) printf "\n" }'
}

# storage_second: the LVM layout, the ACLs past the mode, and the
# locate database. Everything here reads through the root, so one
# implementation serves the offline branch and the live one.
storage_second()
{
  # LVM layout, from its metadata backups
  for vgb in `rootls /etc/lvm/backup 2>/dev/null`
  do
    vgh=`rootfile $vgb`
    [ -f "$vgh" ] || continue
    info=`lvm_info "$vgh"`
    [ -n "$info" ] || continue
    lvs=${info#*|}
    if [ -n "$lvs" ]; then
      message INFO stor011i "" "LVM volume group ${info%%|*} holds logical volumes $lvs."
    else
      message INFO stor011i "" "LVM volume group ${info%%|*} is configured."
    fi
  done
  # Named access beyond the mode, on files that should be root's alone
  # (Tigris_Getfacl points at another getfacl, for the tests)
  __getfacl=${Tigris_Getfacl:-getfacl}
  havefacl=
  case "$__getfacl" in
    */*) [ -x "$__getfacl" ] && havefacl=Y ;;
    *) command -v "$__getfacl" >/dev/null 2>&1 && havefacl=Y ;;
  esac
  if [ -n "$havefacl" ]; then
    aclpaths="/etc/shadow /etc/gshadow /etc/sudoers"
    for s in `rootls /etc/sudoers.d 2>/dev/null`
    do
      case "${s##*/}" in .*|*~) ;; *) aclpaths="$aclpaths $s" ;; esac
    done
    for k in `rootls /etc/ssh 2>/dev/null`
    do
      case "${k##*/}" in *_key) aclpaths="$aclpaths $k" ;; esac
    done
    for a in $aclpaths
    do
      ah=`rootfile $a`
      [ -f "$ah" ] || continue
      extra=`acl_extra "$ah"`
      [ -n "$extra" ] && message WARN stor012w "Take the extra entries off \`$a' ('setfacl -x' each away, or 'setfacl -b' to clear them all)." "\`$a' grants $extra beyond its mode: whoever is named reaches past it."
    done
  fi
  # The locate database names every file on the box: plocate's (the
  # default on current Debian, Ubuntu and Fedora), mlocate's, slocate's,
  # each read by its setgid locate through a group of its own, and
  # findutils' (no group of its own)
  for l in /var/lib/plocate/plocate.db:plocate /var/lib/mlocate/mlocate.db:mlocate \
           /var/lib/slocate/slocate.db:slocate /var/lib/locatedb:root /var/cache/locate/locatedb:root
  do
    ldb=${l%:*} lgr=${l##*:}
    [ -f "`rootfile $ldb`" ] || continue
    why=`exposed "$ldb" $lgr`
    [ -n "$why" ] && message WARN stor013w "Leave the locate database to root and its group ('chown root:$lgr \`$ldb'; chmod 640 \`$ldb')." "The locate database \`$ldb' is $why: its filenames name every file on the box, and every account with a home."
  done
}

# core_limited: whether limits.conf, or a file of limits.d, sets a hard
# limit of 0 on core files for everyone
core_limited()
{
  { echo /etc/security/limits.conf; rootls /etc/security/limits.d | $GREP '\.conf$'; } | rootcat 2>/dev/null |
    $AWK '!/^[ \t]*#/ && $1 == "*" && $2 == "hard" && $3 == "core" && $4 == "0" { y = 1 } END { exit !y }'
}

# opts MOUNTPOINT: its options from the mount table (/proc/mounts live,
# fstab's entries offline: "source mountpoint type options" either way),
# or nothing when it is not a mount of its own. The path reaches awk
# through the environment: -v reads backslash escapes, and /proc/mounts
# writes a blank in a path as \040.
opts()
{
  printf '%s\n' "$table" | m="$1" $AWK '$2 == ENVIRON["m"] { o = $4 } END { print o }'
}

# missing_opts OPTIONS WANTED: those of the comma-separated WANTED
# options that OPTIONS lacks, comma-separated
missing_opts()
{
  __mo=
  for __w in `printf '%s\n' "$2" | $SED 's/,/ /g'`
  do
    case ",$1," in *",$__w,"*) ;; *) __mo="$__mo,$__w" ;; esac
  done
  printf '%s\n' "${__mo#,}"
}

# storage_mounts: the other mount points CIS 1.1.2 names, and the two
# every init mounts itself. Each is judged only when it is a mount of
# its own; an fstab line with noauto (and no automount) mounts nothing
# at boot and is passed over. $where says how the options were set, for
# the detail line.
storage_mounts()
{
  for spec in /home:nodev,nosuid /var:nodev,nosuid /var/log:nodev,nosuid,noexec \
              /var/log/audit:nodev,nosuid,noexec /run:nodev,nosuid /dev:nosuid
  do
    m=${spec%%:*} want=${spec#*:}
    o=`opts $m`
    case ",$o," in *,noauto,*) case ",$o," in *,x-systemd.automount,*) ;; *) o= ;; esac ;; esac
    if [ -z "$o" ]; then
      case $m in
        /home|/var) [ -d "`rootfile $m`" ] &&
          message INFO stor019i "Give $m a file system of its own (a partition, an LVM volume or a btrfs subvolume), mounted nodev,nosuid." "$m is part of the root file system: filling it fills /, and it cannot be mounted nodev or nosuid on its own." ;;
      esac
      continue
    fi
    missing=`missing_opts "$o" "$want"`
    [ -n "$missing" ] || continue
    why=
    case ",$missing," in *,nodev,*|*,nosuid,*) why="a setuid program or a device node left there is honoured" ;; esac
    case ",$missing," in *,noexec,*) why="${why:+$why, and }programs can be run from it" ;; esac
    message WARN stor017w "Mounted with $o$where. Add $missing to its options (in /etc/fstab, or a drop-in for its .mount unit)." "$m is mounted without $missing: $why."
  done
  # Hardening past what any stock install does: /boot (root's alone, so
  # nodev and nosuid only make a difference to someone who is root
  # already) and noexec on /dev (systemd mounts it nosuid, not noexec)
  o=`opts /boot`
  case ",$o," in *,noauto,*) o= ;; esac
  if [ -n "$o" ]; then
    missing=`missing_opts "$o" nodev,nosuid`
    [ -n "$missing" ] && message INFO stor018i "Mounted with $o$where. Adding $missing costs nothing: only the boot loader reads /boot before Linux runs." "/boot is mounted without $missing."
  fi
  o=`opts /dev`
  if [ -n "$o" ]; then
    case ",$o," in
      *,noexec,*) ;;
      *) message INFO stor018i "Mounted with $o$where. systemd mounts /dev nosuid but not noexec; adding noexec (a drop-in for dev.mount, or a remount at boot) stops /dev being a place to run from." "/dev is mounted without noexec." ;;
    esac
  fi
}

# coredump_conf: what systemd-coredump is configured to do with a dump,
# "Storage<TAB>where set<TAB>ProcessSizeMax<TAB>where set", the defaults
# (external, 32G) where nothing sets them. coredump.conf(5): the main
# file (/etc/systemd/coredump.conf, or /usr/lib's when there is none)
# is read first and the drop-ins of /etc, /run, /usr/local/lib and
# /usr/lib's coredump.conf.d after it, one of a name (the first of those
# directories to have it, so /etc masks a vendor's, a link to /dev/null
# included), in the order of their names, the last of a key winning.
coredump_conf()
{
  {
    for __m in /etc/systemd/coredump.conf /run/systemd/coredump.conf /usr/lib/systemd/coredump.conf
    do
      [ -f "`rootfile $__m`" ] && { echo "$__m"; break; }
    done
    for __d in /etc/systemd/coredump.conf.d /run/systemd/coredump.conf.d /usr/local/lib/systemd/coredump.conf.d /usr/lib/systemd/coredump.conf.d
    do
      rootls $__d
    done | $AWK '/\.conf$/ { n = $0; sub(/.*\//, "", n); if (!(n in seen)) { seen[n]; print n "\t" $0 } }' |
      $SORT | $AWK -F'\t' '{ print $2 }'
  } | while IFS= read -r __f
  do
    __h=`rootfile "$__f"`
    [ -n "$__h" ] && [ -f "$__h" ] || continue
    src="$__f" $AWK '
      { sub(/^[ \t]+/, ""); sub(/[ \t]+$/, "") }
      /^[#;]/ || $0 == "" { next }
      /^\[/ { insect = ($0 == "[Coredump]"); next }
      insect && /^(Storage|ProcessSizeMax)[ \t]*=/ {
        k = $0; sub(/[ \t]*=.*/, "", k)
        v = $0; sub(/^[^=]*=[ \t]*/, "", v)
        printf "%s\t%s\t%s\n", k, v, ENVIRON["src"]
      }' "$__h"
  done | $AWK -F'\t' '
    $1 == "Storage" { s = $2; sf = $3 }
    $1 == "ProcessSizeMax" { z = $2; zf = $3 }
    END {
      if (s == "") { s = "external"; sf = "the default" }
      if (z == "") { z = "32G"; zf = "the default" }
      printf "%s\t%s\t%s\t%s\n", s, sf, z, zf
    }'
}

# coredump_judge: the dumps systemd-coredump keeps, if any (stor020i)
coredump_judge()
{
  IFS='	' read -r cstore cstorefile csize csizefile <<EOF
`coredump_conf`
EOF
  [ "$cstore" = none ] && return 0
  case "$csize" in 0|0[KMGTPEB]|0[KMGTPE]B) return 0 ;; esac
  case "$cstorefile" in "the default") swhere="$cstorefile" ;; *) swhere="set in $cstorefile" ;; esac
  case "$csizefile" in "the default") zwhere="$csizefile" ;; *) zwhere="set in $csizefile" ;; esac
  case "$cstore" in
    journal) kept="in the journal, with the rest of the system log" ;;
    *) kept="in /var/lib/systemd/coredump, readable by root and by the user whose program crashed" ;;
  esac
  message INFO stor020i "Storage=$cstore ($swhere), ProcessSizeMax=$csize ($zwhere). CIS 1.5 asks for Storage=none and ProcessSizeMax=0, in a file of /etc/systemd/coredump.conf.d; keep the dumps where crashes are debugged on this host." "systemd-coredump keeps core dumps ($kept): a crashed program's memory, passwords and keys included, outlives it."
}

if [ -n "$TIGRIS_ROOT" ]; then
  echo
  echo "# Checking the mount options, encryption and core dumps $TIGRIS_ROOT sets up at boot..."
  fstab=`rootfile /etc/fstab`
  crypttab=`rootfile /etc/crypttab`
  # fstab's entries, "device mountpoint type options", comments left out
  entries=`$AWK '!/^[ \t]*#/ && NF >= 4 { print $1, $2, $3, $4 }' "$fstab" 2>/dev/null`
  # crypttab's mapping names
  crypted=`$AWK '!/^[ \t]*#/ && NF >= 2 { print $1 }' "$crypttab" 2>/dev/null`

  # The world-writable file systems, as fstab (or tmp.mount) mounts them
  if [ -n "$entries" ]; then
    for m in /tmp /dev/shm /var/tmp
    do
      o=`printf '%s\n' "$entries" | m="$m" $AWK '$2 == ENVIRON["m"] { o = $4 } END { print o }'`
      src=/etc/fstab
      if [ -z "$o" ] && [ "$m" = /tmp ]; then
        # systemd's tmp.mount, when it is enabled and not masked
        mask=`rootfile /etc/systemd/system/tmp.mount` null=`rootfile /dev/null`
        for w in /etc/systemd/system/local-fs.target.wants/tmp.mount /usr/lib/systemd/system/local-fs.target.wants/tmp.mount
        do
          u=`rootfile $w`
          [ -f "$u" ] && [ "$mask" != "$null" ] || continue
          o=`$SED -n 's/^Options=//p' "$u" | $SED -n '$p'`
          src="systemd's tmp.mount"
          [ -n "$o" ] && break
        done
      fi
      if [ -z "$o" ]; then
        [ "$m" = /tmp ] && message INFO stor003i "Make /tmp a tmpfs of its own ('systemctl enable tmp.mount' where systemd ships it, or a tmpfs line in /etc/fstab) with nosuid,nodev,noexec." "/tmp is not a file system of its own (neither /etc/fstab nor systemd's tmp.mount makes it one), so it cannot be mounted nosuid, nodev or noexec on its own."
        continue
      fi
      missing=
      for want in nosuid nodev
      do
        case ",$o," in *",$want,"*) ;; *) missing="$missing,$want" ;; esac
      done
      [ -n "$missing" ] && message WARN stor001w "Mounted with $o, by $src. Add ${missing#,} to its options." "$m is mounted without ${missing#,}: anyone may leave files there, and ${missing#,} is what stops them being setuid programs or device files."
      case ",$o," in
        *,noexec,*) ;;
        *) message INFO stor002i "Mounted with $o, by $src. Adding noexec stops programs being run from it directly; some software (installers, JIT runtimes) expects to." "$m is mounted without noexec." ;;
      esac
    done
    # The other mount points, as fstab mounts them (/dev and /run are
    # systemd's, and are not in any fstab; they are judged live)
    table=$entries where=", by /etc/fstab"
    storage_mounts

    # Encryption: crypttab's devices. Swap is reported when the system
    # encrypts something and a swap partition is a raw device, not a
    # mapping crypttab makes (a swap file lives in whatever file system
    # holds it; a UUID or LABEL cannot be told apart here).
    if [ -z "$crypted" ]; then
      echo "$entries" | $AWK '$2 == "/" { f = 1 } END { exit !f }' &&
        message INFO stor009i "" "/etc/crypttab names no encrypted device: unless its disks are encrypted another way (ZFS, a self-encrypting drive), whoever has them has the data."
    else
      echo "$entries" | $AWK '$3 == "swap" { print $1 }' | while read sw
      do
        case "$sw" in
          /dev/mapper/*) echo "$crypted" | $GREP -qxF -e "${sw#/dev/mapper/}" && continue ;;
          /dev/zram*|UUID=*|LABEL=*|PARTUUID=*|PARTLABEL=*|/dev/disk/by-uuid/*) continue ;;
          /dev/*) ;;
          *) continue ;;
        esac
        message WARN stor006w "Swap: $sw. Put it on LUKS too (or a crypttab entry with a random key, for swap that need not survive a reboot)." "Disks are encrypted (/etc/crypttab) but swap is not: what the kernel swaps out of memory, passwords and keys among it, is written to the disk in clear."
      done
    fi
  fi

  # Core dumps: the core_pattern it sets at boot, the kernel's "core"
  # when nothing does
  SYSCTL_CONF=$WORKDIR/sysctl.conf.$$
  safe_temp $SYSCTL_CONF
  trap 'delete $SYSCTL_CONF; exit 1' 1 2 3 15
  sysctl_configured > $SYSCTL_CONF
  pattern=`sysctl_value kernel.core_pattern | $AWK -F'\t' '{ print $1 }'`
  delete $SYSCTL_CONF
  if [ -n "$pattern" ]; then where="set by its sysctl.d"; else pattern=core where="the kernel's default: nothing in its sysctl.d sets it"; fi
  case "$pattern" in
    '|'*systemd-coredump*) coredump_judge ;;
    '|'*) ;;
    *) core_limited || message WARN stor007w "kernel.core_pattern is \"$pattern\" ($where). Add '* hard core 0' to /etc/security/limits.conf, or install systemd-coredump, which keeps them where only root reads them." "A program that crashes writes its memory to a core file beside it, passwords and keys included, and nothing limits that." ;;
  esac

  if [ "$Tigris_Storage_NoUSB" = Y ]; then
    usb_blocked || usb_auth_default || message WARN stor008w "Add 'install usb-storage /bin/false' and 'blacklist usb-storage' to a file in /etc/modprobe.d (and uas likewise), then rebuild the initramfs." "USB storage can be used, and the policy (Tigris_Storage_NoUSB) is to have none."
  fi
  if [ "$Tigris_Storage_NoFireWire" = Y ]; then
    firewire_blocked || message WARN stor010w "Add 'install firewire-core /bin/false' and 'blacklist firewire-core' to a file in /etc/modprobe.d (and firewire-ohci likewise), then rebuild the initramfs." "FireWire can be used, and the policy (Tigris_Storage_NoFireWire) is to have none: a device on the bus reads and writes memory directly."
  fi
  storage_usbguard
  storage_second
  exit 0
fi

mounts=`$CAT "$root/proc/mounts" 2>/dev/null`
[ -n "$mounts" ] || exit 0
# A container's file systems are its host's business
[ -f "$root/.dockerenv" ] || [ -f "$root/run/.containerenv" ] || [ -f "$root/run/systemd/container" ] && exit 0
case "`echo "$mounts" | $AWK '$2 == "/" { t = $3 } END { print t }'`" in overlay|aufs) exit 0 ;; esac

echo
echo "# Checking mount options, disk encryption and core dumps..."

table=$mounts where=

#
# The world-writable file systems: nosuid and nodev, and noexec
#
for m in /tmp /dev/shm /var/tmp
do
  o=`opts $m`
  if [ -z "$o" ]; then
    [ "$m" = /tmp ] && message INFO stor003i "Make /tmp a tmpfs of its own ('systemctl enable tmp.mount' where systemd ships it, or a tmpfs line in /etc/fstab) with nosuid,nodev,noexec." "/tmp is part of the root file system, so it cannot be mounted nosuid, nodev or noexec on its own."
    continue
  fi
  missing=
  for want in nosuid nodev
  do
    case ",$o," in *",$want,"*) ;; *) missing="$missing,$want" ;; esac
  done
  [ -n "$missing" ] && message WARN stor001w "Mounted with $o. Add ${missing#,} to its options (in /etc/fstab, or a drop-in for its .mount unit)." "$m is mounted without ${missing#,}: anyone may leave files there, and ${missing#,} is what stops them being setuid programs or device files."
  case ",$o," in
    *,noexec,*) ;;
    *) message INFO stor002i "Mounted with $o. Adding noexec stops programs being run from it directly; some software (installers, JIT runtimes) expects to." "$m is mounted without noexec." ;;
  esac
done
# The other mount points, as they are mounted now
storage_mounts

#
# Encryption
#
# crypt NAME: is the block device NAME, or one under it, a dm-crypt mapping
crypt()
{
  __b="$root/sys/class/block/$1"
  case "`$CAT "$__b/dm/uuid" 2>/dev/null`" in CRYPT-*) return 0 ;; esac
  for __s in `$LS "$__b/slaves" 2>/dev/null`
  do
    crypt "$__s" && return 0
  done
  return 1
}
# blk SOURCE: the block device a mount or swap source is, by name
blk()
{
  __t=`readlink -f "$root$1" 2>/dev/null`
  [ -n "$__t" ] || __t=$1
  echo "${__t##*/}"
}

# The local disk file systems, but /boot (which cannot be encrypted the
# usual way) and loop devices (snaps, images)
plain=
for line in `echo "$mounts" | $AWK '$1 ~ /^\/dev\// && $1 !~ /^\/dev\/loop/ && $2 !~ /^\/boot/ { print $1 "|" $2 }' | $AWK '!seen[$0]++'`
do
  src=${line%%|*} mnt=${line#*|}
  crypt "`blk "$src"`" || plain="$plain, $mnt ($src)"
done
plain=${plain#, }
portable=N
for p in "$root"/sys/class/power_supply/*
do
  [ "`$CAT "$p/type" 2>/dev/null`" = Battery ] || continue
  [ "`$CAT "$p/scope" 2>/dev/null`" = Device ] && continue
  portable=Y
done
if [ -n "$plain" ]; then
  if [ "$portable" = Y ]; then
    message WARN stor004w "Not encrypted: $plain. Encrypting means reinstalling onto LUKS (every installer offers it) or converting in place with cryptsetup reencrypt, after a backup." "This machine runs on a battery, so it can be carried off, and its disks are not encrypted: whoever has it has the data."
  else
    message INFO stor005i "Not encrypted: $plain." "Some local file systems are not encrypted: whoever has the disks has the data."
  fi
fi

# Swap: under an encrypted root, an unencrypted swap keeps what was in
# memory (keys, passwords) on the disk in clear
rootdev=`echo "$mounts" | $AWK '$2 == "/" { d = $1 } END { print d }'`
rootblk=`blk "$rootdev"`
if crypt "$rootblk"; then
  $AWK 'NR > 1 { print $1, $2 }' "$root/proc/swaps" 2>/dev/null | while read -r sw type
  do
    case "$sw" in /dev/zram*) continue ;; esac
    if [ "$type" = file ]; then
      # the file system the swap file is on
      dev=`printf '%s\n' "$mounts" | f="$sw" $AWK 'index(ENVIRON["f"], $2) == 1 && length($2) > l { l = length($2); d = $1 } END { print d }'`
    else
      dev=$sw
    fi
    crypt "`blk "$dev"`" || message WARN stor006w "Swap: $sw. Put it on LUKS too (or a crypttab entry with a random key, for swap that need not survive a reboot)." "The root file system is encrypted but swap is not: what the kernel swaps out of memory, passwords and keys among it, is written to the disk in clear."
  done
fi

#
# Core dumps
#
pattern=`$CAT "$root/proc/sys/kernel/core_pattern" 2>/dev/null`
case "$pattern" in
  '|'*systemd-coredump*) coredump_judge ;;
  ''|'|'*) ;;
  *)
    core_limited || message WARN stor007w "kernel.core_pattern is \"$pattern\". Add '* hard core 0' to /etc/security/limits.conf, or install systemd-coredump, which keeps them where only root reads them." "A program that crashes writes its memory to a core file beside it, passwords and keys included, and nothing limits that."
    ;;
esac

#
# USB storage, when the policy is to have none
#
if [ "$Tigris_Storage_NoUSB" = Y ]; then
  usb_blocked || usb_auth_default || message WARN stor008w "Add 'install usb-storage /bin/false' and 'blacklist usb-storage' to a file in /etc/modprobe.d (and uas likewise), then rebuild the initramfs." "USB storage can be used, and the policy (Tigris_Storage_NoUSB) is to have none."
  dev=`usb_storage_connected` && message WARN stor008w "Disconnect it; to keep storage off, blacklist usb-storage and uas in /etc/modprobe.d and rebuild the initramfs." "A USB storage device ('$dev') is connected, and the policy (Tigris_Storage_NoUSB) is to have none."
fi
if [ "$Tigris_Storage_NoFireWire" = Y ]; then
  firewire_blocked || message WARN stor010w "Add 'install firewire-core /bin/false' and 'blacklist firewire-core' to a file in /etc/modprobe.d (and firewire-ohci likewise), then rebuild the initramfs." "FireWire can be used, and the policy (Tigris_Storage_NoFireWire) is to have none: a device on the bus reads and writes memory directly."
fi
storage_usbguard
if usbguard_running; then
  rules=`usbguard_rules`
  nrules=0
  [ -n "$rules" ] && nrules=`$AWK '!/^[ \t]*#/ && /[^ \t]/ { n++ } END { print n + 0 }' "\`rootfile "$rules"\`" 2>/dev/null`
  if [ "$nrules" -gt 0 ]; then
    message INFO stor014i "" "USBGuard authorizes USB devices ($nrules rules in $rules)."
  else
    message INFO stor014i "" "USBGuard authorizes USB devices."
  fi
elif usbguard_conf; then
  message WARN stor015w "Start it ('systemctl enable --now usbguard') or remove the configuration." "USBGuard is configured but its daemon is not running: no authorization is enforced."
fi
storage_second

exit 0
