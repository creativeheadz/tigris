#
# deb_statoverride: files whose mode or owner differs from what
#                 dpkg-statoverride sets for them.
#
# 10/07/2026 atrimbitas - Initial version. dpkg records no mode or owner for
#                 the files it installs (dpkg --verify checks md5 sums
#                 only), so lin038w cannot be had on Debian. The one place
#                 it does record them is the override list, which packages
#                 (crontab, dbus-daemon-launch-helper, /etc/ssl/private)
#                 and administrators set: those entries are compared with
#                 the files. An entry whose file is gone is left alone.
#                 Tigris_Deb_StatOverride_Cmd replaces the dpkg-statoverride
#                 call, so the tests can feed a list of their own.
# 10/07/2026 atrimbitas - An offline root (--root): its own list, through
#                 --admindir, its files through rootfile, and the names of
#                 their owners from its passwd and group files.
#
# Tigris: offline
#
#-----------------------------------------------------------------------------
#
TigrisInstallDir='.'

#
# Set default base directory.
# Order or preference:
#      -B option
#      TIGERHOMEDIR environment variable
#      TigrisInstallDir installed location
#
basedir=${TIGERHOMEDIR:=$TigrisInstallDir}

for parm
do
   case $parm in
   -B) basedir=$2; break;;
   esac
done

#
# Verify that a config file exists there, and if it does
# source it.
#
[ ! -r $basedir/config ] && {
  echo "--ERROR-- [init002e] No 'config' file in \`$basedir'."
  exit 1
}

. $basedir/config

. $BASEDIR/initdefs

#
# If run in test mode (-t) this will verify that all required
# elements are set.
#
[ "$Tigris_TESTMODE" = 'Y' ] && {
  haveallcmds AWK SED || exit 1
  haveallfiles BASEDIR WORKDIR || exit 1

  echo "--CONFIG-- [init003c] $0: Configuration ok..."
  exit 0
}

#------------------------------------------------------------------------

haveallcmds AWK GREP SED || exit 1

so_cmd=${Tigris_Deb_StatOverride_Cmd:-}
if [ -z "$so_cmd" ]; then
  # dpkg-statoverride sits next to dpkg; without it there is nothing to read
  so=${DPKG%/*}/dpkg-statoverride
  [ -n "$DPKG" ] && [ -x "$so" ] || exit 0
  so_cmd="$so --list"
fi
# An offline root's overrides: its statoverride file, which holds what
# --list prints, found inside the root and read as text (the root's path
# went into the command line unquoted, so a link's target could add
# options, and dpkg-statoverride followed the root's links onto this host)
sofile=
[ -n "$TIGRIS_ROOT" ] && [ -z "$Tigris_Deb_StatOverride_Cmd" ] && {
  sofile=`rootfile /var/lib/dpkg/statoverride`
  [ -f "$sofile" ] || exit 0
}
stat=
for d in /usr/bin /bin
do
  [ -x "$d/stat" ] && { stat=$d/stat; break; }
done
[ -n "$stat" ] || exit 0

echo
echo "# Checking files against dpkg's mode and owner overrides (dpkg-statoverride)..."

# An offline root's owners are named by its own passwd and group files
pwfile= grfile=
[ -n "$TIGRIS_ROOT" ] && pwfile=`rootfile /etc/passwd` grfile=`rootfile /etc/group`
idname()
{
  __n=`$AWK -F: -v n="$2" '$3 == n { print $1; exit }' "$1" 2>/dev/null`
  echo "${__n:-$2}"
}

# Each entry is "user group mode path"; a user or group written "#N" is a
# number. The path is the rest of the line.
if [ -n "$sofile" ]; then $GREP -v '^[[:space:]]*$' "$sofile"; else $so_cmd; fi 2>/dev/null |
while read user group mode path
do
  [ -n "$path" ] || continue
  here=`rootfile "$path"`
  set -- `$stat -c '%u %g %a %U %G' "$here" 2>/dev/null`
  [ $# -eq 5 ] || continue
  uid=$1 gid=$2 have=$3 uname=$4 gname=$5
  [ -n "$pwfile" ] && uname=`idname "$pwfile" $uid` gname=`idname "$grfile" $gid`
  want=`echo "$mode" | $SED 's/^0*//'`
  [ -n "$want" ] || want=0
  ok=Y
  [ "$have" = "$want" ] || ok=N
  case "$user" in
    \#*) [ "#$uid" = "$user" ] || ok=N ;;
    *) [ "$uname" = "$user" ] || ok=N ;;
  esac
  case "$group" in
    \#*) [ "#$gid" = "$group" ] || ok=N ;;
    *) [ "$gname" = "$group" ] || ok=N ;;
  esac
  [ "$ok" = Y ] && continue
  # chown takes a number without the "#"
  message WARN lin039w "dpkg-statoverride sets $user:$group $mode; the file is $uname:$gname $have. To restore it: chown ${user#\#}:${group#\#} '$path' && chmod $mode '$path' (in that order: chown clears the setuid and setgid bits)." "\`$path' has a different mode or owner than dpkg-statoverride sets for it."
done

exit 0
