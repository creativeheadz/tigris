# 10/29/2026 - atrimbitas - A file's name is read as it is (IFS= read -r)
#              and given to dpkg -S with *, ?, [, ] and \ escaped, since
#              dpkg -S reads a pattern: a stray named /usr/bin/dif* or
#              /usr/bin/d\iff matched /usr/bin/diff and went unreported,
#              and one named "/usr/bin/diff " was reported as /usr/bin/diff.
# 10/29/2026 - atrimbitas - Only the names merged-/usr really aliases count
#              as one file: bin, sbin, lib, lib32, lib64, libo32 and libx32
#              where each links to the same directory under /usr. The dpkg
#              -S lookup tried the /bin name on any system, so on one not
#              merged a stray /usr/bin/su beside /bin/su passed as packaged.
#              The temporary files go after either lookup.
# 10/07/2026 - atrimbitas - Auditing an offline root (--root): its files and
#              its dpkg database (dpkg --admindir), its directories taken
#              only where they are directories of its own, not links.
# 10/04/2026 - atrimbitas - Support merged-/usr systems (Debian bug #1111306).
#              Test the directory itself for a symlink, since '/bin/' with
#              a trailing slash resolves the link and /lib then pulled in
#              all of /usr/lib. dpkg may record a file under /bin, /sbin or
#              /lib or under /usr, so both forms count as owned.
# 05/07/2006 - jfs - Skip directories that are symbolic links, this happens
#              with /usr/X11R6/bin as the latest Xorg package
#              versions just symlink this to /usr/bin/  (Debian bug #367931)
# 03/21/2005 - jfs - Remove uneeded {} (Debian bug #297889). Also redirect
#              find stderr to /dev/null
# 06/18/2004 - jfs - Made the dirlist variable so that directories which
#              do not exist are not checked for (Debian bug #254574)
#              Also fixed SED check so that only binary files (and not
#              directories) are included in the list which should slightly
#              improve performance.
# 09/19/2003 - jfs - Applied patch from Nicolas François  which enhances
#            speed by restricting the list of files to check to those that
#            will be, indeed, tested and improved DPKG dependancy.
#            Send FIND errors to /dev/null just in case some of the
#            directories do not exist.
# 08/08/2003 - jfs - Improved temporary file creation and removed RM dependancy.
# 08/08/2003 - jfs - Applied patch from Nicolas François. 
#              Instead of grepping each file all the files are appended to
#              a single file and removed a redundant check.
# 11/05/2002 - jfs - Changed from a 'for' statement to a 'find'
#
# TODO:
# - Consider if the the path '/bin/ /usr/bin/ /sbin/ /usr/sbin/
# /lib/ /usr/X11R6/bin/' should be customizable in tigris.conf.
# Also, the maxpath could be set in another option.
# - Consider the use of 'dlocate' which will be faster than DPKG. Notice
# however that it's priority "optional"
# dlocate could be faster
# DLOCATE=`command -v dlocate`
# DLOCATE=${DLOCATE:-$DPKG}
#
# Tigris: offline
#
#-----------------------------------------------------------------------------
TigrisInstallDir='.'


#
# Set default base directory.
# Order or preference:
#      -B option
#      TIGERHOMEDIR environment variable
#      TigrisInstallDir installed location
#
basedir=${TIGERHOMEDIR:=$TigrisInstallDir}

for parm
do
   case $parm in
   -B) basedir=$2; break;;
   esac
done

#
# Verify that a config file exists there, and if it does
# source it.
#
[ ! -r $basedir/config ] && {
  echo "--ERROR-- [init002e] No 'config' file in \`$basedir'."
  exit 1
}

. $basedir/config

. $BASEDIR/initdefs

#
# If run in test mode (-t) this will verify that all required
# elements are set.
#
[ "$Tigris_TESTMODE" = 'Y' ] && {
  haveallcmds AWK FIND GREP SED || exit 1
  if [ "$Tigris_DPKG_Optimize" = "N" ]
  then
  	haveallcmds DPKG || exit 1
  fi
  haveallfiles BASEDIR WORKDIR || exit 1
  haveallvars TESTLINK HOSTNAME
  
  message CONFIG init003c "" "$0: Configuration ok..."
  exit 0
}

#------------------------------------------------------------------------
echo
echo "# Checking installed files against packages..."

haveallcmds AWK FIND GREP SED || exit 1
if [ "$Tigris_DPKG_Optimize" = "N" ]
then
	haveallcmds DPKG || exit 1
fi

safe_temp $WORKDIR/dpkg-packages.list $WORKDIR/dpkg-diversions.list
trap 'delete $WORKDIR/dpkg-packages.list $WORKDIR/dpkg-diversions.list ; exit 1' 1 2 3 15

# The system audited: this one, or the offline root R and its database
R=$TIGRIS_ROOT
admindir=`rootfile /var/lib/dpkg`

# NOTE: /usr/lib cannot be added here since quite a lot of packages
# will compile stuff there on installation which will result in a 
# tremendous report...
dirlist="/bin/ /usr/bin/ /sbin/ /usr/sbin/ /lib/ /usr/X11R6/bin"
okdirs=""
# Before using dirlist we are going to determine which values are ok
for dir in $dirlist ; do
	if [ -d "$R$dir" ] && [ ! -L "$R${dir%/}" ] && [ "`rootfile ${dir%/}`" = "$R${dir%/}" ] ; then
		if [ -n "$okdirs" ] ; then
			okdirs="$dir $okdirs" 
		else
			okdirs=$dir
		fi
	fi
done
dirlist=$okdirs
if [ -z "$dirlist" ]; then
	message ERROR lin037e "" "None of the configured directories are available"
	exit 1
fi

# On merged-/usr systems /bin, /sbin, /lib and the other aliased
# directories are links to the same directories under /usr, and dpkg may
# have recorded a file under either name. Elsewhere they are different
# files, and a stray /usr/bin/su is not the packaged /bin/su.
aliased=""
for dir in bin sbin lib lib32 lib64 libo32 libx32 ; do
	if [ -L "$R/$dir" ] && [ "`rootfile /$dir`" -ef "`rootfile /usr/$dir`" ] ; then
		aliased="$aliased $dir"
	fi
done

# The files under them, by their path on the system audited
binfiles()
{
	# shellcheck disable=SC2086
	( cd "${R:-/}" && for dir in $dirlist ; do $FIND ".$dir" -type f ; done ) 2>/dev/null | $SED 's,^\.,,'
}

# We have two options here, use dpkg (non-optimal but on the safe side)
# or use grep (optimal but not on the safe side)
if [ "$Tigris_DPKG_Optimize" = "N" ]
then
        binfiles |
        # We are not using -maxdepth here, but we could...
        while IFS= read -r file
        do
                # dpkg -S takes a pattern: escape what it would expand
                case $file in
                *[][*?\\]*) pat=$(printf '%s\n' "$file" | $SED 's/[][*?\\]/\\&/g') ;;
                *) pat=$file ;;
                esac
                pack=`$DPKG --admindir="$admindir" -S "$pat" 2>/dev/null`
                # dpkg may list it by its aliased name, /bin/foo
                if [ "$pack" = "" ] ; then
                        for dir in $aliased ; do
                                case $file in
                                /usr/$dir/*)
                                        pack=`$DPKG --admindir="$admindir" -S "${pat#/usr}" 2>/dev/null` ;;
                                esac
                        done
                fi
                [ "$pack" = "" ] && {
                message WARN lin001w "" "File \`$file' does not belong to any package." 
                }
        done       
else
        # Alternative (optimal but not following standard way)
	seddirlist=`echo $dirlist | $SED -e 's/ /\\\\\|/g; s/\//\\\\\//g'`
	# Give files recorded under an aliased name, /bin/foo, their /usr name
	usrmerge=
	for dir in $aliased ; do
		usrmerge="$usrmerge -e s,^/$dir/,/usr/$dir/,"
	done
	$FIND "$admindir/info" -name "*.list" -type f -exec cat {} + |
        $SED -n $usrmerge -e "/^\($seddirlist\)/p" > $WORKDIR/dpkg-packages.list
	$SED -e '' $usrmerge "`rootfile /var/lib/dpkg/diversions`" > $WORKDIR/dpkg-diversions.list
        binfiles |
        # We are not using -maxdepth here, but we could...
        $GREP -x -F -v -f $WORKDIR/dpkg-packages.list |
        # To search for diversions
        $GREP -x -F -v -f $WORKDIR/dpkg-diversions.list |
        while IFS= read -r file
        do
          message WARN lin001w "" "File \`$file' does not belong to any package."
        done
fi
delete $WORKDIR/dpkg-packages.list $WORKDIR/dpkg-diversions.list

# Packages removed but not purged leave their configuration files
# behind: stale root-owned config a reinstall would trust again
status=`rootfile /var/lib/dpkg/status`
unexp=
if [ -f "$status" ]; then
  unexp=`$AWK '/^Package: / { p = $2 } /^Status: deinstall ok config-files$/ { print p }' "$status"`
fi
if [ -n "$unexp" ]; then
  n=`echo "$unexp" | $GREP -c .`
  trail=`echo $unexp | $SED 's/ /, /g'`
  message WARN lin042w "Purge them if the configuration is not wanted ('dpkg -P' purges all of them)." "$n packages are removed but not purged: $trail. Their configuration files remain and apply again on reinstall."
fi

exit 0
