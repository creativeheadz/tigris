# tigris-export - a run's report in another format
#
#   tigris-export -f sarif|csv [-o FILE] [-l LOGDIR] [REPORT.jsonl]
#
# Reads the JSON Lines report of a run and writes it as SARIF 2.1.0 (for
# code-scanning dashboards) or as CSV (for a spreadsheet). The checks know
# nothing of either format: both are made from the JSON, so they say what
# the JSON says. With no file, the most recent run in the log directory
# is taken.
#
#   -f   the format: sarif or csv
#   -o   write to FILE instead of standard output (written only when the
#        whole report converted)
#   -l   the log directory (default: ./log if it exists, else the
#        installed log directory)
#
# SARIF: ALERT and FAIL are errors, WARN warnings, INFO notes. An ERROR (a
# check that could not run) and a skipped check are not findings about the
# host: they are the invocation's notifications. An accepted finding
# (tigris-accept) is a suppressed result, its reason the justification.
# A result's location is the check that reported it, on the audited host.
#
# CSV: one row per finding record, RFC 4180 quoting, lines ending in LF.
# A field that starts with =, +, -, @, a tab or a carriage return gets a
# leading apostrophe, so that a spreadsheet does not run it as a formula.
#
# Exit status: 0 when the report was converted, 2 on error.
#
#-----------------------------------------------------------------------------
TigrisInstallDir="."
TigrisLogDir=""

# The JSON escapes every byte above 127 as \u00XX and the decoder turns each
# back into one byte. That only holds in the C locale.
LC_ALL=C
export LC_ALL

format=
out=
logdir=
while [ $# -gt 0 ]
do
  case "$1" in
    -f) [ $# -ge 2 ] || { echo "tigris-export: -f needs a format (sarif or csv)" >&2; exit 2; }
        format=$2; shift ;;
    -o) [ $# -ge 2 ] || { echo "tigris-export: -o needs a file" >&2; exit 2; }
        out=$2; shift ;;
    -l) [ $# -ge 2 ] || { echo "tigris-export: -l needs a directory" >&2; exit 2; }
        logdir=$2; shift ;;
    -h|--help) sed -n '18,45p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --) shift; break ;;
    -?*) echo "tigris-export: unknown option $1" >&2; exit 2 ;;
    *)  break ;;
  esac
  shift
done

case "$format" in
  sarif|csv) ;;
  '') echo "usage: tigris-export -f sarif|csv [-o FILE] [-l LOGDIR] [REPORT.jsonl]" >&2; exit 2 ;;
  *)  echo "tigris-export: unknown format $format (sarif or csv)" >&2; exit 2 ;;
esac
[ $# -le 1 ] || { echo "tigris-export: one report at a time" >&2; exit 2; }

if [ $# -eq 1 ]; then
  report=$1
else
  [ -n "$logdir" ] || { if [ -d ./log ]; then logdir=./log; else logdir=${TigrisLogDir:-/var/log/tiger}; fi; }
  # newest last, by name: the date stamp sorts
  report=
  for f in "$logdir"/security.report.*.jsonl
  do
    [ -f "$f" ] && report=$f
  done
  [ -n "$report" ] || { echo "tigris-export: no report in $logdir" >&2; exit 2; }
fi
[ -f "$report" ] && [ -r "$report" ] || { echo "tigris-export: cannot read $report" >&2; exit 2; }

# The rule descriptions come from the finding metadata, meta/ID, in the
# installed tree or beside this script. Without it the export still says
# everything the report says.
meta=
for d in "${TIGERHOMEDIR:-$TigrisInstallDir}" "`dirname "$0"`"
do
  [ -d "$d/meta" ] && [ -d "$d/systems" ] && { meta=$d/meta; break; }
done
[ -n "$meta" ] || [ "$format" != sarif ] ||
  echo "tigris-export: no meta directory found: the rules carry their ids and no descriptions" >&2

tmp=`mktemp "${TMPDIR:-/tmp}/tigris-export.XXXXXX"` || { echo "tigris-export: cannot make a temporary file" >&2; exit 2; }
trap 'rm -f "$tmp"' 0
trap 'exit 2' 1 2 15

# The format and the metadata directory go in through the environment,
# and the report through standard input: awk reads backslashes in a -v
# value as escapes, and a file operand with an = in it as an assignment.
TIGRIS_EXPORT_FORMAT=$format TIGRIS_EXPORT_META=$meta ${AWK:-awk} '
function complain(s) { print "tigris-export: " s | "cat 1>&2"; close("cat 1>&2") }
function hex(h,    v, i) {
  v = 0
  for (i = 1; i <= length(h); i++) v = v * 16 + index("0123456789abcdef", tolower(substr(h, i, 1))) - 1
  return v
}
function ishex4(h) { return (h ~ /^[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]$/) }

# The string that opens with the quote at s[p], raw: escapes kept. JEND is
# left just past its closing quote.
function jstr(s, p,    out, c, n, q, t) {
  t = substr(s, p + 1); q = index(t, "\"")
  if (q == 0) { JEND = length(s) + 1; return t }
  out = substr(t, 1, q - 1)
  if (index(out, "\\") == 0) { JEND = p + q + 1; return out }
  out = ""; n = length(t)
  for (q = 1; q <= n; q++) {
    c = substr(t, q, 1)
    if (c == "\\") { out = out c substr(t, q + 1, 1); q++ }
    else if (c == "\"") break
    else out = out c
  }
  JEND = p + q + 1
  return out
}
# The raw value of a string field of a record, "" when it has none. A key
# cannot be found inside another string: the quotes there are escaped.
function get(rec, key,    i) {
  i = index(rec, "\"" key "\":\"")
  if (i == 0) return ""
  return jstr(rec, i + length(key) + 3)
}

# --- strings for JSON --------------------------------------------------

# The bytes above 127 collected in pend[1..nb], as JSON escapes: a valid
# UTF-8 sequence is the character it spells (a surrogate pair above
# U+FFFF), any other byte stays the U+00XX the report made of it.
function bytes(    out, i, j, b, need, cp, good) {
  out = ""; i = 1
  while (i <= nb) {
    b = pend[i]; need = 0; cp = 0
    if (b >= 194 && b <= 223) { need = 1; cp = b - 192 }
    else if (b >= 224 && b <= 239) { need = 2; cp = b - 224 }
    else if (b >= 240 && b <= 244) { need = 3; cp = b - 240 }
    good = (need > 0 && i + need <= nb)
    for (j = 1; good && j <= need; j++) {
      if (pend[i + j] < 128 || pend[i + j] > 191) good = 0
      else cp = cp * 64 + pend[i + j] - 128
    }
    if (good && need == 2 && (cp < 2048 || (cp >= 55296 && cp <= 57343))) good = 0
    if (good && need == 3 && (cp < 65536 || cp > 1114111)) good = 0
    if (!good) { out = out sprintf("\\u%04x", b); i++; continue }
    if (cp < 65536) out = out sprintf("\\u%04x", cp)
    else { cp -= 65536; out = out sprintf("\\u%04x\\u%04x", 55296 + int(cp / 1024), 56320 + cp % 1024) }
    i += need + 1
  }
  nb = 0
  return out
}
# A raw string of the report as the inside of a JSON string that is valid
# whatever the report held: its escapes are kept as they are (never
# escaped twice), a backslash that starts none is escaped, a bare quote,
# control character or byte above 127 is escaped, and half a surrogate
# pair becomes U+FFFD.
function clean(s,    out, i, n, c, d, h, v, o) {
  if (index(s, "\\") == 0 && index(s, "\"") == 0 && s !~ /[^ -~]/) return s
  out = ""; n = length(s); nb = 0
  for (i = 1; i <= n; i++) {
    c = substr(s, i, 1)
    if (c == "\\") {
      d = substr(s, i + 1, 1)
      if (d == "u" && ishex4(h = substr(s, i + 2, 4))) {
        v = hex(h); i += 5
        if (v >= 128 && v <= 255) { pend[++nb] = v; continue }
        if (nb) out = out bytes()
        if (v >= 55296 && v <= 56319 && substr(s, i + 1, 2) == "\\u" && ishex4(h = substr(s, i + 3, 4)) && hex(h) >= 56320 && hex(h) <= 57343) {
          out = out sprintf("\\u%04x\\u%04x", v, hex(h)); i += 6
        }
        else if (v >= 55296 && v <= 57343) out = out "\\ufffd"
        else out = out sprintf("\\u%04x", v)
        continue
      }
      if (nb) out = out bytes()
      if (d != "" && index("\"\\/bfnrt", d) > 0) { out = out c d; i++ }
      else out = out "\\\\"
      continue
    }
    o = ord[c]
    if (o >= 128) { pend[++nb] = o; continue }
    if (nb) out = out bytes()
    if (c == "\"") out = out "\\\""
    else if (o < 32 || o == 127) out = out sprintf("\\u%04x", o)
    else out = out c
  }
  if (nb) out = out bytes()
  return out
}
# Plain text (a line of meta/ID) as the inside of a JSON string
function esc(s,    out, i, n, c, o) {
  if (index(s, "\\") == 0 && index(s, "\"") == 0 && s !~ /[^ -~]/) return s
  out = ""; n = length(s)
  for (i = 1; i <= n; i++) {
    c = substr(s, i, 1); o = ord[c]
    if (c == "\\") out = out "\\\\"
    else if (c == "\"") out = out "\\\""
    else if (c == "\n") out = out "\\n"
    else if (c == "\t") out = out "\\t"
    else if (o < 32 || o > 126) out = out sprintf("\\u%04x", o)
    else out = out c
  }
  return clean(out)
}

# --- strings for CSV ---------------------------------------------------

# A raw string decoded to the bytes it stood for. A newline and a tab are
# themselves; any other control character stays written out (\u001b), as
# tigris-diff shows it: it would drive the terminal or the program that
# reads the file. So does a character above U+00FF, which Tigris never
# writes: it has no byte.
function text(s,    out, i, n, c, h, v) {
  if (index(s, "\\") == 0) return s
  out = ""; n = length(s)
  for (i = 1; i <= n; i++) {
    c = substr(s, i, 1)
    if (c != "\\") { out = out c; continue }
    i++; c = substr(s, i, 1)
    if (c == "n") out = out "\n"
    else if (c == "t") out = out "\t"
    else if (c == "\"" || c == "\\" || c == "/") out = out c
    else if (c == "u" && ishex4(h = substr(s, i + 1, 4))) {
      v = hex(h)
      if (v == 9 || v == 10 || (v >= 32 && v <= 255 && v != 127)) out = out sprintf("%c", v)
      else out = out "\\u" h
      i += 4
    }
    else out = out "\\" c
  }
  return out
}
# One CSV field: no formula for the spreadsheet, quoted when it must be
function field(s) {
  if (s != "" && index("=+-@\t\r", substr(s, 1, 1)) > 0) s = "\047" s
  if (s ~ /[",\n\r]/) { gsub(/"/, "\"\"", s); s = "\"" s "\"" }
  return s
}

# --- the compliance controls -------------------------------------------

# The controls object of a finding ({"cis_v8":["5.4"],...}, obj starting
# at its brace), read once per id and written again from its parts, so
# that what goes out is well formed whatever came in: ctljson[id] for
# SARIF, ctltext[id] ("cis_v8 4.1, 5.4; nist_800_53 AC-17") for CSV.
function controls(id, obj,    p, k, v, items, titems, j, t) {
  p = 2; j = ""; t = ""
  while (substr(obj, p, 1) == "\"") {
    k = jstr(obj, p); p = JEND
    if (substr(obj, p, 2) != ":[") break
    p += 2; items = ""; titems = ""
    while (substr(obj, p, 1) == "\"") {
      v = jstr(obj, p); p = JEND
      items = items (items == "" ? "" : ",") "\"" clean(v) "\""
      titems = titems (titems == "" ? "" : ", ") text(v)
      if (substr(obj, p, 1) == ",") p++
    }
    if (substr(obj, p, 1) != "]") break
    p++
    j = j (j == "" ? "" : ",") "\"" clean(k) "\":[" items "]"
    t = t (t == "" ? "" : "; ") text(k) " " titems
    if (substr(obj, p, 1) == ",") p++
  }
  ctljson[id] = j; ctltext[id] = t
}

# --- SARIF -------------------------------------------------------------

function sarif_level(level) {
  if (level == "ALERT" || level == "FAIL" || level == "ERROR") return "error"
  if (level == "WARN" || level == "CONFIG") return "warning"
  if (level == "INFO") return "note"
  return "none"
}
# A fingerprint of what makes a finding the same finding from run to run
# (its level, id and message, as tigris-diff has it): two sums of the
# bytes, sixteen hex digits. Not cryptography; it keeps a dashboard from
# folding the hundred findings of one check into one alert.
function fingerprint(s,    i, n, a, b, o) {
  a = 5381; b = 40503; n = length(s)
  for (i = 1; i <= n; i++) {
    o = ord[substr(s, i, 1)]
    a = (a * 33 + o) % 4294967296
    b = (b * 131 + o + i) % 4294967291
  }
  return sprintf("%04x%04x%04x%04x", int(a / 65536), a % 65536, int(b / 65536), b % 65536)
}
# The check as a relative URI: anything but letters, digits, ., _ and -
# is percent-encoded
function uri(s,    out, i, n, c) {
  if (s == "") return "tigris"
  if (s !~ /[^A-Za-z0-9._-]/) return s
  out = ""; n = length(s)
  for (i = 1; i <= n; i++) {
    c = substr(s, i, 1)
    out = out (c ~ /[A-Za-z0-9._-]/ ? c : sprintf("%%%02X", ord[c]))
  }
  return out
}
# the first sentence of an explanation, as the website has it
function first(t,    s, i) {
  s = t; gsub(/\n/, " ", s); sub(/^ +/, "", s); gsub(/  +/, " ", s)
  if (match(s, /[.] /)) s = substr(s, 1, RSTART)
  if (length(s) > 120) { s = substr(s, 1, 120); i = 120; while (i > 60 && substr(s, i, 1) != " ") i--; s = substr(s, 1, i - 1) "..." }
  sub(/[:;,]$/, "", s)
  return s
}
# The rule of one finding id, from meta/ID when there is one. The id
# comes from the report, so it names a file only when it is letters and
# digits and nothing else.
function rule(id, level, category,    file, line, hd, k, v, f, txt, out, help, sev, props) {
  split("", f); txt = ""
  if (metadir != "" && id ~ /^[a-z0-9]+$/) {
    file = metadir "/" id; hd = 1
    while ((getline line < file) > 0) {
      if (hd && line == "") { hd = 0; continue }
      if (hd) { k = line; sub(/:.*/, "", k); v = line; sub(/^[^:]*: ?/, "", v); f[k] = v; continue }
      txt = txt line "\n"
    }
    close(file)
    sub(/\n+$/, "", txt)
  }
  out = "{\"id\":\"" clean(id) "\""
  if (txt != "") {
    out = out ",\"shortDescription\":{\"text\":\"" esc(first(txt)) "\"}"
    out = out ",\"fullDescription\":{\"text\":\"" esc(txt) "\"}"
    help = (("Fix" in f) && f["Fix"] != "" ? "Fix: " f["Fix"] "\n\n" : "") txt
    if (("References" in f) && f["References"] != "") help = help "\n\nReferences: " f["References"]
    out = out ",\"help\":{\"text\":\"" esc(help) "\"}"
    out = out ",\"helpUri\":\"" site "findings/" id ".html\""
  }
  # the level the id is usually reported at: the first of its Severity
  sev = level
  if (("Severity" in f) && f["Severity"] != "") { sev = f["Severity"]; sub(/[, ].*/, "", sev) }
  out = out ",\"defaultConfiguration\":{\"level\":\"" sarif_level(sev) "\"}"
  if (category == "" && ("Category" in f)) category = esc(f["Category"])
  props = "\"tags\":[\"security\"" (category == "" ? "" : ",\"" category "\"") "]"
  if (category != "") props = props ",\"category\":\"" category "\""
  if ((id in ctljson) && ctljson[id] != "") props = props ",\"controls\":{" ctljson[id] "}"
  return out ",\"properties\":{" props "}}"
}
function prop(name, value) { return (value == "" ? "" : ",\"" name "\":\"" clean(value) "\"") }
function istime(t) { return (t ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z$/) }
# Everything read since the last run record, as one SARIF run
function sarif_run(    i, tool, ver, sem, host, t, inv, props) {
  if (!inrun && nres == 0 && nnote == 0 && nconf == 0) return
  printf "%s", (nruns++ ? ",\n" : "")
  tool = get(run, "tool"); ver = get(run, "version"); host = get(run, "host")
  printf "{\"tool\":{\"driver\":{\"name\":\"%s\"", (tool == "" ? "tigris" : clean(tool))
  if (ver != "") {
    printf ",\"version\":\"%s\"", clean(ver)
    sem = ver; sub(/,.*/, "", sem)
    if (sem ~ /^[0-9]+[.][0-9]+[.][0-9]+$/) printf ",\"semanticVersion\":\"%s\"", sem
  }
  printf ",\"informationUri\":\"%s\",\"rules\":[", site
  for (i = 1; i <= nrules; i++) printf "%s\n%s", (i > 1 ? "," : ""), rule(ruleid[i], rulelevel[i], rulecat[i])
  printf "]}}"
  if (host != "" || get(run, "id") != "")
    printf ",\n\"automationDetails\":{\"id\":\"tigris/%s/%s\"}", clean(host), clean(get(run, "id"))
  # a report with no summary record was cut short
  inv = "\"executionSuccessful\":" (summary == "" ? "false" : "true")
  t = get(run, "start"); if (istime(t)) inv = inv ",\"startTimeUtc\":\"" t "\""
  t = get(summary, "end"); if (istime(t)) inv = inv ",\"endTimeUtc\":\"" t "\""
  if (host != "") inv = inv ",\"machine\":\"" clean(host) "\""
  printf ",\n\"invocations\":[{%s", inv
  if (nnote) {
    printf ",\"toolExecutionNotifications\":["
    for (i = 1; i <= nnote; i++) printf "%s\n%s", (i > 1 ? "," : ""), note[i]
    printf "]"
  }
  if (nconf) {
    printf ",\"toolConfigurationNotifications\":["
    for (i = 1; i <= nconf; i++) printf "%s\n%s", (i > 1 ? "," : ""), conf[i]
    printf "]"
  }
  printf "}]"
  props = prop("host", host) prop("os", get(run, "os")) prop("release", get(run, "release")) prop("arch", get(run, "arch"))
  props = props prop("config", get(run, "config")) prop("profile", get(run, "profile")) prop("root", get(run, "root")) prop("runId", get(run, "id"))
  if (index(run, "\"filesystem_scan\":false") > 0) props = props ",\"filesystemScan\":false"
  if (props != "") printf ",\n\"properties\":{%s}", substr(props, 2)
  printf ",\n\"results\":["
  for (i = 1; i <= nres; i++) printf "%s\n%s", (i > 1 ? "," : ""), res[i]
  printf "]}"
  # one run is done: forget it
  split("", res); split("", note); split("", conf); split("", ruleid); split("", rulelevel); split("", rulecat); split("", ruleno)
  nres = 0; nnote = 0; nconf = 0; nrules = 0; run = ""; summary = ""; inrun = 0
}
function sarif_finding(rec,    level, id, check, msg, detail, category, acc, a, r, loc, host) {
  level = get(rec, "level"); id = get(rec, "id"); check = get(rec, "check")
  msg = clean(get(rec, "message")); detail = get(rec, "detail")
  if (detail != "") msg = msg "\\n" clean(detail)
  category = clean(get(rec, "category"))
  a = index(rec, "\"accepted\":{"); acc = (a ? substr(rec, a) : "")
  if (level == "ERROR" || level == "CONFIG") {
    # not a finding about the host: the tool could not run a check, or
    # says something of its own configuration
    r = "{\"level\":\"" sarif_level(level) "\",\"message\":{\"text\":\"" msg "\"}"
    if (id != "") r = r ",\"descriptor\":{\"id\":\"" clean(id) "\"}"
    r = r ",\"properties\":{\"level\":\"" level "\"" prop("check", check) (acc == "" ? "" : prop("accepted", get(acc, "reason"))) "}}"
    if (level == "ERROR") note[++nnote] = r; else conf[++nconf] = r
    return
  }
  if (!(id in ruleno)) {
    ruleno[id] = nrules + 0; ruleid[++nrules] = id; rulelevel[nrules] = level; rulecat[nrules] = category
    if (!(id in ctljson)) { a = index(rec, "\"controls\":{"); if (a) controls(id, substr(rec, a + 11)) }
  }
  host = get(run, "host")
  loc = "{\"physicalLocation\":{\"artifactLocation\":{\"uri\":\"" uri(text(check)) "\"}}"
  if (check != "") loc = loc ",\"logicalLocations\":[{\"name\":\"" clean(check) "\",\"fullyQualifiedName\":\"" clean((host == "" ? "" : host "/") check) "\",\"kind\":\"module\"}]"
  r = "{\"ruleId\":\"" clean(id) "\",\"ruleIndex\":" ruleno[id] ",\"level\":\"" sarif_level(level) "\",\"message\":{\"text\":\"" msg "\"}"
  r = r ",\"locations\":[" loc "}]"
  r = r ",\"partialFingerprints\":{\"tigrisFinding/v1\":\"" fingerprint(level "\t" id "\t" get(rec, "message")) "\"}"
  if (acc != "") {
    r = r ",\"suppressions\":[{\"kind\":\"external\",\"justification\":\"" clean(get(acc, "reason")) "\""
    a = get(acc, "until")
    if (a != "" && a != "-") r = r ",\"properties\":{\"until\":\"" clean(a) "\"}"
    r = r "}]"
  }
  res[++nres] = r ",\"properties\":{\"level\":\"" clean(level) "\"" prop("check", check) "}}"
}
function sarif_skip(rec,    check, reason) {
  check = clean(get(rec, "check")); reason = clean(get(rec, "reason"))
  note[++nnote] = "{\"level\":\"note\",\"message\":{\"text\":\"" check " was skipped: " reason "\"},\"properties\":{\"skipped\":true,\"check\":\"" check "\",\"reason\":\"" reason "\"}}"
}

# --- CSV ---------------------------------------------------------------

function csv_finding(rec,    id, a, acc, until) {
  id = get(rec, "id")
  if (!(id in ctltext)) { ctltext[id] = ""; a = index(rec, "\"controls\":{"); if (a) controls(id, substr(rec, a + 11)) }
  a = index(rec, "\"accepted\":{"); acc = (a ? substr(rec, a) : "")
  until = (acc == "" ? "" : text(get(acc, "until"))); if (until == "-") until = ""
  printf "%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n", runhost, runid, runstart, \
    field(text(get(rec, "level"))), field(text(id)), field(text(get(rec, "category"))), field(text(get(rec, "check"))), \
    field(text(get(rec, "message"))), field(text(get(rec, "detail"))), \
    field(acc == "" ? "" : text(get(acc, "reason"))), field(until), field(ctltext[id])
}

BEGIN {
  fmt = ENVIRON["TIGRIS_EXPORT_FORMAT"]; metadir = ENVIRON["TIGRIS_EXPORT_META"]
  site = "https://creativeheadz.github.io/tigris/"
  for (i = 1; i < 256; i++) ord[sprintf("%c", i)] = i
  if (fmt == "csv") print "host,run,time,level,id,category,check,message,detail,accepted_reason,accepted_until,controls"
  else printf "{\"$schema\":\"https://json.schemastore.org/sarif-2.1.0.json\",\"version\":\"2.1.0\",\"runs\":[\n"
}
# a record is one line that opens an object and says its type first
substr($0, 1, 9) != "{\"type\":\"" { next }
{ type = get($0, "type") }
type == "run" {
  # the contract (doc/json-format.md): refuse a schema newer than the
  # one this was written for
  i = index($0, "\"schema\":")
  if (i && substr($0, i + 9) + 0 > 1) {
    complain("the report has schema " (substr($0, i + 9) + 0) "; this tigris-export reads schema 1")
    failed = 1; exit
  }
  if (fmt == "sarif") sarif_run()
  run = $0; inrun = 1; seen = 1
  runhost = field(text(get(run, "host"))); runid = field(text(get(run, "id"))); runstart = field(text(get(run, "start")))
