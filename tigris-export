}
type == "finding" { seen = 1; if (fmt == "csv") csv_finding($0); else sarif_finding($0); next }
type == "skip"    { if (fmt == "sarif") sarif_skip($0); next }
type == "summary" { summary = $0; next }
END {
  if (failed) exit 2
  if (!seen) { complain("no run and no finding in the report: not a Tigris JSON Lines report?"); exit 2 }
