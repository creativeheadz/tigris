st=$?
[ $st -eq 0 ] || { [ $st -eq 2 ] || echo "tigris-export: awk failed ($st)" >&2; exit 2; }

if [ -n "$out" ]; then
  cat "$tmp" > "$out" || { echo "tigris-export: cannot write $out" >&2; exit 2; }
else
  cat "$tmp"
fi
exit 0
