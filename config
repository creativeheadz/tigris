error_siggen()
{
  dir=$1
  file=$2
  tmpdir=$3
  echo "There is already a $file file in $tmpdir"
  echo "Please remove it and rerun Tiger"
  cd $dir
  exit 1
}

do_siggen()
{
  echo "  Generating new digital signatures for binaries"
  set X `$BASEDIR/util/gethostinfo` unknown unknown unknown
  OS=${OS:=$2}
  REV=${REV:=$3}
  ARCH=${ARCH:=$4}
  if [ ! -d "$BASEDIR/systems/$OS/$REV/$ARCH/" ] 
  then
        printf "Creating the directory $BASEDIR/systems/$OS/$REV/$ARCH/ where signatures will be stored..."
    	mkdir -p "$BASEDIR/systems/$OS/$REV/$ARCH/" || { echo "Cannot create directory '$BASEDIR/systems/$OS/$REV/$ARCH/'!" >&2; exit 1; }
	echo "...created"
  fi
# NOTE: I'm not sure it's ok to create the directory since
# if there are no config files in it or in it's parent the
# default might not apply
  PWD=`pwd`
  cd $WORKDIR
  if [ ! -f "signatures.$OS-$REV-$ARCH" ] 
  then
    printf "Generating and installing signatures..."
    $BASEDIR/util/mksig
    $BASEDIR/util/installsig "signatures.$OS-$REV-$ARCH"
    rm "signatures.$OS-$REV-$ARCH"
    echo "...done"
  else
    error_siggen "$PWD" "signatures.$OS-$REV-$ARCH" "$WORKDIR"
  fi
  if [ ! -f "file_access_list.$OS-$REV-$ARCH" ] 
  then
    printf "Generating and installing file access lists..."
    $BASEDIR/util/mkfilelst
    mv "file_access_list.$OS-$REV-$ARCH" $BASEDIR/systems/$OS/$REV/$ARCH/file_access_list || { echo "Cannot move files to '$BASEDIR/systems/$OS/$REV/$ARCH/'!" >&2; exit 1; }
    echo "...done"
  else
    error_siggen "$PWD" "file_access_list.$OS-$REV-$ARCH" "$WORKDIR"
  fi
  cd $PWD
  exit 0
}

do_usage()
{
echo "Tigris, version $TIGERVERSION"
echo "Usage: ./tigris [-vthqGSH] [-B dir] [-l dir] [-w dir] [-b dir] [-e|-E] [-c config] [--since run] [-A arch] [-O os] [-R release]"
echo ""
echo "       -v     Show the version, and who wrote TIGER and Tigris."
echo ""
echo "       -t     Run in test mode."
echo ""
echo "       -h     Show usage (this help)."
echo ""
echo "       -q     Print nothing while running. The report is still"
echo "              written; with --since, what changed is printed."
echo ""
echo "       -B name"
echo "              Specify  the directory where tiger is installed.  If"
echo "              not specified, '$BASEDIR' is used."
echo ""
echo "       -l name"
echo "              Specify the name of the directory where Tiger  will"
echo "              write  the  security  report.  This defaults to    "
echo "              '$LOGDIR'. The filename  of  the report will be of "
echo "              the form 'security.report.host-name.date.time.'    "
echo ""
echo "       -w name"
echo "              Specify a directory to  use  for  creating  scratch"
echo "              files.  This defaults to '$WORKDIR'."
echo ""
echo "       -b name"
echo "              Specify  the directory which contains (or will con-"
echo "              tain) the binaries generated from  the  C  modules."
echo "              If  the  systems  directories contain all the bina-"
echo "              ries, they will be used directly  from  there.   If"
echo "              not,  then  if  the  bindir  contains the binaries,"
echo "              these will be used.  If none are  found  in  either"
echo "              place,  then an attempt will be made to compile the"
echo "              C code and install the executables into the bindir."
echo ""
echo "       -c name"
echo "              Specify  an  alternate  name for the tigerrc control"
echo "              file.  The default is '$RCFILE'."
echo ""
echo "       --root dir"
echo "              Audit the system under dir, not the running one: a"
echo "              mounted disk, a container image's root filesystem, a"
echo "              VM snapshot. Files are read under dir with the"
echo "              host's own tools, and nothing under dir is run. Checks"
echo "              that need the running system, or cannot read an"
echo "              offline root yet, say they were skipped."
echo ""
echo "       -p name, --profile name"
echo "              Apply a profile on top of the tigerrc: its settings"
echo "              replace the tigerrc's. Profiles are files in the"
echo "              profiles directory beside the tigerrc, then in"
echo "              Tigris's own: quick (no filesystem scan), server,"
echo "              desktop and container."
echo ""
echo "       -e     This option will cause explanations to be  inserted"
echo "              into  the  security  report following each message."
echo "              This can greatly increase the size of  the  report,"
echo "              as explanations may appear repeatedly."
echo ""
echo "       -E     This  option  indicates that a separate explanation"
echo "              report should be  created,  with  explanations  for"
echo "              each  type  of  message  only  appearing once.  The"
echo "              filename of the explanation report will be  of  the"
echo "              form 'explain.report.hostname.date.time.'"
echo ""
echo "       -G     Generate the signatures (MD5 hashes and file permissions)"
echo "              for system binary files."
echo ""
echo "       -H     This option will format the report into HTML creat-"
echo "              ing local links to the problem descriptions."
echo ""
echo "       -S     This option indicates that a surface level check of"
echo "              the  configuration  files  of  any diskless clients"
echo "              served by this machine should  be  checked  at  the"
echo "              same  time.   The checks will not be as in depth as"
echo "              they would be if run on the client itself."
echo ""
echo "       --since run"
echo "              Compare this run with an earlier one and print only"
echo "              what is new and what was resolved (tigris-diff)."
echo "              The run is the .jsonl file of an earlier report, or"
echo "              'last' for the most recent one of this host in the"
echo "              log directory. The exit status then counts only the"
echo "              new findings. Cron: tigris -q --since last"
echo ""
echo "Exit status: 0 nothing at WARN or above; 1 the audit did not run"
echo "(usage or configuration error); 2 a check could not run (ERROR) and"
echo "nothing worse was found; 3 WARN, 4 FAIL, 5 ALERT is the worst"
echo "finding. Accepted findings (tigris-accept) do not count."
echo ""
echo "Overrides for values detected  by the configuration system:"
echo "       -A arch"
echo "              Specify  an  alternate  architecture for tiger"
echo ""
echo "       -O os"
echo "              Specify  an  alternate  operating system for tiger"
echo ""
echo "       -R release"
echo "              Specify  an  alternate  operating system release  "
echo "              for tiger"
echo ""
echo "Report bugs at https://github.com/creativeheadz/tigris/issues (see man tigris)"
}

checkfile()
{
  _rcfile=$1
  _rcpath=${2:=$1}
  _status=1
  
  if [ -d "$_rcfile" ]; then
    echo "--CONFIG-- [con001c] Ignoring config file $_rcpath, (directory)"
  elif [ -f "$_rcfile" ]; then
    _status=0
    _permit=`$LS $LSLINK -l "$_rcfile" |
             $AWK '{printf("%s%s", substr($1,6,1), substr($1,9,1));}'`
    [ "$_permit" != "--" ] && {
      echo "--CONFIG-- [con003c] Ignoring config file $_rcpath, (world and/or group writable)"
      _status=1
    }
    # A config file is run as shell code by whoever runs Tigris, root as a
    # rule, so it must be theirs, root's, or that of whoever owns Tigris
    # itself (whose code runs anyway). A ./site or ./tigerrc that another
    # user left in the directory Tigris was started from is not.
    [ $_status -eq 0 ] && {
      _owner=`$LS $LSLINK -nd "$_rcfile" | $AWK '{print $3}'`
      case " 0 `id -u` `$LS -nd "$BASEDIR" | $AWK '{print $3}'` " in
        *" $_owner "*) ;;
        *) echo "--CONFIG-- [con015c] Ignoring config file $_rcpath, (owned by uid $_owner, not by root, the user running Tigris or Tigris's owner)"
           _status=1 ;;
      esac
    }
  fi

  return $_status
}

[ "$CONFIGURED_ALREADY" != "YES" ] && {

  umask 077

  CONFIGURED_ALREADY=YES

  if [ -n "$TIGERHOMEDIR" -a "$TIGERHOMEDIR" != '.' ]; then
    BASEDIR="$TIGERHOMEDIR"
  elif [ -n "$TigerInstallDir" -a "$TigerInstallDir" != '.' ]; then
    BASEDIR="$TigerInstallDir"
  elif [ ! -d ./systems -a -d ../systems ]; then
    BASEDIR='..'
  else
    BASEDIR='.'
  fi

  LOGDIR=${TigerLogDir:=.}
  WORKDIR="$TigerWorkDir"
  RCFILE=${TigerConfigDir:=.}/tigerrc
  IGNORE_FILE=${TigerConfigDir:=.}/tiger.ignore
  ACCEPT_FILE=${TigerConfigDir:=.}/tigris.accepted
  TIGERHOMEDIR="$BASEDIR"
  EXPLAINREPORT=N
  SERVERCHECK=N
  Tiger_TESTMODE=N
  HTML=N
  export BASEDIR LOGDIR WORKDIR BINDIR EXPLAINREPORT SERVERCHECK 
  export TIGERHOMEDIR RCFILE IGNORE_FILE ACCEPT_FILE
  export Tiger_TESTMODE TigerCleanup HTML
  SINCE_RUN=
  PROFILE=
  # --root, or tigris run with TIGRIS_ROOT set (the tests run checks so)
  TIGRIS_ROOT=${TIGRIS_ROOT:-}
  doversion=0

  # the version first: the usage text below names it
  TIGERVERSION="`/bin/cat $TIGERHOMEDIR/version.h 2>/dev/null`"
  [ ! -n "$TIGERVERSION" ] && TIGERVERSION="undetermined"
  export TIGERVERSION

  while [ $# != 0 ]
  do
    case $1 in
     -v) doversion=1;;
     -h|--help) do_usage; exit 0;;
     -B) BASEDIR=$2; shift;;
     -l) LOGDIR=$2; shift
         case "$LOGDIR" in @*)
           echo "--ERROR-- [con017e] -l @host, the telnet logger, is gone (it sent the report in clear, and its test was inverted so it never ran); -l takes a directory."
           exit 1 ;;
         esac ;;
     -w) WORKDIR=$2; shift;;
     -b) BINDIR=$2; shift;;
     -c) RCFILE=$2; RCFILE_GIVEN=Y; shift;;
     --root)
        [ $# -ge 2 ] || { echo "--ERROR-- [con014e] --root needs the directory to audit."; exit 1; }
        TIGRIS_ROOT=$2; shift;;
     -p|--profile)
        [ $# -ge 2 ] || { echo "--ERROR-- [con013e] $1 needs the name of a profile: quick, server, desktop, container."; exit 1; }
        PROFILE=$2; shift;;
     -e) EXPLAINREPORT=I;;
     -E) EXPLAINREPORT=Y;;
     -G) do_siggen;;
     -S) SERVERCHECK=Y;;
     -O) OS=$2; shift;;
     -A) ARCH=$2; shift;;
     -R) REV=$2; shift;;
     -t) Tiger_TESTMODE=Y;;
     -H) HTML=Y;;
     -q) QUIET=Y;;
     --since)
        [ $# -ge 2 ] || { echo "--ERROR-- [con012e] --since needs the run to compare with: a .jsonl report, or 'last'."; exit 1; }
        SINCE_RUN=$2; shift;;
      *) echo "--ERROR-- [con006e] Unknown option $1"; do_usage; exit 1;;
    esac
    shift;
  done

  # --root: the directory audited instead of the running system, as an
  # absolute path; / is the running system after all
  [ -n "$TIGRIS_ROOT" ] && {
    if [ ! -d "$TIGRIS_ROOT/etc" ]; then
      echo "--ERROR-- [con014e] $TIGRIS_ROOT is not the root of a system to audit: it has no etc directory."
      exit 1
    fi
    TIGRIS_ROOT=`cd "$TIGRIS_ROOT" && pwd -P`
    # The checks pass it to commands unquoted, and apt reads it quoted
    case "$TIGRIS_ROOT" in
      *[!A-Za-z0-9/._+@:,=-]*)
        echo "--ERROR-- [con014e] $TIGRIS_ROOT is not a path --root can take: only letters, digits and / . _ + @ : , = - (mount or link the system somewhere that is)."
        exit 1 ;;
    esac
    [ "$TIGRIS_ROOT" = / ] && TIGRIS_ROOT=
  }
  export TIGRIS_ROOT

  [ $doversion -eq 1 ] && {
    echo "Tigris, version $TIGERVERSION"
    echo "   Based on Tiger, developed by Texas A&M University, 1993-1994"
    echo "   Updated by the Advanced Research Corporation, 1999-2002"
    echo "   Maintained by Javier Fernandez-Sanguino, 2001-2019"
    echo "   Contributions by Francisco Manuel Garcia Claramonte, 2009-2010"
    echo "   Continued as Tigris by Andrei Trimbitas, 2026"
    echo "   Covered by the GNU General Public License, version 2 or later"
    exit 0
  }

  if [ -z "$WORKDIR" ] ; then
	  WORKDIR=${TMPDIR:=/tmp}
	  ( umask 077; mkdir $WORKDIR/tiger.$$ ) || { echo "$0: Cannot create temporary directory" >&2; exit 1; }
	  WORKDIR="$WORKDIR/tiger.$$"
  fi
  # TODO: WORKDIR should be removed on exit if it is located in a temporary 
  # directory
  if [ ! -d "$WORKDIR" ] ; then
         # Complain if the workingdirectory is not located in
         # a temporary location and it does not exist
          case "$WORKDIR" in
            /var/run/* | /tmp* | /var/tmp/* ) ;;
            *) echo "Configured working directory $WORKDIR does not exist" >&2 ;;
          esac
  	  if [ "$QUIET" != "Y" ] ; then
	  	echo "Creating working directory $WORKDIR"
		echo
	  fi
          # Try to create it...
	  # TODO: -p switch is not portable
  	  if ! mkdir -p "$WORKDIR" >/dev/null 2>&1; then
	  	  echo "Configured working directory $WORKDIR cannot be created (should you use -w?)" >&2
		  exit 1
	  fi
          # From here on we should have a working WORKDIR
  fi

  # Create the log directory too
  if [ ! -d "$LOGDIR" ] ; then
    [ "$QUIET" != "Y" ] && echo "Creating log directory $LOGDIR"
    if ! ( umask 077; mkdir -p "$LOGDIR" ) >/dev/null 2>&1; then
      echo "Configured log directory $LOGDIR cannot be created (should you use -l?)" >&2
      exit 1
    fi
  fi

  # Both must be the runner's alone: files are created in them under
  # names others could guess, and a link planted there by someone else
  # would be followed, as root. Owned by root, the runner or the user who
  # invoked sudo (a checkout), and writable by nobody else.
  # Inside a container (the image's documented use mounts a directory of
  # the host user's on /opt/tigris/log) the directory is the host user's,
  # with the host user's modes, and nobody else runs there: said, and
  # allowed.
  __incontainer=
  [ -f /.dockerenv ] || [ -f /run/.containerenv ] || [ -f /run/systemd/container ] && __incontainer=Y
  for __dir in "$WORKDIR" "$LOGDIR"
  do
    __dls=`ls -ldn "$__dir" 2>/dev/null`
    __downer=`echo "$__dls" | awk '{ print $3 }'`; __dmode=`echo "$__dls" | awk '{ print $1 }'`
    __dwhy=
    case "$__dmode" in
      ?????w*|????????w*) __dwhy="is writable by its group or by others" ;;
    esac
    case " 0 `id -u` ${SUDO_UID:-0} " in
      *" ${__downer:-?} "*) ;;
      *) __dwhy="${__dwhy:+$__dwhy, and }is owned by uid ${__downer:-?}, not by root, the user running Tigris or the user who invoked sudo" ;;
    esac
    [ -n "$__dwhy" ] || continue
    if [ -n "$__incontainer" ]; then
      [ "$QUIET" != "Y" ] && echo "--CONFIG-- [con019c] The directory $__dir $__dwhy; inside a container that is the host user's, so Tigris writes there."
    else
      echo "--ERROR-- [con018e] The directory $__dir $__dwhy: Tigris does not write there (chown it to root or yourself, chmod 700)."
      exit 1
    fi
  done


  # Which configuration was picked is said in test mode (-t); a normal
  # run's first line names the system instead (tiger's banner)
  [ "$Tiger_TESTMODE" = Y ] && echo "Configuring..."

  set X `$BASEDIR/util/gethostinfo` unknown unknown unknown
  OS=${OS:=$2}
  REV=${REV:=$3}
  ARCH=${ARCH:=$4}
  saveifs=$IFS
  IFS=.
  set X $REV
  IFS=$saveifs
  shift
  REL="$1"
  [ ! -n "$REL" ] && REL=$REV

  [ ! -n "$BINDIR" ] &&  eval BINDIR=${TigerBinDir:=$BASEDIR/bin}

  SCRIPTDIR=$BASEDIR/scripts
  export SCRIPTDIR

  [ "$Tiger_TESTMODE" = Y ] &&  {
    echo " "
    echo "Will try to check using config for '$ARCH' running $OS $REV..."
  }

  CONFIG_LOC=${TIGERCONF:="$BASEDIR/systems"}

  if [ -f "$CONFIG_LOC/$OS/$REL/$REV/$ARCH/config" ]; then
    [ "$Tiger_TESTMODE" = Y ] && echo "--CONFIG-- [con004c] Using configuration files for $OS $REV $ARCH."
    CONFIG_DIR="$CONFIG_LOC/$OS/$REL/$REV/$ARCH"
  elif [ -f "$CONFIG_LOC/$OS/$REL/$REV/config" ]; then
    [ "$Tiger_TESTMODE" = Y ] && echo "--CONFIG-- [con004c] Using configuration files for $OS $REV."
    CONFIG_DIR="$CONFIG_LOC/$OS/$REL/$REV"
  elif [ -f "$CONFIG_LOC/$OS/$REL/config" ]; then
    [ "$Tiger_TESTMODE" = Y ] &&  {
    echo "--CONFIG-- [con005c] Using configuration files for $OS $REV. Using"
    echo "           configuration files for generic $OS $REL."
    }
    CONFIG_DIR="$CONFIG_LOC/$OS/$REL"
  elif [ -f "$CONFIG_LOC/$OS/default/config" ]; then
    [ "$Tiger_TESTMODE" = Y ] &&  {
    echo "--CONFIG-- [con005c] Using default configuration files for $OS. Using"
    echo "           configuration files for generic $OS"
    }
    CONFIG_DIR="$CONFIG_LOC/$OS/default"
    # run_script looks for the system-specific checks under $OS/$REL, so
    # send it to default as well; otherwise a new major release (kernel 7
    # with symlinks up to 6) silently gets the generic checks instead
    REL=default
  elif [ -f "$CONFIG_LOC/$OS/config" ]; then
    [ "$QUIET" != "Y" ] &&  {
    echo "--CONFIG-- [con005c] No configuration files for $OS $REV.  Using"
    echo "           configuration files for generic $OS."
    }
    CONFIG_DIR="$CONFIG_LOC/$OS"
  elif [ -f "$CONFIG_LOC/default/config" ]; then
    [ "$QUIET" != "Y" ] &&  {
    echo "--CONFIG-- [con007c] No configuration files for $OS.  Using default"
    echo "           configuration files.  Not all checks may be performed."
    }
    CONFIG_DIR="$CONFIG_LOC/default"
  else
    echo "--ERROR-- [con008e] No configuration files for $OS $REV and can't find the"
    echo "          default configuration files.  Terminating."
    exit 1
  fi
  CONFIG_FILE="$CONFIG_DIR/config"

  . $CONFIG_FILE

  [ ! -n "$TESTEXEC" ] && TESTEXEC="-f"
  [ ! -n "$TESTLINK" ] && TESTLINK="-h"

  OUTPUTMETHOD="$CAT"
  [ "$EXPLAINREPORT" != "N" ] && {
    OUTPUTMETHOD="$BASEDIR/tigexp -F"
  }
  export OUTPUTMETHOD
  
  #
  # If RCFILE is not defined consider using some sane defaults  
  #
  # The preset ($TigerConfigDir/tigerrc) and a file given with -c get the
  # check every configuration file gets (not writable by group or others,
  # owned by root, the user running Tigris or Tigris's owner): until
  # October 2026 only the search below did, and the preset meant it never
  # ran. A preset that fails is skipped for the search; a -c file that
  # fails stops the run (below).
  rcrejected=
  [ -n "$RCFILE" ] && [ "$RCFILE_GIVEN" != Y ] && [ -e "$RCFILE" ] && ! checkfile "$RCFILE" "$RCFILE" && {
    rcrejected=$RCFILE
    RCFILE=
  }
  [ ! -n "$RCFILE" ] && {
    for file in '/etc/tiger/tigerrc' '/usr/local/etc/tigerrc' './.tigerrc' './tigerrc' '$BASEDIR/tigerrc' '$HOME/.tigerrc' 
  # TODO: Check with ARSC if there is a preference on their behalf
  # for this ordering since Tara 3.0.3 uses
  # for file in './.tigerrc' './tigerrc' '$HOME/.tigerrc' '$BASEDIR/tigerrc'
    do
      eval rc=$file
      # the rejected preset again, under another name: said once
      [ -n "$rcrejected" ] && [ "$rc" -ef "$rcrejected" ] && continue
      if checkfile "$rc" "$file"; then
	RCFILE=$rc
	break
      fi
    done
  }

  # A tigerrc named with -c is sourced as root like a found one, so it
  # gets the same check (not writable by group or others, owned by root,
  # the user running Tigris or Tigris's owner); unlike a found one there
  # is nothing to fall back to, so a file that fails it stops the run
  # (every check would run otherwise, which is not what -c asked for)
  [ "$RCFILE_GIVEN" = Y ] && [ -e "$RCFILE" ] && ! checkfile "$RCFILE" "$RCFILE" && {
    echo "--ERROR-- [con016e] The configuration file $RCFILE given with -c was not read (see above); nothing runs without it."
    exit 1
  }

  [ -n "$RCFILE" ] && [ ! -r "$RCFILE" ] && {
    echo "Control file $RCFILE not defined or not readable... exiting..."
    exit 1
  }

  #
  # Preprocess the RC file, to export variables to environment (quoted
  # throughout: a path with a space failed the test unquoted, and the
  # tigerrc was then silently not read, so every check ran)
  #

  [ -n "$RCFILE" ] && [ -r "$RCFILE" ] && {
    tempfile=`mktemp "$WORKDIR/rcfile.XXXXXX" 2>/dev/null` || tempfile=$WORKDIR/rcfile.$$
    $GREP -v '^#' "$RCFILE" |
    $SED -e 's/^\(.*\)=/export \1; \1=/' > $tempfile
    . $tempfile
    $RM -f $tempfile
  }

  #
  # A profile, read the same way after the tigerrc, so its settings win:
  # the site's (profiles beside the tigerrc) before Tigris's own
  #
  [ -n "$PROFILE" ] && {
    case "$PROFILE" in
      *[!a-z0-9_-]*) echo "--ERROR-- [con013e] There is no profile '$PROFILE': a profile's name is letters, digits, - and _."; exit 1 ;;
    esac
    pfile=
    case "$RCFILE" in */*) rcdir=${RCFILE%/*} ;; *) rcdir=. ;; esac
    for dir in "$rcdir/profiles" "$BASEDIR/profiles"
    do
      [ -f "$dir/$PROFILE" ] && checkfile "$dir/$PROFILE" "$dir/$PROFILE" && { pfile="$dir/$PROFILE"; break; }
    done
    [ -n "$pfile" ] || { echo "--ERROR-- [con013e] There is no profile '$PROFILE' (in $rcdir/profiles or $BASEDIR/profiles)."; exit 1; }
    tempfile=`mktemp "$WORKDIR/rcfile.XXXXXX" 2>/dev/null` || tempfile=$WORKDIR/rcfile.$$
    $GREP -v '^#' "$pfile" |
    $SED -e 's/^\(.*\)=/export \1; \1=/' > $tempfile
    . $tempfile
    $RM -f $tempfile
    export PROFILE
  }

  HOSTNAME=`$GETHOSTNAME`
  if [ "$Tiger_Output_FQDN" = 'Y' -a "$OS" = "Linux" ]
  then
  # Linux hostname has the -f option for FQDN... (jfs)
  # (others?)
	  HOSTNAME=`$GETHOSTNAME -f 2>/dev/null`
# But sometimes this will fail.... (if the system is not properly setup)
	  [ $? -ne 0 ] && HOSTNAME=`$GETHOSTNAME`
  fi

  for file in './site-$HOSTNAME' '$BASEDIR/site-$HOSTNAME' './site' '$BASEDIR/site'
  do
    eval rc=$file
    if checkfile $rc $file; then
      SITECONFIG=$rc
      break
    fi
  done

  [ -n "$SITECONFIG" -a -r "$SITECONFIG" ] && 
  {
    $GREP -v '^#' $SITECONFIG |
    $SED -e 's/^\(.*\)=/export \1; \1=/' > $WORKDIR/sitefile.$$
    . $WORKDIR/sitefile.$$
    $RM -f $WORKDIR/sitefile.$$
  }

  # The acceptance and ignore files decide what the report leaves out, so
  # they get the check a tigerrc gets (not writable by group or others,
  # owned by root, the runner or Tigris's owner); one that fails is not
  # read, and checkfile has said so
  [ -n "$ACCEPT_FILE" ] && [ -e "$ACCEPT_FILE" ] && ! checkfile "$ACCEPT_FILE" "$ACCEPT_FILE" && ACCEPT_FILE=
  [ -n "$IGNORE_FILE" ] && [ -e "$IGNORE_FILE" ] && ! checkfile "$IGNORE_FILE" "$IGNORE_FILE" && IGNORE_FILE=

  HOSTNAMESLIST=${HOSTNAMESLIST:=$HOSTNAME}

  export CONFIGURED_ALREADY OS REL REV ARCH HOSTNAME
  export CONFIG_DIR CONFIG_FILE HOSTNAMESLIST

  [ "$TigerNoBuild" != 'Y' ] && {
    > $WORKDIR/tigercmds.$$
    $BASEDIR/util/buildbins $WORKDIR/tigercmds.$$
    . $WORKDIR/tigercmds.$$
    $RM -f $WORKDIR/tigercmds.$$
  }

  # set the PATH 
  PATH=/sbin:/usr/sbin:/bin:/usr/bin
  export PATH
}
