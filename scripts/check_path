# check_path  - 06/14/93
#
# 10/07/2026 atrimbitas  A user's PATH directory owned by someone else or
#                 writable by others is path011 or path012 with the level's
#                 letter (pathmsg adds it); it was path006 and path007,
#                 whose w forms meant other things in older versions.
# 05/02/2004 jfs  Try to avoid eval problems if handling variables with
#                 special characters (such as space)
# 10/07/2003 jfs Redirected LS error to /dev/null since dangling symlinks
#                will print errors. Properly cleaned temporary file.
# 09/19/2003 jfs Use -L to check properly for symlinks (I've checked and
#                its supported by all the LS implementations I've seen)
#                (Fixes Debian Bug #161993)
# 08/14/2003 jfs Added OUTPUTMETHOD to dependancies
# 08/13/2003 jfs Return if the files do not exist (a safeguard for the
#                functions but these is redundant code anyway)
# 08/08/2003 jfs Improved temporary file creation.
# 10/22/2002 jfs Fixed check for PATH in config files (was not done properly
#            due to the way it was being tested)
# 07/25/2002 jfs Added a sanity check for password files
# ARC check_path - 05/10/99  Fixed problem with parse_csh
#
#
# Tigris: offline
#   every account's PATH from its dot files inside the root, and the
#   directories and commands on it, owners named from the root's passwd.
#
#-----------------------------------------------------------------------------
#
TigrisInstallDir="."

#
# Set default base directory.
# Order or preference:
#      -B option
#      TIGERHOMEDIR environment variable
#      TigrisInstallDir installed location
#
basedir=${TIGERHOMEDIR:=$TigrisInstallDir}

for parm
do
   case $parm in
   -B) basedir=$2; break;;
   esac
done

#
# Verify that a config file exists there, and if it does
# source it.
#
[ ! -r $basedir/config ] && {
  echo "--ERROR-- [init002e] No 'config' file in \`$basedir'."
  exit 1
}

. $basedir/config

. $BASEDIR/initdefs
#
# If run in test mode (-t) this will verify that all required
# elements are set.
#
[ "$Tigris_TESTMODE" = 'Y' ] && {
  haveallcmds AWK GEN_PASSWD_SETS GREP JOIN RM SED TR OUTPUTMETHOD || exit 1
  haveallfiles BASEDIR WORKDIR || exit 1
  haveallvars HOSTNAME || exit 1
  
  echo "--CONFIG-- [init003c] $0: Configuration ok..."
  exit 0
}

#------------------------------------------------------------------------

echo
echo "# Performing check of PATH components..."

haveallcmds AWK GEN_PASSWD_SETS GREP JOIN RM SED TR OUTPUTMETHOD || exit 1
haveallfiles BASEDIR WORKDIR || exit 1

safe_temp $WORKDIR/pth.$$
trap 'delete $WORKDIR/pth.$$ ; exit 1' 1 2 3 15

checkcmds()
{
  _user="$1"
  _dir="$2"
  _srcfile="$3"

  okown=$Tigris_ROOT_PATH_OK_Owners
  [ "$_user" != 'root' ] && okown=$Tigris_PATH_OK_Owners
  [ ! -n "$okown" ] && okown='root'

  okgroup=$Tigris_ROOT_PATH_OK_Group_Write
  [ "$_user" != 'root' ] && okgroup=$Tigris_PATH_OK_Group_Write

  [ -d "`__here "$_dir"`" ] &&
  if [ -n "$TIGRIS_ROOT" ]; then rootls "$_dir"; else $LS -Ld $_dir/* 2>/dev/null; fi |
  getpermit |
  while read _execfile _owner _group ur uw ux gr gw gx or ow ox suid sgid stk
  do
    [ "$ux$gx$ox" != '000' ] && {
      [ -n "$TigrisCheckEmbedded" -a "$_user" = 'root' ] && {
	echo "$_execfile /$_srcfile(PATH)" >> $TigrisCheckEmbedded
      }
      
      [ "$gw" = '1' ] && matchlist "$_group" "$okgroup" && gw=0
      
      case "$gw$ow" in
	00) _msg='';;
	01) _msg='world'; __newmode='o-w';;
	10) _msg="group \`$_group'"; __newmode='g-w';;
	11) _msg="group \`$_group' and world";__newmode='go-w';;
	*) _msg='';;
      esac
      [ -n "$_msg" ] && {
	message WARN path001w "" "$_execfile in $_user's PATH from $_srcfile is $_msg writable."
	changelog "WARN : chmod : $__newmode : $_execfile"
      }
      if matchlist "$_owner" "$okown"; then
	:
      elif [ "$suid" = '0' ]; then
	message WARN path002w "" "$_execfile in $_user's PATH from $_srcfile is not owned by root (owned by $_owner)."
	changelog "WARN : chown : root : $_execfile"
      else
	message INFO path008i "" "Setuid program $_execfile in $_user's PATH from $_srcfile is not owned by root (owned by $_owner)."
      fi
    }
  done
}

parse_path()
{
  user="$1"
  file="$2"
  pth="$3"
  saveifs=$IFS

  [ ! -n "$pth" -a "$user" = 'root' ] && {
    message INFO path003i "" "Unable to ascertain PATH from $user's $file."
    return
  }

  case "$pth" in
    *:) pth="${pth}.";;
  esac
  
  IFS=:
  set X $pth
  IFS=$saveifs
  shift
  
  dotinpath=
  
  for pcomp
  do
    comp="${pcomp:=.}"
    if [ "$comp" = '.' ]; then
      dotinpath=Y
      [ "$user" = 'root' ] && {
	message WARN path004w "" "PATH in $user's $file contains '.'"
      }
    elif [ -d "`__here "$comp"`" ]; then
      lgetpermit "$comp" |
      pathmsg path011 path012 "$comp" "$user" "The PATH set in $user's $file contains"
    fi
    [ "$user" = 'root' -a "$comp" != '.' ] && checkcmds $user "$comp" "$file"
  done
  [ "$lastcomp" != '.' -a -n "$dotinpath" ] && {
    message WARN path005w "" "'.' in PATH from $user's $file is not the last entry."
  }
}

#
# Parse Bourne SHell style file (sh, ksh, bash)
#
# This creates a file which all contains variable assignments in
# it, which path_value reads (nothing in it is run).
#
# safe_assignments: of the lines on standard input, the plain assignments:
# XXX_NAME=value, the value without whitespace, redirections, pipes, &, ;,
# parentheses or backquotes. The files they come from are users' own (or,
# on an offline root, an image's). What is kept used to be sourced, as
# root ("PATH=x>/etc/passwd" in a .profile truncated /etc/passwd); since
# October 2026 path_value reads it instead.
safe_assignments()
{
  $GREP '^XXX_[a-zA-Z_][a-zA-Z0-9_]*=[^<>|&;()`[:space:]]*$'
}

#
# path_value USER HOME: the PATH that the assignments on standard input
# (XXX_NAME=value, from safe_assignments) leave, worked out in awk. They
# were sourced until October 2026, and no filter makes that safe: where
# /bin/sh is bash, ${X@P} and arithmetic subscripts run commands built
# from characters the filter let through. Here a value is only read:
# quotes, backslashes, $NAME, ${NAME}, ${NAME:-word}, ${NAME-word} and a
# leading ~ are understood; anything else stays text. A name the file
# did not assign has the value it has here (PATH: the one Tigris runs
# with), as it would have been inherited, not an empty one.
#
path_value()
{
  __pvu=$1 __pvh=$2 $AWK '
  function get(name) {
    sub(/^XXX_/, "", name)
    if (("XXX_" name) in val) return val["XXX_" name]
    return ENVIRON[name]
  }
  function expand(v,   out, c, i, n, q, j, name, op, word) {
    out = ""; n = length(v); q = 0
    for (i = 1; i <= n; i++) {
      c = substr(v, i, 1)
      if (c == "\"") { q = !q; continue }
      if (c == "\047" && !q) {
        j = index(substr(v, i + 1), "\047")
        if (!j) { out = out substr(v, i + 1); break }
        out = out substr(v, i + 1, j - 1); i += j; continue
      }
      if (c == "\\" && i < n) { i++; out = out substr(v, i, 1); continue }
      if (c == "~" && !q && (i == 1 || substr(v, i - 1, 1) == ":") &&
          (i == n || substr(v, i + 1, 1) == "/" || substr(v, i + 1, 1) == ":")) {
        out = out val["XXX_HOME"]; continue
      }
      if (c == "$" && substr(v, i + 1, 1) == "{") {
        j = index(substr(v, i + 2), "}")
        if (!j) { out = out substr(v, i); break }
        name = substr(v, i + 2, j - 1); i += j + 1
        if (!match(name, /^[A-Za-z_][A-Za-z0-9_]*/)) continue
        op = substr(name, RLENGTH + 1); name = substr(name, 1, RLENGTH)
        if (op ~ /^:?-/) {
          word = op; sub(/^:?-/, "", word)
          if (get(name) == "" && (op ~ /^:/ || !(("XXX_" name) in val) && !(name in ENVIRON))) {
            out = out expand(word); continue
          }
        }
        out = out get(name); continue
      }
      if (c == "$" && match(substr(v, i + 1), /^[A-Za-z_][A-Za-z0-9_]*/)) {
        name = substr(v, i + 1, RLENGTH); i += RLENGTH
        out = out get(name); continue
      }
      out = out c
    }
    return out
  }
  BEGIN { val["XXX_USER"] = val["XXX_LOGNAME"] = ENVIRON["__pvu"]; val["XXX_HOME"] = ENVIRON["__pvh"] }
  # (the value first: awk may make the element before it works out the
  # right-hand side, and $PATH would then be an empty assignment)
  { k = index($0, "="); v = expand(substr($0, k + 1)); val[substr($0, 1, k - 1)] = v }
  END { print val["XXX_PATH"] }'
}

parse_bsh()
{
  user="$1"
  dir="$2"
  file="$3"
  rcfile=`__here "$dir/$file"`
  [ ! -f "$rcfile" ] && return
  
  $AWK '
  BEGIN {LINE="";}
  $0 ~ /\\$/ {printf("%s ", substr($0, 1, length($0)-1));}
  $0 !~ /\\$/ {printf("%s\n", $0);}
  END {printf("\n");}
  ' "$rcfile" |
  $GREP -v '".*;.*"' |
  $TR ';' '\012' |
  # Bob Hall suggests chaging the SED from
  # -e 's/\${\([a-zA-Z_][a-zA-Z0-9_]*}[^a-zA-Z0-9_]\)/${XXX_\1/g' \
  # to
  # -e 's/\${\([a-zA-Z_][a-zA-Z0-9_]*}\)$/${XXX_\1/g' \
  # on HP-UX 
  # TODO:(does this apply to other OS?
  $SED -e 's/#.*$//' \
       -e '/^$/d' \
       -e 's/^[ 	]*//' \
       -e 's/export[ 	][ 	]*//' \
       -e 's/^setenv[ 	]*\([a-zA-Z_][a-zA-Z0-9_]*\)[ 	]*\(.*\)$/XXX_\1=\2/g' \
       -e 's/^\([a-zA-Z_][a-zA-Z0-9_]*=.*\)$/XXX_\1/g' \
       -e 's/\$\([a-zA-Z_][a-zA-Z0-9_]*[^a-zA-Z0-9_]\)/$XXX_\1/g' \
       -e 's/\$\([a-zA-Z_][a-zA-Z0-9_]*\)$/$XXX_\1/g' \
       -e 's/\$([^)]*)//g' \
       -e 's/`[^`]*`//g' |
  $GREP -v '`' |
  $GREP -v '\$(' |
  $GREP -v '^.*=[^ 	]*[ 	]' |
  $GREP -v 'DISPLAY' |
  safe_assignments > $WORKDIR/pth.$$
  # The PATH they leave, read, never run (a subshell, as parse_path
  # sets variables of its own)
  (
    parse_path $user $file "`path_value "$user" "$dir" < $WORKDIR/pth.$$`"
  )
  delete $WORKDIR/pth.$$
}

#
# Parse C SHell style file (csh, tcsh)
#
# This creates a file which contains all variable assignments (sh style)
# in it, which path_value reads (nothing in it is run).
#
parse_csh()
{
  user="$1"
  dir="$2"
  file="$3"

  rcfile=`__here "$dir/$file"`
  [ ! -f "$rcfile" ] && return
  
  $AWK '
  $0 ~ /\\$/ {printf("%s ", substr($0, 1, length($0)-1));}
  $0 !~ /\\$/ {print}
  END {printf("\n");}
  ' "$rcfile" |
  $GREP -v '".*;.*"' |
  $TR ';' '\012' |
  $SED -e 's/#.*$//' \
       -e '/^$/d' \
       -e 's/^[ 	]*//' \
       -e 's/[()]//g' \
       -e 's/^set \([a-zA-Z_][a-zA-Z0-9_]*\)[ 	]*=[ 	]*\(.*\)$/XXX_\1=\2/g' \
       -e 's/^setenv[ 	]*\([a-zA-Z_][a-zA-Z0-9_]*\)[ 	]*\(.*\)$/XXX_\1=\2/g' \
       -e 's/[ 	]$//' \
       -e 's/[ 	]/:/g' |
  # ~ is the home directory, put in as text through the environment: in
  # the sed script, an image's home directory could end the s command
  # and add GNU sed's e, which runs a command
  h="$dir" $AWK '{ o = ""; s = $0; while ((i = index(s, "~")) > 0) { o = o substr(s, 1, i - 1) ENVIRON["h"]; s = substr(s, i + 1) } print o s }' |
  $SED -e 's/\$\([a-zA-Z_][a-zA-Z0-9_]*[^a-zA-Z0-9_]\)/$XXX_\1/g' \
       -e 's/\$\([a-zA-Z_][a-zA-Z0-9_]*\)$/$XXX_\1/g' \
       -e 's/XXX_path/XXX_PATH/g' \
       -e 's/`[^`]*`//g' \
       -e '/\$</d' |
  $GREP -v '`' |
  $GREP -v 'DISPLAY' |
  $GREP -v '^.*=[^ 	]*[ 	]' |
  safe_assignments > $WORKDIR/pth.$$
  # The PATH they leave, read, never run (a subshell, as parse_path
  # sets variables of its own)
  (
    parse_path $user $file "`path_value "$user" "$dir" < $WORKDIR/pth.$$`"
  )
  delete $WORKDIR/pth.$$
}

check_user()
{
  user="$1"
  dir="$2"

  # A home on a filesystem that does not answer would hang here
  mount_alive "$dir" || {
    message WARN path010w "" "Login ID $user home directory ($dir) is on a filesystem that did not answer within ${Tigris_Mount_Timeout:-5} seconds; its PATH was not checked."
    return
  }

  h=`__here "$dir"`
  [ -s "$h/.profile" ] && parse_bsh $user $dir .profile
  [ -s "$h/.cshrc" ] && parse_csh $user $dir .cshrc
  [ -s "$h/.login" ] && parse_csh $user $dir .login
  [ -s "$h/.tcshrc" ] && parse_csh $user $dir .tcshrc
  [ -s "$h/.bashrc" ] && parse_bsh $user $dir .bashrc
  [ "$user" = 'root' -a ! -f "$h/.profile" ] && {
    parse_path $user default $SYSDEFAULTPATH
  }
  # Only do this if no /bin/csh config files, but there IS a /bin/sh config
  [ "$user" = 'root' -a ! -f "$h/.cshrc" -a ! -f "$h/.login" -a -f "$h/.profile" ] && {
    parse_path $user default $SYSDEFAULTPATH
  }
}

realpath="$REALPATH -d"

test ! -n "$REALPATH" -o ! $TESTEXEC "$REALPATH" && realpath="echo"

[ ! -n "$SYSDEFAULTPATH" ] && {
  SYSDEFAULTPATH="/bin:/usr/bin:/usr/sbin"
}
# On Linux the initial PATH usually comes from /etc/environment through
# pam_env, not from /etc/profile; when it does, /etc/profile need not set it
pamenvpath=
environment=`__here /etc/environment` pamlogin=`__here /etc/pam.d/login`
[ -r "$environment" ] && [ -r "$pamlogin" ] &&
  $GREP -q '^PATH=' "$environment" &&
  $GREP -q '^[^#]*pam_env\.so' "$pamlogin" && pamenvpath=Y
[ -n "$Tigris_Global_PATH" ] && {
  for file in $Tigris_Global_PATH
    do
      fh=`__here $file`
      [ -r "$fh" ] && {
        case $file in
          /etc/profile|/etc/bashrc)
            found=`$GREP -v \# "$fh" | $GREP PATH | $GREP export 2>/dev/null`
            if [ -z "$found" ] && [ -z "$pamenvpath" ]; then
                message WARN path009w "" "$file does not export an initial setting for PATH."
            fi
            ;;
          /etc/csh.login)
            found="`$GREP -v \# "$fh" | $GREP PATH | $GREP setenv 2>/dev/null`" 
            if [ -z "$found" ]; then
                message WARN path009w "" "$file does not setenv an initial setting for PATH."
            fi
            ;;
         *)
            found="`$GREP -v \# "$fh" | $GREP PATH `"
            if [ -z "$found" ]; then
                message WARN path009w "" "$file does not have an initial setting for PATH."
            fi
            ;;
       esac
      }
    done
}

{
  if [ "$Tigris_Check_PATHALL" = 'Y' ]; then
    haveallcmds GEN_PASSWD_SETS &&
    haveallvars HOSTNAME && {
      {
	if [ -n "$Tigris_PasswdFiles" ]; then
	  [ -f "$Tigris_PasswdFiles" ] && $CAT "$Tigris_PasswdFiles" > $WORKDIR/pass.list.$$
	else
	  $GEN_PASSWD_SETS $WORKDIR/pass.list.$$
	fi
      }
      while read passwd_set
      do
	echo
	echo "# Checking accounts from `$CAT $passwd_set.src`..."
  
	# which host each home is on; on an offline root, all its own
	$AWK -F: '{print $1, $6}' $passwd_set |
	if [ -n "$TIGRIS_ROOT" ]; then
	  $AWK -v h="$HOSTNAME" '{ print $1, $2, h }'
	else
	  $BASEDIR/util/${GETFSHOST:=getfs-std}
	fi > $WORKDIR/home.hosts.$$
      
	$AWK -F: '{ printf("%s %s\n", $1, $6); }' $passwd_set |
	$JOIN -o 1.1 1.2 2.3 - $WORKDIR/home.hosts.$$ |
	while read user homedir host
	do
	  [ "$host" = "$HOSTNAME" ] && {
	    check_user $user $homedir
	  }
	done
	[ ! -n "$Tigris_PasswdFiles" ] && delete $passwd_set $passwd_set.src
	delete $WORKDIR/home.hosts.$$
      done < $WORKDIR/pass.list.$$
	delete $WORKDIR/pass.list.$$
    }
  else
    echo "# Only checking user 'root'"
    check_user root /
  fi
} |
$OUTPUTMETHOD

delete $WORKDIR/pth.$$

exit 0
