file="$1"

[ "$CONFIGURED_ALREADY" != "YES" ] && {
  echo "--ERROR-- [init008e] This script can not be run directly."
  exit 1
}

. $BASEDIR/initdefs

#
# If run in test mode (-t) this will verify that all required
# elements are set.
#
[ "$Tiger_TESTMODE" = 'Y' ] && {
  haveallcmds GREP CAT RM AWK SORT LS GETCLIENTDIRS || exit 1
  haveallfiles WORKDIR || exit 1
  
  echo "--CONFIG-- [init003c] $0: Configuration ok..."
  exit 0
}

#------------------------------------------------------------------------
echo
echo "# Checking for writable directories..."

haveallcmds GREP CAT SED AWK SORT LS || exit 1
haveallvars WORKDIR || exit 1

[ ! -n "$FS_WDIRSYS" ] && FS_WDIRSYS="/tmp/ /usr/tmp/"

dltmpdirs=
[ -n "$HOSTNAMESLIST" ] &&
haveallcmds GETCLIENTDIRS AWK && {
  dltmpdirs=`$GETCLIENTDIRS |
             while read -r client rootdir
             do
               for dir in $FS_WDIRSYS
               do
                  echo "$rootdir$dir"
               done
             done
  `
}

# The directories that are meant to be world writable are left out,
# matched as prefixes, as words, never as patterns or as code (the
# diskless clients' come from bootparams, which is data).
$SED -e 's%\([^/]\)$%\1/%' $file |
$AWK -v dirs="$FS_WDIRSYS $dltmpdirs" '
  BEGIN { n = split(dirs, d, " ") }
  { for (i = 1; i <= n; i++) if (index($0, d[i]) == 1) next; print }' > $WORKDIR/wdir.tmp.$$

# One finding a directory. A sticky one is shared as /tmp is, which is
# what CIS asks of every world-writable directory: no finding, but where
# root reads programs or configuration (or a web server its pages), since
# anyone can still add files there.
[ -s $WORKDIR/wdir.tmp.$$ ] && {
  $SORT $WORKDIR/wdir.tmp.$$ |
  while read -r dir
  do
    d=${dir%/}; [ -n "$d" ] || d=/
    lsl=`lsline "$d" 2>/dev/null | $AWK '{ print $1, $3; exit }'`
    set -f; set -- $lsl; set +f
    case "${1:-?}" in
      ?????????[tT]*)
        case "$dir" in
          /var/www/*)
            detail="Sticky, but under /var/www, where a web server reads its pages: anyone can add files there." ;;
          /etc/*|/usr/*|/bin/*|/sbin/*|/lib/*|/lib32/*|/lib64/*|/libx32/*|/boot/*|/root/*|/opt/*)
            tree=${dir#/}; tree=/${tree%%/*}
            detail="Sticky, but under $tree, where root reads programs and configuration: anyone can add files there." ;;
          *) continue ;;
        esac ;;
      *) detail="Not sticky: anyone can delete or replace the files others keep there." ;;
    esac
    message FAIL fsys008f "$detail" "Directory $d is world writable (${1:-?}, owner ${2:-?})."
  done
}

delete $WORKDIR/wdir.tmp.$$

