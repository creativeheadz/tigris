inputfile="$1"

[ "$CONFIGURED_ALREADY" != "YES" ] && {
  echo "--ERROR-- [init008e] This script can not be run directly."
  exit 1
}

. $BASEDIR/initdefs

#
# If run in test mode (-t) this will verify that all required
# elements are set.
#
[ "$Tigris_TESTMODE" = 'Y' ] && {
  haveallcmds RM FILECMD SGREP LS STRINGS SORT COMM CAT AWK || exit 1
  haveallfiles BASEDIR WORKDIR SUID_LIST || exit 1
  
  echo "--CONFIG-- [init003c] $0: Configuration ok..."
  exit 0
}

#------------------------------------------------------------------------
echo
echo "# Checking setgid executables..."

haveallfiles BASEDIR WORKDIR || exit 1

#[ -n "$TigrisCheckEmbedded" -a "x$Tigris_Embed_Check_SGID" = 'xY' ] && {
#  while read -r file
#  do
#    $LS -lLd "$file" 2>/dev/null | {
#      read p l owner rest
#      [ "$owner" = root ] && echo "$file" >> $TigrisCheckEmbedded
#    }
#  done
#}

haveallcmds FILECMD LS SGREP STRINGS && {
  while read -r file
  do
    # where it is: itself, or inside an offline root
    here=`__here "$file"`
    $FILECMD "$here" 2>/dev/null | $SGREP script 2>/dev/null && {
      message WARN fsys010w "" "File $file is a setgid script:"
      lsline "$file"
    }
  
#    $STRINGS - "$file" 2>/dev/null |
#   $SGREP '\.\./' 2>/dev/null && {
#      $SGREP "$file" $REL_FILE_EXCP 2>/dev/null || {
#	message WARN fsys002w "" "setuid program $file has relative pathnames."
#      }
#    }
  done < $inputfile
  
  echo
}

# What is expected to be setgid: what the installed packages make setgid
# (util/pkgspecial, as for setuid in check_suid), else Tigris's list for
# the platform
source=
haveallcmds SORT COMM CAT && {
  $SORT $inputfile > $WORKDIR/sgid.in.$$
  if sh $BASEDIR/util/pkgspecial sgid > $WORKDIR/sgid.pkg.$$ 2>/dev/null; then
    $COMM -23 $WORKDIR/sgid.in.$$ $WORKDIR/sgid.pkg.$$ > $WORKDIR/sgid.list.$$
    case "$LXPKGMGR" in
      dpkg) source="No installed package makes it setgid: compared with dpkg's file lists and statoverrides, and Tigris's list of what Debian and Ubuntu packages make setgid." ;;
      *) source="No installed package makes it setgid ($LXPKGMGR's database)." ;;
    esac
  elif [ -n "$SGID_LIST" -a -s "$SGID_LIST" ]; then
    $SORT $SGID_LIST |
    $COMM -23 $WORKDIR/sgid.in.$$ - > $WORKDIR/sgid.list.$$
    source="Not in Tigris's list of the setgid programs this platform ships."
  else
    message CONFIG fsys003c "" 'No setgid list... listing all setgid files'
    $CAT $inputfile > $WORKDIR/sgid.list.$$
  fi
}

# One finding a file, its mode and group in the message (the JSON has
# no other place for them)
haveallcmds LS AWK && [ -s $WORKDIR/sgid.list.$$ ] && {
  # on dpkg, the package each is from: Tigris's list cannot say what a
  # package it does not know makes sgid (a vendor's chrome-sandbox), but
  # a file no package installed is another matter
  owners=
  sh $BASEDIR/util/pkgspecial owners < $WORKDIR/sgid.list.$$ > $WORKDIR/sgid.own.$$ 2>/dev/null && owners=Y
  while read -r file
  do
    lsl=`lsline "$file" 2>/dev/null | $AWK '{ print $1, $4; exit }'`
    set -f; set -- $lsl; set +f
    detail=$source
    [ -n "$owners" ] && {
      pkg=`f="$file" $AWK -F'\t' '$1 == ENVIRON["f"] { print $2; exit }' $WORKDIR/sgid.own.$$`
      if [ -n "$pkg" ]; then detail="$source It is from package $pkg."; else detail="$source No package installed it."; fi
    }
    message ALERT fsys011a "$detail" "Setgid program $file (${1:-?}, group ${2:-?}) is non-standard."
  done < $WORKDIR/sgid.list.$$
  echo
}

#
# Try to locate setuid copies of any executables we have signatures
# for.
#
if [ "$Tigris_Check_SIGNATURES" != 'N' ]; then  
haveallcmds SORT AWK COMM GREP LS SNEFRU &&
haveallfiles SIGNATURE_FILE && {
  $SORT $inputfile > $WORKDIR/sgid.$$
  $AWK '{print $3}' $SIGNATURE_FILE |
  $SORT |
  $COMM -13 - $WORKDIR/sgid.$$ |
  while read -r file
  do
    loc_signature=
    fh=`__here "$file"`
    case "$p1$p2$p3$p4$p5$p6$p7$p8" in
      *[!0-9a-f]*) {
	std_signature="$p1"
	comment="$p2 $p3 $p4 $p5 $p6 $p7 $p8 $comment"
	[ -n "$MD5" ] && loc_signature="`$MD5 < \"$fh\"`"
      }
      ;;
      *) {
	std_signature=" $p1 $p2 $p3 $p4 $p5 $p6 $p7 $p8"
	[ -n "$SNEFRU" ] && loc_signature="`$SNEFRU < \"$fh\"`"
      }
      ;;
    esac
    [ -n "$loc_signature" ] && {
      $GREP "$loc_signature" $SIGNATURE_FILE | {
	read -r flag msgid rfile p1 p2 p3 p4 p5 p6 p7 p8 comment
	[ -n "$rfile" -a "$file" != "$rfile" ] && {
	  message ALERT sgid001a "" "\`$file' is a setgid copy of $rfile [$comment]."
	  lsline "$file"
	}
      }
    }
  done
}
fi
delete $WORKDIR/sgid.list.$$ $WORKDIR/sgid.pkg.$$ $WORKDIR/sgid.$$ $WORKDIR/sgid.in.$$ $WORKDIR/sgid.own.$$
