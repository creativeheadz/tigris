inputfile="$1"

[ "$CONFIGURED_ALREADY" != "YES" ] && {
  echo "--ERROR-- [init008e] This script can not be run directly."
  exit 1
}

. $BASEDIR/initdefs

#
# If run in test mode (-t) this will verify that all required
# elements are set.
#
[ "$Tigris_TESTMODE" = 'Y' ] && {
  haveallcmds RM FILECMD SGREP GREP LS STRINGS SORT COMM CAT AWK || exit 1
  haveallfiles BASEDIR WORKDIR SUID_LIST || exit 1
  
  echo "--CONFIG-- [init003c] $0: Configuration ok..."
  exit 0
}

#------------------------------------------------------------------------
echo
echo "# Checking setuid executables..."

haveallfiles BASEDIR WORKDIR || exit 1

[ -n "$TigrisCheckEmbedded" -a "x$Tigris_Embed_Check_SUID" = 'xY' ] && {
  while read -r file
  do
    $LS -lLd "$file" 2>/dev/null | {
      read -r p l owner rest
      [ "$owner" = root ] && echo "$file" >> $TigrisCheckEmbedded
    }
  done
}

# What is expected to be setuid: what the installed packages make setuid
# (util/pkgspecial: rpm's and apk's file modes, pacman's mtree files; for
# dpkg, which records no modes, Tigris's list of what Debian and Ubuntu
# packages make setuid, for the packages installed, and what
# dpkg-statoverride records), else Tigris's list for the platform. What
# is not expected is listed in suid.list, one path a line.
source=
haveallcmds SORT COMM CAT && {
  $SORT $inputfile > $WORKDIR/suid.in.$$
  if sh $BASEDIR/util/pkgspecial suid > $WORKDIR/suid.pkg.$$ 2>/dev/null; then
    $COMM -23 $WORKDIR/suid.in.$$ $WORKDIR/suid.pkg.$$ > $WORKDIR/suid.list.$$
    case "$LXPKGMGR" in
      dpkg) source="No installed package makes it setuid: compared with dpkg's file lists and statoverrides, and Tigris's list of what Debian and Ubuntu packages make setuid." ;;
      *) source="No installed package makes it setuid ($LXPKGMGR's database)." ;;
    esac
  elif [ -n "$SUID_LIST" -a -s "$SUID_LIST" ]; then
    $SORT $SUID_LIST |
    $COMM -23 $WORKDIR/suid.in.$$ - > $WORKDIR/suid.list.$$
    source="Not in Tigris's list of the setuid programs this platform ships."
  else
    message CONFIG fsys003c "" 'No setuid list... listing all setuid files'
    $CAT $inputfile > $WORKDIR/suid.list.$$
  fi
}
# nonstandard FILE: is it in suid.list (the path compared as text)
nonstandard()
{
  [ -f $WORKDIR/suid.list.$$ ] && $GREP -F -x -q -e "$1" $WORKDIR/suid.list.$$
}

haveallcmds FILECMD LS SGREP STRINGS && {
  while read -r file
  do
    # where it is: itself, or inside an offline root
    here=`__here "$file"`
    $FILECMD "$here" 2>/dev/null | $SGREP script 2>/dev/null && {
      message FAIL fsys001f "" "File $file is a setuid script:"
      lsline "$file"
    }

    getpermit "$file" 2>/dev/null |
    while read -r _file owner group ur uw ux gr gw gx or ow ox suid sgid stk
    do
      matchlist "$owner" "${Tigris_Admin_Accounts:+$Tigris_Admin_Accounts|}root" || {
        message FAIL fsys018f "" "File $file is not owned by an administrative user."
        lsline "$file"
      }
    done
 
    case "$file" in
    *xterm) {
      message WARN misc013w "" "$file: see CERT Advisory CA-93:17 about a security hole in xterm (does not apply to HP-UX)."
    }
    ;;
    esac
  
    # Relative pathnames, in a program no package makes setuid: the ones
    # packages ship have them all (sudo, pkexec and ssh-keysign each name
    # "../" in order to refuse it), so there the test said nothing
    nonstandard "$file" &&
    $STRINGS - "$here" 2>/dev/null |
    $SGREP '\.\./' 2>/dev/null && {
      $GREP -F -x -q -e "$file" $REL_FILE_EXCP 2>/dev/null || {
	case "$file" in
	  */xload)
	  message WARN misc015w "" "$file appears to contain relative pathnames.  There is a known security vulnerability with xload in this configuration."
	  ;;
	  # The following is contributed by Bob Hall for HP-UX (it is not active by default)
	  # TODO: find a way to read this from a file and check them instead of the case
# /sbin/lvchange) ;;
# /sbin/lvcreate) ;;
# /sbin/lvdisplay) ;;
# /sbin/lvextend) ;;
# /sbin/lvlnboot) ;;
# /sbin/lvmerge) ;;
# /sbin/lvsplit) ;;
# /sbin/lvsync) ;;
# /sbin/lvreduce) ;;
# /sbin/lvremove) ;;
# /sbin/lvrmboot) ;;
# /sbin/passwd) ;;
# /sbin/pvchange) ;;
# /sbin/pvck) ;;
# /sbin/pvcreate) ;;
# /sbin/pvdisplay) ;;
# /sbin/pvmove) ;;
# /sbin/pvremove) ;;
# /sbin/sdstolvm) ;;
# /sbin/shutdown) ;;
# /sbin/vgcfgbackup) ;;
# /sbin/vgcfgrestore) ;;
# /sbin/vgchange) ;;
# /sbin/vgchgid) ;;
# /sbin/vgcreate) ;;
# /sbin/vgdisplay) ;;
# /sbin/vgexport) ;;
# /sbin/vgextend) ;;
# /sbin/vgimport) ;;
# /sbin/vgreduce) ;;
# /sbin/vgremove) ;;
# /sbin/vgscan) ;;
# /sbin/vgsync) ;;
# /sbin/nomwcsyncd) ;;
# /usr/bin/X11/X) ;;
# /usr/lbin/chgpt) ;;
# /usr/sbin/sd) ;;
# /usr/bin/at) ;;
# /usr/bin/chkey) ;;
# /usr/bin/ct) ;;
# /usr/lbin/grmd) ;;
# /usr/sam/lbin/rsam) ;;
# /usr/sbin/swacl) ;;
# /usr/sbin/swask) ;;
# /usr/sbin/swconfig) ;;
# /usr/sbin/swcopy) ;;
# /usr/sbin/swinstall) ;;
# /usr/sbin/swjob) ;;
# /usr/sbin/swlist) ;;
# /usr/sbin/swmodify) ;;
# /usr/sbin/swpackage) ;;
# /usr/sbin/swreg) ;;
# /usr/sbin/swremove) ;;
# /usr/sbin/swverify) ;;
# /usr/dt/bin/dtsession) ;;
# /usr/dt/bin/dtterm) ;;
          *)
	  message WARN fsys002w "" "setuid program $file has relative pathnames."
          ;;
        esac
      }
    }
    getpermit "$file" |
    pathmsg . suid002 "$file" . "Setuid file" ""
  done < $inputfile
  
  echo
}

# One finding a file, its mode and owner in the message (the JSON has
# no other place for them)
haveallcmds LS AWK && [ -s $WORKDIR/suid.list.$$ ] && {
  # on dpkg, the package each is from: Tigris's list cannot say what a
  # package it does not know makes suid (a vendor's chrome-sandbox), but
  # a file no package installed is another matter
  owners=
  sh $BASEDIR/util/pkgspecial owners < $WORKDIR/suid.list.$$ > $WORKDIR/suid.own.$$ 2>/dev/null && owners=Y
  while read -r file
  do
    lsl=`lsline "$file" 2>/dev/null | $AWK '{ print $1, $3; exit }'`
    set -f; set -- $lsl; set +f
    detail=$source
    [ -n "$owners" ] && {
      pkg=`f="$file" $AWK -F'\t' '$1 == ENVIRON["f"] { print $2; exit }' $WORKDIR/suid.own.$$`
      if [ -n "$pkg" ]; then detail="$source It is from package $pkg."; else detail="$source No package installed it."; fi
    }
    message ALERT fsys004a "$detail" "Setuid program $file (${1:-?}, owner ${2:-?}) is non-standard."
  done < $WORKDIR/suid.list.$$
  echo
}

#
# Try to locate setuid copies of any executables we have signatures
# for (with Tigris_Check_SIGNATURES, as check_sgid: the signatures are
# 2003's, and without the hash helpers built every run said ERROR)
#
if [ "$Tigris_Check_SIGNATURES" != 'N' ]; then
haveallcmds SORT AWK COMM GREP LS SNEFRU &&
haveallfiles SIGNATURE_FILE && {
  $SORT $WORKDIR/suid.list.$$ > $WORKDIR/suid.$$
  $AWK '{print $3}' $SIGNATURE_FILE |
  $SORT |
  $COMM -13 - $WORKDIR/suid.$$ |
  while read -r file
  do
    loc_signature=
    fh=`__here "$file"`
    case "$p1$p2$p3$p4$p5$p6$p7$p8" in
      *[!0-9a-f]*) {
	std_signature="$p1"
	comment="$p2 $p3 $p4 $p5 $p6 $p7 $p8 $comment"
	[ -n "$MD5" ] && loc_signature="`$MD5 < \"$fh\"`"
      }
      ;;
      *) {
	std_signature=" $p1 $p2 $p3 $p4 $p5 $p6 $p7 $p8"
	[ -n "$SNEFRU" ] && loc_signature="`$SNEFRU < \"$fh\"`"
      }
      ;;
    esac
    [ -n "$loc_signature" ] && {
      $GREP "$loc_signature" $SIGNATURE_FILE | {
	read -r flag msgid rfile p1 p2 p3 p4 p5 p6 p7 p8 comment
	[ -n "$rfile" -a "$file" != "$rfile" ] && {
	  message ALERT suid001a "" "\`$file' is a setuid copy of $rfile [$comment]."
	  lsline "$file"
	}
      }
    }
  done
}
fi

delete $WORKDIR/suid.list.$$ $WORKDIR/suid.pkg.$$ $WORKDIR/suid.$$ $WORKDIR/suid.in.$$ $WORKDIR/suid.own.$$
