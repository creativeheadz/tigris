#    it under the terms of the GNU General Public License as published by
#    the Free Software Foundation; either version 2, or (at your option)
#    any later version.
#
#    This program is distributed in the hope that it will be useful,
#    but WITHOUT ANY WARRANTY; without even the implied warranty of
#    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
#    GNU General Public License for more details.
#
#     Please see the file `COPYING' for the complete copyright notice.
#
# check_logfiles - 11/10/2001
# 
# Check for the presence of a given number of logfiles and their permissions.
# Note that these check is operating system dependant.
#
# check_logfiles - 08/09/2001 - jfs - fixed to add GREP and WC to haveallcmds
#                  detected when testing in Solaris 8. Also changed == to =
#
# check_logfiles - 04/15/2003 - jfs - separated logfiles and umask checks
#                  added permission checks for the logfiles based on 
#                  Solaris recommendations. 
#                  Logfile location is no longer hardcoded but can be changed
#                  depending on $OS
# check_logfiles - 06/20/2003 - jfs - based on patch from Ryan Bradetich fixed
#                  logic errors in check_fileperm(). Updated the error codes to 
#                  match the appropriate descriptions.
#                  Also fixed a typo in MESSAGEs and modified the script to not
#                  warn if LOGINLOG does not exist (as is the Linux case)
#                  Also, file permissions in systems in which WTMP and UTMP
#                  are group 'utmp' should be 664
# check_logfiles - 10/19/2003 - jfs - based on patch from Ryan Bradetich fixed
#                  location of logfiles for HP-UX, btmp file check, and btmp
#                  location for Linux (previously undefined)
# check_logfiles - 11/19/2003 - jfs - Modified -r to -f
#     (Checks should only determine wether the file exists, if its 
#     readable or not is irrelevant. As a matter of fact they might not be
#     if running a user != root. We don't care since we are not checking
#     file content)
# check_logfiles - 04/03/2004 - rbrad Added logfiles support for Tru64.
# check_logfiles - 10/23/2026 - Linux: where a syslog daemon is configured
#     to write files (rsyslog by /etc/rsyslog.conf, syslog-ng by its
#     syslog-ng.conf, the classic syslogd by /etc/syslog.conf with a
#     syslogd to read it, as check_remotelog decides it), the files it
#     writes and that exist must be rotated: logrotate installed, with
#     /etc/logrotate.conf and an entry (in it or what it includes)
#     matching each file, and a timer or cron job running it; otherwise
#     logf011w (WARN: the disk fills, and the logs go with it). A
#     journal-only host has no text logs and nothing to rotate; a file
#     the daemon has not created yet (stock Debian's and Ubuntu's
#     mail.err) is judged once it is there. Live only: a syslog daemon configured
#     but none running (rsyslogd, syslog-ng, syslogd, metalog) while the
#     journal is not kept on disk is logf012w (WARN: nothing records the
#     system log). Both read the root's files through the root helpers;
#     the running processes come from /proc live.
#
# References:
#   logrotate(8), logrotate.conf(5), rsyslog.conf(5), syslog-ng.conf(5),
#   syslog.conf(5), journald.conf(5)
#
#-----------------------------------------------------------------------------
#
# Tigris: offline
#   the root's log files (paths chosen for this host's $OS), its syslog
#   and logrotate configuration.
#
TigrisInstallDir="."

#
# Set default base directory.
# Order or preference:
#      -B option
#      TIGERHOMEDIR environment variable
#      TigrisInstallDir installed location
#
basedir=${TIGERHOMEDIR:=$TigrisInstallDir}

for parm
do
   case $parm in
   -B) basedir=$2; break;;
   esac
done

#
# Verify that a config file exists there, and if it does
# source it.
#
[ ! -r $basedir/config ] && {
  echo "--ERROR-- [init002e] No 'config' file in \`$basedir'."
  exit 1
}

. $basedir/config

. $BASEDIR/initdefs

#
# If run in test mode (-t) this will verify that all required
# elements are set.
#
[ "$Tigris_TESTMODE" = 'Y' ] && {
  haveallcmds AWK CAT GREP SED SORT || exit 1
  haveallfiles BASEDIR WORKDIR || exit 1
  haveallvars TESTLINK HOSTNAME

  echo "--CONFIG-- [init003c] $0: Configuration ok..."
  exit 0
}

#------------------------------------------------------------------------

echo
echo "# Checking for existence of log files..."

haveallcmds AWK CAT GREP SED SORT || exit 1

check_fileperm () {
  file=$1
  permission=$2
  value=1
  realpermission=`getpermit $1 | $AWK '{ print $4$5$6$7$8$9$10$11$12 }' `
  [ "$realpermission" = "$permission" ]  && value=0
  return $value
}


#####
# Check various accounting files
#####
WTMP=/var/log/wtmp
BTMP=/var/log/btmp
LASTLOG=/var/log/lastlog
UTMP=/var/run/utmp
LOGINLOG=/var/log/loginlog
MESSAGES=/var/log/messages
SULOG=""

if [ "$OS" = "SunOS" ] ; then
	WTMP=/var/adm/wtmpx
	UTMP=/var/adm/utmpx
# Check: Note BTMP does not seem to exist
	BTMP=/var/adm/btmp
	LASTLOG=/var/adm/lastlog
	LOGINLOG=/var/adm/loginlog
	MESSAGES=/var/adm/messages
	SULOG=/var/adm/sulog
fi

if [ "$OS" = "Linux" ] ; then
# Loginlog does not exist
# Btmp does exist (see lastb(1))
	LOGINLOG=""
# The system log is /var/log/messages on Red Hat and SUSE but
# /var/log/syslog on Debian and its derivatives, and with a persistent
# journal (/var/log/journal) there need not be a text log at all
	if [ ! -f "`__here "$MESSAGES"`" ] ; then
		if [ -f "`__here /var/log/syslog`" ] ; then
			MESSAGES=/var/log/syslog
		elif __journal=`__here /var/log/journal` && [ -d "$__journal" ] && [ -n "`$LS -A "$__journal" 2>/dev/null`" ] ; then
			MESSAGES=""
		fi
	fi
fi

if [ "$OS" = "HPUX" ] ; then
	WTMP=/var/adm/wtmp
	BTMP=/var/adm/btmp
	LASTLOG=""
	UTMP=/etc/utmp
	LOGINLOG=""
	MESSAGES=""
fi

if [ "$OS" = "Tru64" ]; then
	WTMP=/var/adm/wtmp
	BTMP=""
	LASTLOG=""
	UTMP=/var/adm/utmp
	LOGINLOG=""
	MESSAGES=""
fi

# Existence is tested inside the root; getpermit and the messages
# keep the system's own paths.
WTMPhere=`__here "$WTMP"`
BTMPhere=`__here "$BTMP"`
LASTLOGhere=`__here "$LASTLOG"`
UTMPhere=`__here "$UTMP"`
LOGINLOGhere=`__here "$LOGINLOG"`
SULOGhere=`__here "$SULOG"`
MESSAGEShere=`__here "$MESSAGES"`

if [ ! -f "$WTMPhere" ] ; then
    #echo "...Warning: $WTMP does not exist"
    message FAIL logf001f "" "Log file $WTMP does not exist"
else
    group=`getpermit $WTMP | $AWK '{ print $3 }'`
    if [  "$group" = "utmp" ] ; then
        check_fileperm $WTMP 110110100 || 
       	message FAIL logf005f "" "Log file $WTMP permission should be 664"
    else
	check_fileperm $WTMP 110100100 || 
 	message FAIL logf005f "" "Log file $WTMP permission should be 644"
    fi
fi

if [ -n "$BTMP" ] ; then
    if [ ! -f "$BTMPhere" ] ; then
        #echo "...Warning: $BTMP does not exist"
        message FAIL logf002f "" "Log file $BTMP does not exist"
    else
        group=`getpermit $BTMP | $AWK '{ print $3 }'`
        if [ "$group" = "utmp" ] ; then
	    check_fileperm $BTMP 110110000 || 
 	    message FAIL logf005f "" "Log file $BTMP permission should be 660"
        else
	    check_fileperm $BTMP 110000000 || 
 	    message FAIL logf005f "" "Log file $BTMP permission should be 600"
	fi
    fi
fi

[ -n "$LASTLOG" -a ! -f "$LASTLOGhere" ] && 
    #echo "...Warning: $LASTLOG does not exist"
    message FAIL logf003f "" "Log file $LASTLOG does not exist"

if [ ! -f "$UTMPhere" ] ; then
    #echo "...Warning: $UTMP does not exist"
    message FAIL logf004f "" "Log file $UTMP does not exist"
else
    group=`getpermit $UTMP | $AWK '{ print $3 }'`
    if [  "$group" = "utmp" ] ; then
	check_fileperm $UTMP 110110100 || 
   	message FAIL logf005f "" "Log file $UTMP permission should be 664"
    else
	check_fileperm $UTMP 110100100 || 
	message FAIL logf005f "" "Log file $UTMP permission should be 644"
    fi
fi

if [ -n "$LOGINLOG" ] ; then
    if [ ! -f "$LOGINLOGhere" ] ; then
        #echo "...Warning: $LOGINGLOG does not exist"
        message FAIL logf006f "" "Log file $LOGINLOG does not exist"
    else
        check_fileperm $LOGINLOG 110000000 || 
    	    message FAIL logf005f "" "Log file $LOGINLOG permission should be 600"
    fi
fi

if [ -n "$SULOG" ] ; then
    if [ ! -f "$SULOGhere" ] ; then
        message FAIL logf006f "" "Log file $SULOG does not exist"
    else
        check_fileperm $SULOG 110000000 || 
    	    message FAIL logf005f "" "Log file $SULOG permission should be 600"
    fi
fi
 
if [ -n "$MESSAGES" ] ; then
    if [ ! -f "$MESSAGEShere" ] ; then
        #echo "...Warning: $MESSAGES does not exist"
        message FAIL logf007f "" "Log file $MESSAGES does not exist"
    else
        check_fileperm $MESSAGES 110100000 ||
    	    message FAIL logf005f "" "Log file $MESSAGES permission should be 640"
    fi
fi

[ "$OS" = "Linux" ] || exit 0

#####
# Linux: the syslog daemon's files are rotated, and the daemon runs
#####
# (the root helpers read the audited root, or the tests' Tigris_Sysctl_Root)
root=${Tigris_Sysctl_Root:-}

# commas: the lines on standard input as one, ", " between them
commas()
{
  $AWK '{ printf "%s%s", (NR > 1 ? ", " : ""), $0 } END { if (NR) print "" }'
}

# Which syslog daemon is configured: rsyslog by its rsyslog.conf,
# syslog-ng by its syslog-ng.conf, the classic syslogd (sysklogd,
# inetutils, busybox) by /etc/syslog.conf where a syslogd is there to
# read it
daemons=
[ -f "`rootfile /etc/rsyslog.conf`" ] && daemons="$daemons rsyslog"
[ -f "`rootfile /etc/syslog-ng/syslog-ng.conf`" ] && daemons="$daemons syslog-ng"
if [ -f "`rootfile /usr/sbin/syslogd`" ] || [ -f "`rootfile /sbin/syslogd`" ]; then
  [ -f "`rootfile /etc/syslog.conf`" ] && daemons="$daemons syslogd"
fi
daemons=${daemons# }
[ -n "$daemons" ] || exit 0

# The files they write. rsyslog and syslogd: the action field of a
# selector line (/path or -/path), and rsyslog's omfile file="..."; a
# directive ($WorkDirectory), a module/input/include statement and a
# template are not rules. syslog-ng: file("/path") drivers. A dynamic
# name ($YEAR, %variable) makes a new file by itself and is left out, as
# are /dev and /proc.
files=`{
  case " $daemons " in *" rsyslog "*)
    { echo /etc/rsyslog.conf; rootls /etc/rsyslog.d 2>/dev/null | $GREP '\.conf$'; } | rootcat 2>/dev/null |
    $AWK '
    /^[ \t]*(#|[$]|module|global|input|include|template|parser|ruleset|set |unset |call )/ { next }
    NF >= 2 && $NF ~ /^-?\/[^ \t]/ { p = $NF; sub(/^-/, "", p); print p }
    /[fF]ile[ \t]*=[ \t]*"\// { s = $0; while (match(s, /[fF]ile[ \t]*=[ \t]*"\/[^"]+"/)) { p = substr(s, RSTART, RLENGTH); sub(/^[^"]*"/, "", p); sub(/"$/, "", p); print p; s = substr(s, RSTART + RLENGTH) } }' ;;
  esac
  case " $daemons " in *" syslog-ng "*)
    { echo /etc/syslog-ng/syslog-ng.conf; rootls /etc/syslog-ng/conf.d 2>/dev/null | $GREP '\.conf$'; } | rootcat 2>/dev/null |
    $AWK '
    /^[ \t]*#/ { next }
    { s = $0; while (match(s, /file[ \t]*\([ \t]*"\/[^"]+"/)) { p = substr(s, RSTART, RLENGTH); sub(/^[^"]*"/, "", p); sub(/"$/, "", p); print p; s = substr(s, RSTART + RLENGTH) } }' ;;
  esac
  case " $daemons " in *" syslogd "*)
    { echo /etc/syslog.conf; rootls /etc/syslog.d 2>/dev/null; } | rootcat 2>/dev/null |
    $AWK '/^[ \t]*#/ { next } NF >= 2 && $NF ~ /^-?\/[^ \t]/ { p = $NF; sub(/^-/, "", p); print p }' ;;
  esac
} | $GREP -v '[$%]' | $GREP -v -e '^/dev/' -e '^/proc/' | $SORT -u`

# Only the files that are there. rsyslog creates a file at its first
# message, and the stock Debian and Ubuntu rules name one (mail.err)
# their logrotate stanza does not: on a host that has never had a mail
# error it does not exist, and a file that is not there cannot fill a
# disk. It is judged once it exists.
files=`printf '%s\n' "$files" | while read -r f
do
  [ -n "$f" ] && [ -f "\`rootfile "$f"\`" ] && echo "$f"
done`

dname=`printf '%s\n' "$daemons" | $SED 's/ / and /g'`
if [ -n "$files" ]; then
  nfiles=`printf '%s\n' "$files" | $GREP -c .`
  # logrotate: the program, its configuration and what runs it
  logrotate=
  for p in /usr/sbin/logrotate /usr/bin/logrotate /sbin/logrotate /bin/logrotate
  do
    [ -f "`rootfile $p`" ] && { logrotate=$p; break; }
  done
  lrconf=`rootfile /etc/logrotate.conf`
  if [ -z "$logrotate" ]; then
    message WARN logf011w "$dname writes `printf '%s\n' "$files" | commas`. Install logrotate: its configuration for $dname comes with the package." "$dname writes $nfiles log files and logrotate is not installed: nothing rotates them, so they grow until the disk is full and the logs are lost with it."
  elif [ ! -f "$lrconf" ]; then
    message WARN logf011w "$dname writes `printf '%s\n' "$files" | commas`. Restore /etc/logrotate.conf (the package's copy includes /etc/logrotate.d)." "$dname writes $nfiles log files and logrotate has no /etc/logrotate.conf: it rotates nothing, so they grow until the disk is full and the logs are lost with it."
  else
    # The file patterns logrotate.conf and what it includes name: the
    # tokens starting with / outside the braces (quotes dropped), an
    # include line's argument apart; a path is matched against each as a
    # shell pattern (/var/log/*.log), so the data is a pattern, never a
    # command
    incs=`$AWK '!/^[ \t]*#/ && $1 == "include" && $2 ~ /^\// { print $2 }' "$lrconf" 2>/dev/null`
    patterns=`{ echo /etc/logrotate.conf
      for inc in $incs
      do
        if [ -d "\`rootfile "$inc"\`" ]; then rootls "$inc" 2>/dev/null; else echo "$inc"; fi
      done
    } | rootcat 2>/dev/null | $AWK '
    /^[ \t]*#/ { next }
    {
      line = $0
      if (depth == 0 && line !~ /^[ \t]*include[ \t]/) {
        n = split(line, t, /[ \t]+/)
        for (i = 1; i <= n; i++) { w = t[i]; gsub(/"/, "", w); if (w ~ /^\//) print w }
      }
      depth += gsub(/[{]/, "&", line) - gsub(/[}]/, "&", line)
      if (depth < 0) depth = 0
    }'`
    # (set -f: the patterns must not be expanded against this host's
    # files on the way to case)
    unrotated=`printf '%s\n' "$files" | ( set -f; while read -r f
    do
      hit=
      for p in $patterns
      do
        case "$f" in $p) hit=1; break ;; esac
      done
      [ -n "$hit" ] || echo "$f"
    done )`
    if [ -n "$unrotated" ]; then
      message WARN logf011w "Rotated by nothing: `printf '%s\n' "$unrotated" | commas`. Name them in a file under /etc/logrotate.d (the $dname package ships one)." "$dname writes log files that no logrotate entry rotates: they grow until the disk is full, and the logs are lost with it."
    else
      # What runs it: logrotate.timer enabled, or a cron job
      runs=
      for w in '/etc/systemd/system/*.wants/logrotate.timer' '/run/systemd/system/*.wants/logrotate.timer' '/usr/lib/systemd/system/*.wants/logrotate.timer' '/lib/systemd/system/*.wants/logrotate.timer'
      do
        [ -n "`rootglob "$w"`" ] && { runs=logrotate.timer; break; }
      done
      if [ -z "$runs" ]; then
        for c in /etc/cron.daily/logrotate /etc/cron.hourly/logrotate /etc/cron.weekly/logrotate /etc/periodic/daily/logrotate
        do
          [ -f "`rootfile $c`" ] && { runs=$c; break; }
        done
      fi
      if [ -z "$runs" ]; then
        { echo /etc/crontab; rootls /etc/cron.d 2>/dev/null; } | rootcat 2>/dev/null | $GREP -v '^[ \t]*#' | $GREP -q logrotate && runs=cron
      fi
      [ -n "$runs" ] || message WARN logf011w "Enable the timer ('systemctl enable --now logrotate.timer') or restore /etc/cron.daily/logrotate." "logrotate is installed and configured for the $nfiles log files $dname writes, but no timer or cron job runs it: they grow until the disk is full, and the logs are lost with it."
    fi
  fi
fi

# Live: the configured daemon runs, or the journal keeps the logs
if [ -z "$TIGRIS_ROOT" ]; then
  if ! $CAT "$root"/proc/[0-9]*/comm 2>/dev/null | $AWK '$0 == "rsyslogd" || $0 == "syslog-ng" || $0 == "syslogd" || $0 == "metalog" { y = 1 } END { exit !y }'; then
    journal=`rootfile /var/log/journal`
    if [ ! -d "$journal" ] || [ -z "`$LS -A "$journal" 2>/dev/null`" ]; then
      message WARN logf012w "Start it ('systemctl enable --now rsyslog'), or make the journal persistent (Storage=persistent in journald.conf, or mkdir /var/log/journal)." "$dname is configured but no syslog daemon is running, and the journal is not kept on disk: nothing records the system log, and the files $dname wrote stop where it stopped."
    fi
  fi
fi

exit 0
