#
# Profile "container": run inside a container (or against a container
# image's root), where the kernel, the boot, the firewall, systemd and the
# disks belong to the host and are not this system's to judge. What stays
# is what the image itself holds: packages and their integrity, pending
# security updates, accounts, sudo, PAM, file permissions, setuid files.
#
#   ./tigris --profile container
#
# Read after the tigris.conf; only what differs from it.
#
Tigris_Check_BOOT=N
Tigris_Check_SINGLE=N
Tigris_Check_RCUMASK=N
Tigris_Check_NETWORKCONFIG=N
Tigris_Check_SYSCTL=N
Tigris_Check_SYSTEMD=N
Tigris_Check_FIREWALL=N
Tigris_Check_SECUREBOOT=N
Tigris_Check_MAC=N
Tigris_Check_AUDIT=N
Tigris_Check_TIMESYNC=N
Tigris_Check_UNITS=N
Tigris_Check_STORAGE=N
Tigris_Check_CONTAINERS=N
Tigris_Check_ROOTKIT=N
