#
# Profile "server": a machine others depend on, in a room nobody walks
# into with a USB stick, reached over the network.
#
#   sudo ./tigris --profile server
#
# Read after the tigris.conf; only what differs from it.
#
# USB storage has no business here (stor008w when it is usable).
Tigris_Storage_NoUSB=Y
# Every account's PATH, not root's alone: service accounts run commands.
Tigris_Check_PATHALL=Y
# Processes still using deleted files: libraries updated under a
# running daemon, or a binary removed after it was started.
Tigris_Check_DELETED=Y
