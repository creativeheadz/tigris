#
# Profile "desktop": one person's workstation or laptop. The checks for
# what only servers run are left out; the rest stays, the filesystem scan
# included.
#
#   sudo ./tigris --profile desktop
#
# Read after the tigris.conf; only what differs from it.
#
# Stringent checks of network servers' configuration.
Tigris_Check_STRICTNW=N
# NFS exports and mail aliases: a workstation exports nothing and runs no
# mail server.
Tigris_Check_EXPORTS=N
Tigris_Check_ALIASES=N
